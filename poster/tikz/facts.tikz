\begin{tikzpicture}[
	x=30pt,
	y=15pt,
	font=\large,
	other/.style={},
	failed/.style={dashed},
	level distance=64pt,
	sibling distance=300pt,
	edge from parent/.style={draw,thick}
]
	\node[clause,core] at (6,0) {$\vdash R(a)$}
		child {node[clause,core] (q) {$Q(a)$}
			child {node[clause,core] {$P(a)$}}
			child[failed] {node[clause] {$S(a)$}
				child {node[clause] {$T(a)$}
					child {node[clause] {$R(a)$}}
				}
			}
		};

	\draw[flow] ([yshift=-45pt]q.south) -- (6,-21);

	\draw[panel] (-6,-24) rectangle (18,-44);
	\node[heading] at (6,-26) {SAT Clauses (UNSAT)};

	\foreach \x/\y/\kind/\fact in {
		0/-30/other/{S(b)},
		12/-30/core/{P(a)},
		0/-34/other/{\forall x\, (T(x) \to S(x))},
		12/-34/other/{\forall x\, (S(x) \to Q(x))},
		0/-38/core/{\forall x\, (P(x) \to Q(x))},
		12/-38/other/{P(c)},
		0/-42/other/{\forall x\, (R(x) \to T(x))},
		12/-42/core/{\forall x\, (Q(x) \to R(x))}
	} {
		\node[clause,\kind,minimum width=330pt] at (\x,\y) {$\fact$};
	}
\end{tikzpicture}

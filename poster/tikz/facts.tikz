\begin{tikzpicture}[
	x=30pt,
	y=15pt,
	font=\large,
	other/.style={},
	failed/.style={dashed},
	level distance=64pt,
	sibling distance=300pt,
	edge from parent/.style={draw,thick}
]
	\foreach \x/\y/\kind/\fact in {
		0/0/other/{S(b)},
		12/0/core/{P(a)},
		0/-4/other/{\forall x\, (T(x) \to S(x))},
		12/-4/other/{\forall x\, (S(x) \to Q(x))},
		0/-8/core/{\forall x\, (P(x) \to Q(x))},
		12/-8/other/{P(c)},
		0/-12/other/{\forall x\, (R(x) \to T(x))},
		12/-12/core/{\forall x\, (Q(x) \to R(x))}
	} {
		\node[clause,\kind,minimum width=330pt] at (\x,\y) {$\fact$};
	}

	\draw[panel] (-6,2) rectangle (18,-14);

	\draw[flow] (6,-14) -- (6,-19);

	\node[clause,core] at (6,-21) {$\vdash R(a)$}
		child {node[clause,core] {$Q(a)$}
			child {node[clause,core] {$P(a)$}}
			child[failed] {node[clause] {$S(a)$}
				child {node[clause] {$T(a)$}
					child {node[clause] {$R(a)$}}
				}
			}
		};

\end{tikzpicture}

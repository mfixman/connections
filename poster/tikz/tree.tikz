\begin{tikzpicture}[
	x=1em,
	y=22pt,
	font=\large,
	failed/.style={dashed},
	other/.style={},
	level distance=88pt,
	sibling distance=18em,
	level 2/.style={sibling distance=12em},
	level 4/.style={sibling distance=12em},
	edge from parent/.style={draw,thick}
]
	\node[clause,core] {$P(a) \lor Q(b)$}
		child {node[clause,core] {$\neg P(a) \lor \neg R(a)$}
			child {node[clause,core] {$\neg P(a) \lor Q(a) \lor R(a)$}
				child {node[clause,core] {$\neg S(a) \lor \neg Q(a)$}
					child {node[clause,core] {$\neg Q(a) \lor S(a)$}}
					child[failed] {node[clause] {$\neg R(a) \lor S(a)$}}
				}
			}
		}
		child {node[clause,core] {$\neg S(b) \lor \neg Q(b)$}
			child {node[clause,core] {$\neg Q(b) \lor S(b)$}}
			child[failed] {node[clause] {$\neg R(b) \lor S(b)$}
				child {node[clause] {$\neg P(b) \lor Q(b) \lor R(b)$}}
			}
		};

	\node[overlay,font=\normalsize] at (16,1) {Filled: in the SAT core};

	\draw[flow] (22,-8) -- (26,-8);
	\draw[panel] (27,1) rectangle (51,-18);
	\node[heading] at (39,-1) {SAT Clauses (UNSAT)};

	\foreach \x/\y/\kind/\ground in {
		28/-4/core/{\neg Q(a) \lor S(a)},
		38/-4/other/{\neg R(b) \lor S(b)},
		28/-7/core/{\neg P(a) \lor \neg R(a)},
		38/-7/core/{\neg S(b) \lor \neg Q(b)},
		28/-10/other/{\neg R(a) \lor S(a)},
		38/-10/core/{\neg P(a) \lor Q(a) \lor R(a)},
		28/-13/core/{\neg Q(b) \lor S(b)},
		38/-13/core/{P(a) \lor Q(b)},
		28/-16/core/{\neg S(a) \lor \neg Q(a)},
		38/-16/other/{\neg P(b) \lor Q(b) \lor R(b)}
	} {
		\node[clause,\kind,anchor=west] at (\x,\y) {$\ground$};
	}
\end{tikzpicture}

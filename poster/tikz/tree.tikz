\begin{tikzpicture}[
	x=1em,
	y=1em,
	font=\large,
	failed/.style={dashed},
	level distance=4em,
	sibling distance=16em,
	edge from parent/.style={draw,thick}
]
	\node[clause,core] {$\neg M(n)$}
		child {node[clause,core] {$M(n) \lor \neg L(n) \lor \neg T(n)$}
			child[failed] {node[clause] {$L(n) \lor \neg H(n)$}
				child {node[clause] {$H(b)$}}
			}
			child {node[clause,core] {$L(n)$}}
			child {node[clause,core] {$T(n) \lor \neg P(n)$}
				child {node[clause,core] {$P(n)$}}
			}
		};

	\draw[flow] (21,-6) -- (25,-6);
	\draw[panel] (26,1) rectangle (46,-12);
	\node[heading] at (36,-1) {SAT core in blue};

	\node[clause,core,anchor=west] (g1) at (27,-4) {$\neg M(n)$};
	\node[clause,core,right=1em of g1] (g2) {$M(n) \lor \neg L(n) \lor \neg T(n)$};
	\node[clause,anchor=west] (g3) at (27,-7) {$L(n) \lor \neg H(n)$};
	\node[clause,core,right=1em of g3] (g4) {$L(n)$};
	\node[clause,core,anchor=west] (g5) at (27,-10) {$T(n) \lor \neg P(n)$};
	\node[clause,core,right=1em of g5] (g6) {$P(n)$};
	\node[clause,right=1em of g6] (g7) {$H(b)$};
\end{tikzpicture}

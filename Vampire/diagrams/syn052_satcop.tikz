\begin{tikzpicture}[
  attempt/.style = {
    every node/.style = {
      draw,
      rounded corners=1pt,
      inner xsep=3pt,
      inner ysep=2pt,
      font=\scriptsize
    },
    level distance=8mm,
    sibling distance=24mm,
    level 2/.style={sibling distance=22mm},
    edge from parent/.style={draw, -}
  },
  start/.style={},
  core/.style={fill=black!6},
  bt/.style={edge from parent/.style={draw, dash pattern=on 2pt off 1pt on .5pt off 1pt}},
  label/.style={draw=none, font=\scriptsize\itshape}
]
\useasboundingbox (-37mm,-44mm) rectangle (153mm,8mm);

\begin{scope}[attempt]
  \node[start, core] {$\neg F(g) \vee p$}
    child { node {$F(x_0) \vee \neg p$}
      child[bt] { node {$F(x_1) \vee \neg p$} }
      child[bt] { node[core] {$\neg p \vee \neg F(a)$} }
    };
\end{scope}

\begin{scope}[xshift=58mm, attempt]
  \node[start, core] {$p \vee F(g)$}
    child[bt] { node {$\neg p \vee F(x_2)$} }
    child[bt] { node[core] {$\neg F(a) \vee \neg p$} };
\end{scope}

\begin{scope}[xshift=116mm, attempt]
  \node[start, core] {$\neg F(a) \vee \neg p$}
    child[bt] { node {$p \vee F(y_0)$} }
    child[bt] { node {$F(y_1) \vee \neg F(a)$} }
    child { node[core] {$\neg p \vee F(a)$} };
\end{scope}

\node[label, align=center] at (58mm,-38mm)
  {UNSAT core:\\$\{\neg F(g) \vee p,\ p \vee F(g),\ \neg F(a) \vee \neg p,\ \neg p \vee F(a)\}$};
\end{tikzpicture}

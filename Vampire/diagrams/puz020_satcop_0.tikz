\begin{tikzpicture}[
	x=.84cm,
	y=.9cm,
	every node/.style={font=\scriptsize},
	clause/.style={draw,rounded corners=1pt,inner xsep=3pt,inner ysep=2pt,align=center},
	groundbox/.style={draw,rounded corners=2pt,fill=black!3,minimum width=10.2cm,minimum height=2.45cm},
	groundclause/.style={rounded corners=1pt,fill=black!9,inner xsep=3pt,inner ysep=2pt},
	note/.style={align=center,text width=10.5cm},
	edge/.style={draw},
	invisible/.style={opacity=0,text opacity=0},
	alt/.code args={<#1>#2#3}{\alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}}},
	visible on/.style={alt={#1{}{invisible}}},
	active on/.style={alt={#1{fill=yellow!30,very thick}{}}}
]
	\useasboundingbox (-6.3,-5.15) rectangle (6.3,1.15);
	\node[clause,visible on=<1->,active on=<1>] (aeta) at (-3.6,-.55) {$a(\eta)$};
	\node[clause,visible on=<3->,active on=<3>] (failed) at (-5,-1.5)
		{$\neg a(\eta)\lor c\bigl(\phi(\eta)\bigr)$\\$\lor d(\eta)$};
	\node[clause,visible on=<4->,active on=<4>] (rule) at (-2.1,-1.5)
		{$\neg a(\eta)\lor\neg c\bigl(\phi(\eta)\bigr)$\\$\lor b(\eta)$};
	\node[clause,visible on=<6->,active on=<6>] (nbeta) at (.3,-.55) {$\neg b(\eta)$};
	\node[clause,visible on=<7->,active on=<7>] (wife) at (4,-.55)
		{$c\bigl(\phi(\eta)\bigr)\lor b(\gamma)$};
	\node[clause,visible on=<8->,active on=<8>] (wifeclose) at (4,-1.5)
		{$\neg b(\gamma)\lor c\bigl(\phi(\eta)\bigr)$};

	\draw[edge,visible on=<3->] (aeta) -- (failed);
	\draw[edge,visible on=<4->] (aeta) -- (rule);
	\draw[edge,visible on=<8->] (wife) -- (wifeclose);

	\node[groundbox] (ground) at (0,-3.65) {};
	\node[note] at (0,-2.62) {persistent SAT ground};
	\node[groundclause,visible on=<1->,active on=<1>,active on=<9>] at (-4.65,-3.18) {$a(\eta)$};
	\node[groundclause,visible on=<6->,active on=<6>,active on=<9>] at (-2.45,-3.18) {$\neg b(\eta)$};
	\node[groundclause,visible on=<3->,active on=<3>] at (.85,-3.18)
		{$\neg a(\eta)\lor c\bigl(\phi(\eta)\bigr)\lor d(\eta)$};
	\node[groundclause,visible on=<4->,active on=<4>,active on=<9>] at (.85,-3.82)
		{$\neg a(\eta)\lor\neg c\bigl(\phi(\eta)\bigr)\lor b(\eta)$};
	\node[groundclause,visible on=<7->,active on=<7>,active on=<9>] at (-2.85,-4.42)
		{$c\bigl(\phi(\eta)\bigr)\lor b(\gamma)$};
	\node[groundclause,visible on=<8->,active on=<8>,active on=<9>] at (2.55,-4.42)
		{$\neg b(\gamma)\lor c\bigl(\phi(\eta)\bigr)$};
	\node[clause,visible on=<9->,active on=<9>] at (5.05,-3.75) {$\bot$};
\end{tikzpicture}

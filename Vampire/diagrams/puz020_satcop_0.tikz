\begin{tikzpicture}[
	x=.84cm,
	y=.9cm,
	every node/.style={font=\scriptsize},
	clause/.style={draw,rounded corners=1pt,inner xsep=3pt,inner ysep=2pt,align=center},
	groundbox/.style={draw,rounded corners=2pt,fill=black!3,minimum width=10.2cm,minimum height=2.15cm},
	groundclause/.style={rounded corners=1pt,fill=black!9,inner xsep=3pt,inner ysep=2pt},
	note/.style={align=center,text width=10.5cm},
	edge/.style={draw},
	invisible/.style={opacity=0,text opacity=0},
	alt/.code args={<#1>#2#3}{\alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}}},
	visible on/.style={alt={#1{}{invisible}}},
	active on/.style={alt={#1{fill=yellow!30,very thick}{}}}
]
	\useasboundingbox (-6.3,-4.75) rectangle (6.3,1.15);
	\node[note] at (0,.9) {%
		\only<1>{\step{Start}: begin with the husband fact.}%
		\only<2>{Ground that clause and add it to the persistent SAT state.}%
		\only<3>{\step{Extension}: instantiate the truth/knight schema.}%
		\only<4>{The new ground instance is retained by the SAT solver.}%
		\only<5>{Try the negated conjecture as another start.}%
		\only<6>{Try the clause saying a false statement makes the wife a knight.}%
		\only<7>{Connect the wife branch; one more ground clause is learned.}%
		\only<8>{The accumulated ground is now UNSAT.}%
	};

	\node[clause,visible on=<1->,active on=<1>] (aeta) at (-3.9,-.75) {$a(\eta)$};
	\node[clause,visible on=<3->,active on=<3>] (rule) at (-3.9,-1.65)
		{$\neg a(\eta)\lor\neg c\bigl(\phi(\eta)\bigr)\lor b(\eta)$};
	\node[clause,visible on=<5->,active on=<5>] (nbeta) at (0,-.75) {$\neg b(\eta)$};
	\node[clause,visible on=<6->,active on=<6>] (wife) at (3.9,-.75)
		{$c\bigl(\phi(\eta)\bigr)\lor b(\gamma)$};
	\node[clause,visible on=<7->,active on=<7>] (wifeclose) at (3.9,-1.65)
		{$\neg b(\gamma)\lor c\bigl(\phi(\eta)\bigr)$};

	\draw[edge,visible on=<3->] (aeta) -- (rule);
	\draw[edge,visible on=<7->] (wife) -- (wifeclose);

	\node[groundbox,active on=<8>] (ground) at (0,-3.5) {};
	\node[note] at (0,-2.62) {persistent SAT ground};
	\node[groundclause,visible on=<2->,active on=<2>] at (-4.3,-3.12) {$a(\eta)$};
	\node[groundclause,visible on=<5->,active on=<5>] at (-2.55,-3.12) {$\neg b(\eta)$};
	\node[groundclause,visible on=<4->,active on=<4>] at (1.25,-3.12)
		{$\neg a(\eta)\lor\neg c\bigl(\phi(\eta)\bigr)\lor b(\eta)$};
	\node[groundclause,visible on=<6->,active on=<6>] at (-2.25,-3.95)
		{$c\bigl(\phi(\eta)\bigr)\lor b(\gamma)$};
	\node[groundclause,visible on=<7->,active on=<7>] at (2.05,-3.95)
		{$\neg b(\gamma)\lor c\bigl(\phi(\eta)\bigr)$};
	\node[clause,visible on=<8->,active on=<8>] at (4.75,-3.5) {$\bot$};
\end{tikzpicture}

\begin{tikzpicture}[
	x=.72cm,
	y=.86cm,
	every node/.style={font=\scriptsize},
	literal/.style={draw,rounded corners=1pt,inner xsep=3pt,inner ysep=2pt},
	closed/.style={literal,fill=black!12},
	note/.style={align=center,text width=10cm},
	edge/.style={draw},
	invisible/.style={opacity=0,text opacity=0},
	alt/.code args={<#1>#2#3}{\alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}}},
	visible on/.style={alt={#1{}{invisible}}},
	active on/.style={alt={#1{fill=yellow!30,very thick}{}}}
]
	\node[note] at (1.5,.75) {%
		\only<1>{\step{Start}: choose the husband fact.}%
		\only<2>{\step{Extension}: every person is a knight or a knave; \(\neg a(A)\) closes.}%
		\only<3>{The knight branch closes against the negated conjecture.}%
		\only<4>{The knave branch expands using exclusivity of knights and knaves.}%
		\only<5>{A second expansion relates truthful statements to knighthood.}%
		\only<6>{If the statement were false, the wife would be a knight.}%
		\only<7>{The wife would make the statement true: every branch closes.}%
	};

	\node[literal,active on=<1>] (root) at (0,0) {$a(\eta)$};
	\node[closed,visible on=<2->,active on=<2>] (na) at (-4,-1) {$\neg a(A)$};
	\node[literal,visible on=<2->,active on=<2>] (bA) at (-1.8,-1) {$b(A)$};
	\node[literal,visible on=<2->,active on=<2>] (dA) at (2,-1) {$d(A)$};

	\node[closed,visible on=<3->,active on=<3>] (nbeta) at (-1.8,-2) {$\neg b(\eta)$};
	\node[closed,visible on=<4->,active on=<4>] (ndB) at (0,-2) {$\neg d(B)$};
	\node[closed,visible on=<4->,active on=<4>] (naB) at (2,-2) {$\neg a(B)$};
	\node[literal,visible on=<4->,active on=<4>] (nbB) at (4,-2) {$\neg b(B)$};

	\node[closed,visible on=<5->,active on=<5>] (bC) at (1.6,-3) {$b(C)$};
	\node[closed,visible on=<5->,active on=<5>] (naC) at (3.8,-3) {$\neg a(C)$};
	\node[literal,visible on=<5->,active on=<5>] (ncC) at (6,-3) {$\neg c\bigl(\phi(C)\bigr)$};

	\node[closed,visible on=<6->,active on=<6>] (ceta1) at (4.7,-4) {$c\bigl(\phi(\eta)\bigr)$};
	\node[literal,visible on=<6->,active on=<6>] (bgamma) at (7,-4) {$b(\gamma)$};
	\node[closed,visible on=<7->,active on=<7>] (nbgamma) at (5.9,-5) {$\neg b(\gamma)$};
	\node[closed,visible on=<7->,active on=<7>] (ceta2) at (8.1,-5) {$c\bigl(\phi(\eta)\bigr)$};

	\draw[edge,visible on=<2->] (root) -- (na);
	\draw[edge,visible on=<2->] (root) -- (bA);
	\draw[edge,visible on=<2->] (root) -- (dA);
	\draw[edge,visible on=<3->] (bA) -- (nbeta);
	\draw[edge,visible on=<4->] (dA) -- (ndB);
	\draw[edge,visible on=<4->] (dA) -- (naB);
	\draw[edge,visible on=<4->] (dA) -- (nbB);
	\draw[edge,visible on=<5->] (nbB) -- (bC);
	\draw[edge,visible on=<5->] (nbB) -- (naC);
	\draw[edge,visible on=<5->] (nbB) -- (ncC);
	\draw[edge,visible on=<6->] (ncC) -- (ceta1);
	\draw[edge,visible on=<6->] (ncC) -- (bgamma);
	\draw[edge,visible on=<7->] (bgamma) -- (nbgamma);
	\draw[edge,visible on=<7->] (bgamma) -- (ceta2);

	\node[note,visible on=<7->] at (1.5,-5.65) {successful tableau --- found after 2,563 search steps};
\end{tikzpicture}

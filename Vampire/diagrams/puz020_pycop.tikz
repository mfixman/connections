\begin{tikzpicture}[
	x=.72cm,
	y=.86cm,
	every node/.style={font=\scriptsize},
	clause/.style={draw,rounded corners=1pt,inner xsep=3pt,inner ysep=2pt,align=center},
	closed/.style={clause,fill=black!12},
	note/.style={align=center,text width=10cm},
	edge/.style={draw},
	invisible/.style={opacity=0,text opacity=0},
	alt/.code args={<#1>#2#3}{\alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}}},
	visible on/.style={alt={#1{}{invisible}}},
	active on/.style={alt={#1{fill=yellow!30,very thick}{}}}
]
	\node[clause,active on=<1>] (root) at (0,0) {$a(\eta)$};
	\node[clause,visible on=<2->,active on=<2>] (failed) at (-3.8,-1)
		{$\neg a(\eta)\lor c\bigl(\phi(\eta)\bigr)\lor d(\eta)$};
	\node[clause,visible on=<3->,active on=<3>] (failedchild) at (-3.8,-2)
		{$\neg d(\eta)\lor\neg a(\eta)\lor\neg b(\eta)$};
	\node[clause,visible on=<4->,active on=<4>] (kind) at (2.3,-1)
		{$\neg a(\eta)\lor b(\eta)\lor d(\eta)$};
	\node[closed,visible on=<5->,active on=<5>] (nbeta) at (.1,-2) {$\neg b(\eta)$};
	\node[clause,visible on=<6->,active on=<6>] (exclusive) at (3.2,-2)
		{$\neg d(\eta)\lor\neg a(\eta)\lor\neg b(\eta)$};
	\node[clause,visible on=<7->,active on=<7>] (truth) at (3.2,-3)
		{$b(\eta)\lor\neg a(\eta)\lor\neg c\bigl(\phi(\eta)\bigr)$};
	\node[clause,visible on=<8->,active on=<8>] (wife) at (3.2,-4)
		{$c\bigl(\phi(\eta)\bigr)\lor b(\gamma)$};
	\node[closed,visible on=<9->,active on=<9>] (wifeclose) at (3.2,-5)
		{$\neg b(\gamma)\lor c\bigl(\phi(\eta)\bigr)$};

	\draw[edge,visible on=<2->] (root) -- (failed);
	\draw[edge,visible on=<3->] (failed) -- (failedchild);
	\draw[edge,visible on=<4->] (root) -- (kind);
	\draw[edge,visible on=<5->] (kind) -- (nbeta);
	\draw[edge,visible on=<6->] (kind) -- (exclusive);
	\draw[edge,visible on=<7->] (exclusive) -- (truth);
	\draw[edge,visible on=<8->] (truth) -- (wife);
	\draw[edge,visible on=<9->] (wife) -- (wifeclose);

\end{tikzpicture}

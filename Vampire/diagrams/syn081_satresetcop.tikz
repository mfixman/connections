\begin{tikzpicture}[
  attempt/.style = {
    every node/.style = {
      draw,
      rounded corners=1pt,
      inner xsep=3pt,
      inner ysep=2pt,
      font=\scriptsize
    },
    level distance=23pt,
    sibling distance=51pt,
    level 2/.style={sibling distance=40pt},
    edge from parent/.style={draw, -}
  },
  start/.style={},
  core/.style={fill=black!6},
  bt/.style={draw, dash pattern=on 2pt off 1pt on .5pt off 1pt},
  label/.style={draw=none, font=\scriptsize\itshape}
]
\useasboundingbox (-137pt,-108pt) rectangle (467pt,23pt);

\begin{scope}[xshift=68pt, attempt]
  \node[start, core] {$\neg F(f(g)) \vee F(f(f(g)))$}
    child { node[core] {$F(f(g)) \vee \neg F(g)$} };
\end{scope}

\begin{scope}[xshift=285pt, attempt]
  \node[start, core] {$\neg F(f(g)) \vee \neg F(f(f(g)))$}
    child { node[core] {$F(f(g)) \vee F(g)$} };
\end{scope}

\node[label, align=center] at (179pt,-88pt)
  {UNSAT core:\\$\{\neg F(f(g)) \vee F(f(f(g))),\ F(f(g)) \vee \neg F(g),\ \neg F(f(g)) \vee \neg F(f(f(g))),\ F(f(g)) \vee F(g)\}$};
\end{tikzpicture}

\begin{tikzpicture}[
	x=1cm,
	y=1cm,
	every node/.style={font=\LARGE},
	clause/.style={draw=black!75,fill=white,rounded corners=1.5pt,
		inner xsep=5pt,inner ysep=4pt,align=center,line width=.65pt},
	groundbox/.style={draw=black!65,rounded corners=3pt,fill=black!3,
		minimum width=19.4cm,minimum height=3.45cm,line width=.65pt},
	groundclause/.style={rounded corners=1.5pt,fill=black!9,
		inner xsep=5pt,inner ysep=4pt},
	note/.style={font=\large\bfseries,align=center,text width=19cm},
	edge/.style={draw=black!70,line width=.7pt},
	invisible/.style={opacity=0,text opacity=0},
	alt/.code args={<#1>#2#3}{\alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}}},
	visible on/.style={alt={#1{}{invisible}}},
	active on/.style={alt={#1{fill=yellow!35,draw=black,very thick}{}}}
]
	% SYN081 notation is deliberately disjoint from the PUZ example.
	\renewcommand{\phi}{\psi}
	\renewcommand{\eta}{\kappa}
	\useasboundingbox (-10.5,-9.25) rectangle (10.5,1.15);

	% Four SATCoP tableau attempts.  Alternatives from the same root are drawn
	% as siblings; every connection edge is solid, as in the PUZ020 diagrams.
	\node[clause,visible on=<1->,active on=<1>] (a1root) at (-5.50,.65)
		{$\neg p(\phi(\eta))\lor p(\phi(\phi(\eta)))$};
	\node[clause,visible on=<2->,active on=<2>] (a1c1) at (-9.00,-.60)
		{$p(\phi(\eta))\lor\neg p(\eta)$};
	\node[clause,visible on=<3->,active on=<3>] (a1c2) at (-5.50,-1.45)
		{$p(\phi(X_0))\lor p(X_0)$};
	\node[clause,visible on=<4->,active on=<4>] (a1c3) at (-2.00,-.60)
		{$p(\phi(X_1))\lor p(X_1)$};
	\draw[edge,visible on=<2->] (a1root) -- (a1c1);
	\draw[edge,visible on=<3->] (a1root) -- (a1c2);
	\draw[edge,visible on=<4->] (a1root) -- (a1c3);

	\node[clause,visible on=<5->,active on=<5>] (a2root) at (5.50,.65)
		{$p(X_2)\lor p(\phi(X_2))$};
	\node[clause,visible on=<6->,active on=<6>] (a2c1) at (2.00,-.60)
		{$\neg p(X_3)\lor p(\phi(X_3))$};
	\node[clause,visible on=<7->,active on=<7>] (a2c2) at (5.50,-1.45)
		{$\neg p(\phi(X_4))\lor\neg p(X_4)$};
	\node[clause,visible on=<8->,active on=<8>] (a2c3) at (9.00,-.60)
		{$\neg p(X_5)\lor\neg p(\phi(X_5))$};
	\draw[edge,visible on=<6->] (a2root) -- (a2c1);
	\draw[edge,visible on=<7->] (a2root) -- (a2c2);
	\draw[edge,visible on=<8->] (a2root) -- (a2c3);

	\node[clause,visible on=<9->,active on=<9>] (a3root) at (-5.50,-2.85)
		{$\neg p(\phi(X_6))\lor\neg p(X_6)$};
	\node[clause,visible on=<10->,active on=<10>] (a3c1) at (-9.00,-4.10)
		{$p(\phi(X_7))\lor\neg p(X_7)$};
	\node[clause,visible on=<11->,active on=<11>] (a3c2) at (-5.50,-4.85)
		{$p(X_8)\lor p(\phi(X_8))$};
	\node[clause,visible on=<12->,active on=<12>] (a3c3) at (-2.00,-4.10)
		{$p(X_9)\lor p(\phi(X_9))$};
	\draw[edge,visible on=<10->] (a3root) -- (a3c1);
	\draw[edge,visible on=<11->] (a3root) -- (a3c2);
	\draw[edge,visible on=<12->] (a3root) -- (a3c3);

	\node[clause,visible on=<13->,active on=<13>] (a4root) at (5.50,-2.85)
		{$p(\phi(\eta))\lor p(\eta)$};
	\node[clause,visible on=<14->,active on=<14>] (a4c1) at (5.50,-4.10)
		{$\neg p(\phi(\eta))\lor\neg p(\phi(\phi(\eta)))$};
	\draw[edge,visible on=<14->] (a4root) -- (a4c1);

	% Every distinct clause added to the shadow is shown.  At the last overlay,
	% the four clauses in the UNSAT core are highlighted; the extra grounded
	% instance remains grey.
	\node[groundbox] (ground) at (0,-7.40) {};
	\node[note] at (0,-5.88) {persistent SAT ground};
	\node[groundclause,visible on=<1->,active on=<1>,active on=<15>] at (-6.45,-6.65)
		{$\neg p(\phi(\eta))\lor p(\phi(\phi(\eta)))$};
	\node[groundclause,visible on=<2->,active on=<2>,active on=<15>] at (0,-6.65)
		{$p(\phi(\eta))\lor\neg p(\eta)$};
	\node[groundclause,visible on=<3->,active on=<3>,active on=<15>] at (6.45,-6.65)
		{$p(\phi(\eta))\lor p(\eta)$};
	\node[groundclause,visible on=<7->,active on=<7>] at (-3.35,-7.95)
		{$\neg p(\phi(\eta))\lor\neg p(\eta)$};
	\node[groundclause,visible on=<14->,active on=<14>,active on=<15>] at (3.35,-7.95)
		{$\neg p(\phi(\eta))\lor\neg p(\phi(\phi(\eta)))$};
	\node[clause,visible on=<15->,active on=<15>] at (8.85,-8.45) {$\bot$};
\end{tikzpicture}

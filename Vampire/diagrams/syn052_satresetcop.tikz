\begin{tikzpicture}[
  attempt/.style = {
    every node/.style = {
      draw,
      rounded corners=1pt,
      inner xsep=3pt,
      inner ysep=2pt,
      font=\scriptsize
    },
    level distance=8mm,
    sibling distance=28mm,
    level 2/.style={sibling distance=20mm},
    edge from parent/.style={draw, -}
  },
  start/.style={},
  core/.style={fill=black!6},
  bt/.style={draw, dash pattern=on 2pt off 1pt on .5pt off 1pt},
  label/.style={draw=none, font=\scriptsize\itshape}
]
\useasboundingbox (-32mm,-38mm) rectangle (158mm,8mm);

\begin{scope}[xshift=20mm, attempt]
  \node[start, core] {$\neg F(g) \vee p$}
    child { node {$F(x_0) \vee \neg p$}
      child { node {$F(x_1) \vee \neg p$} }
    };
\end{scope}

\begin{scope}[xshift=100mm, attempt]
  \node[start, core] {$p \vee \neg F(g)$}
    child { node[core] {$\neg p \vee \neg F(a)$}
      child { node[core] {$F(a) \vee \neg p$} }
    };
\end{scope}

\node[label, align=center] at (63mm,-32mm)
  {UNSAT core:\\$\{\neg F(g) \vee p,\ F(g) \vee p,\ \neg p \vee \neg F(a),\ F(a) \vee \neg p\}$};
\end{tikzpicture}

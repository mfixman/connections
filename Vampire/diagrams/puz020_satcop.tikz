\begin{tikzpicture}[
	x=.84cm,
	y=.9cm,
	every node/.style={font=\scriptsize},
	clause/.style={draw,rounded corners=1pt,inner xsep=3pt,inner ysep=2pt,align=center},
	groundbox/.style={draw,rounded corners=2pt,fill=black!3,minimum width=10.2cm,minimum height=2.15cm},
	groundclause/.style={rounded corners=1pt,fill=black!9,inner xsep=3pt,inner ysep=2pt},
	note/.style={align=center,text width=10.5cm},
	edge/.style={draw},
	invisible/.style={opacity=0,text opacity=0},
	alt/.code args={<#1>#2#3}{\alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}}},
	visible on/.style={alt={#1{}{invisible}}},
	active on/.style={alt={#1{fill=yellow!30,very thick}{}}}
]
	\useasboundingbox (-6.3,-4.75) rectangle (6.3,1.15);
	\node[note] at (0,.9) {%
		\only<1>{The SAT model prefers the wife/truth clause as a start.}%
		\only<2>{Its ground instance enters the persistent SAT state.}%
		\only<3>{The selected wife literal connects to the converse implication.}%
		\only<4>{That second ground clause is retained.}%
		\only<5>{The model next selects the husband fact.}%
		\only<6>{An extension adds the decisive truth/knight instance.}%
		\only<7>{The negated conjecture supplies the final missing clause.}%
		\only<8>{The accumulated ground is now UNSAT.}%
	};

	\node[clause,visible on=<1->,active on=<1>] (wife) at (-3.9,-.75)
		{$c\bigl(\phi(\eta)\bigr)\lor b(\gamma)$};
	\node[clause,visible on=<3->,active on=<3>] (wifeclose) at (-3.9,-1.65)
		{$\neg b(\gamma)\lor c\bigl(\phi(\eta)\bigr)$};
	\node[clause,visible on=<5->,active on=<5>] (aeta) at (.2,-.75) {$a(\eta)$};
	\node[clause,visible on=<6->,active on=<6>] (rule) at (.2,-1.65)
		{$\neg a(\eta)\lor\neg c\bigl(\phi(\eta)\bigr)\lor b(\eta)$};
	\node[clause,visible on=<7->,active on=<7>] (nbeta) at (4.2,-.75) {$\neg b(\eta)$};

	\draw[edge,visible on=<3->] (wife) -- (wifeclose);
	\draw[edge,visible on=<6->] (aeta) -- (rule);

	\node[groundbox,active on=<8>] (ground) at (0,-3.5) {};
	\node[note] at (0,-2.62) {persistent SAT ground};
	\node[groundclause,visible on=<5->,active on=<5>] at (-4.3,-3.12) {$a(\eta)$};
	\node[groundclause,visible on=<7->,active on=<7>] at (-2.55,-3.12) {$\neg b(\eta)$};
	\node[groundclause,visible on=<6->,active on=<6>] at (1.25,-3.12)
		{$\neg a(\eta)\lor\neg c\bigl(\phi(\eta)\bigr)\lor b(\eta)$};
	\node[groundclause,visible on=<2->,active on=<2>] at (-2.25,-3.95)
		{$c\bigl(\phi(\eta)\bigr)\lor b(\gamma)$};
	\node[groundclause,visible on=<4->,active on=<4>] at (2.05,-3.95)
		{$\neg b(\gamma)\lor c\bigl(\phi(\eta)\bigr)$};
	\node[clause,visible on=<8->,active on=<8>] at (4.75,-3.5) {$\bot$};
\end{tikzpicture}

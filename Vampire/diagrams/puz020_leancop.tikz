\begin{tikzpicture}[
	x=.82cm,
	y=.98cm,
	every node/.style={font=\scriptsize},
	literal/.style={draw,rounded corners=1pt,inner xsep=3pt,inner ysep=2pt},
	closed/.style={literal,fill=black!12},
	note/.style={align=center,text width=10cm},
	edge/.style={draw},
	invisible/.style={opacity=0,text opacity=0},
	alt/.code args={<#1>#2#3}{\alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}}},
	visible on/.style={alt={#1{}{invisible}}},
	active on/.style={alt={#1{fill=yellow!30,very thick}{}}}
]
	\node[note] at (0,.75) {%
		\only<1>{\step{Start}: open the husband-says branch.}%
		\only<2>{It closes immediately with the statement fact.}%
		\only<3>{\step{Start}: now open the true-statement branch.}%
		\only<4>{It connects to the truth/knight schema.}%
		\only<5>{The person subgoal closes with the husband fact.}%
		\only<6>{The knight subgoal closes against the conjecture.}%
		\only<7>{\step{Start}: finally open the false-statement branch.}%
		\only<8>{A false statement forces the wife to be a knight.}%
		\only<9>{That makes the statement true, closing the last branch.}%
	};

	\node[literal,visible on=<1->,active on=<1>] (ne) at (-4,0) {$\neg e(A,B)$};
	\node[literal,visible on=<3->,active on=<3>] (cB) at (0,0) {$c(B)$};
	\node[literal,visible on=<7->,active on=<7>] (ncB) at (4,0) {$\neg c(B)$};

	\node[closed,visible on=<2->,active on=<2>] (eeta) at (-4,-1) {$e\bigl(\eta,\phi(\eta)\bigr)$};
	\node[closed,visible on=<4->,active on=<4>] (ncA) at (-1.6,-1) {$\neg c\bigl(\phi(C)\bigr)$};
	\node[literal,visible on=<4->,active on=<4>] (naA) at (0,-1) {$\neg a(C)$};
	\node[literal,visible on=<4->,active on=<4>] (bA) at (1.6,-1) {$b(C)$};
	\node[closed,visible on=<8->,active on=<8>] (ceta1) at (3.1,-1) {$c\bigl(\phi(\eta)\bigr)$};
	\node[literal,visible on=<8->,active on=<8>] (bgamma) at (5.2,-1) {$b(\gamma)$};

	\node[closed,visible on=<5->,active on=<5>] (aeta) at (0,-2) {$a(\eta)$};
	\node[closed,visible on=<6->,active on=<6>] (nbeta) at (1.6,-2) {$\neg b(\eta)$};
	\node[closed,visible on=<9->,active on=<9>] (nbgamma) at (4.25,-2) {$\neg b(\gamma)$};
	\node[closed,visible on=<9->,active on=<9>] (ceta2) at (6.2,-2) {$c\bigl(\phi(\eta)\bigr)$};

	\draw[edge,visible on=<2->] (ne) -- (eeta);
	\draw[edge,visible on=<4->] (cB) -- (ncA);
	\draw[edge,visible on=<4->] (cB) -- (naA);
	\draw[edge,visible on=<4->] (cB) -- (bA);
	\draw[edge,visible on=<8->] (ncB) -- (ceta1);
	\draw[edge,visible on=<8->] (ncB) -- (bgamma);
	\draw[edge,visible on=<5->] (naA) -- (aeta);
	\draw[edge,visible on=<6->] (bA) -- (nbeta);
	\draw[edge,visible on=<9->] (bgamma) -- (nbgamma);
	\draw[edge,visible on=<9->] (bgamma) -- (ceta2);

	\node[note,visible on=<9->] at (0,-2.8) {successful tableau --- found after 241 search steps};
\end{tikzpicture}

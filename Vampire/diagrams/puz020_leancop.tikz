\begin{tikzpicture}[
	x=.82cm,
	y=.98cm,
	every node/.style={font=\scriptsize},
	clause/.style={draw,rounded corners=1pt,inner xsep=3pt,inner ysep=2pt,align=center},
	closed/.style={clause,fill=black!12},
	cut/.style={draw,diamond,fill=blue!10,inner sep=2pt,minimum size=7mm},
	note/.style={align=center,text width=10cm},
	edge/.style={draw},
	invisible/.style={opacity=0,text opacity=0},
	alt/.code args={<#1>#2#3}{\alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}}},
	visible on/.style={alt={#1{}{invisible}}},
	active on/.style={alt={#1{fill=yellow!30,very thick}{}}}
]
	\node[clause,visible on=<1->,active on=<1>] (start) at (0,0)
		{$\neg e\bigl(\eta,\phi(\eta)\bigr)
		 \lor c\bigl(\phi(\eta)\bigr)
		 \lor\neg c\bigl(\phi(\eta)\bigr)$};

	\node[closed,visible on=<2->,active on=<2>] (eeta) at (-4.8,-1)
		{$e\bigl(\eta,\phi(\eta)\bigr)$};
	\node[clause,visible on=<3->,active on=<3>] (failed) at (-3.7,-1.7)
		{$\neg d(\eta)\lor\neg e\bigl(\eta,\phi(\eta)\bigr)
		 \lor\neg c\bigl(\phi(\eta)\bigr)$};
	\node[clause,visible on=<4->,active on=<4>] (failedchild) at (-3.7,-2.7)
		{$\neg a(\eta)\lor c\bigl(\phi(\eta)\bigr)\lor d(\eta)$};
	\node[cut,visible on=<5->,active on=<5>] (cutnode) at (-4.8,-3.35) {cut};
	\node[clause,visible on=<6->,active on=<6>] (truth) at (.3,-1)
		{$\neg c\bigl(\phi(\eta)\bigr)\lor\neg a(\eta)\lor b(\eta)$};
	\node[clause,visible on=<8->,active on=<8>] (wife) at (4.8,-1)
		{$c\bigl(\phi(\eta)\bigr)\lor b(\gamma)$};

	\node[closed,visible on=<7->,active on=<7>] (aeta) at (-.8,-2) {$a(\eta)$};
	\node[closed,visible on=<8->,active on=<8>] (nbeta) at (1.4,-2) {$\neg b(\eta)$};
	\node[closed,visible on=<9->,active on=<9>] (wifeclose) at (4.8,-2)
		{$\neg b(\gamma)\lor c\bigl(\phi(\eta)\bigr)$};

	\draw[edge,visible on=<2->] (start) -- (eeta);
	\draw[edge,visible on=<3->] (start) -- (failed);
	\draw[edge,visible on=<4->] (failed) -- (failedchild);
	\draw[edge,visible on=<5->] (failedchild) -- (cutnode);
	\draw[edge,visible on=<6->] (start) -- (truth);
	\draw[edge,visible on=<7->] (truth) -- (aeta);
	\draw[edge,visible on=<8->] (truth) -- (nbeta);
	\draw[edge,visible on=<9->] (start) -- (wife);
	\draw[edge,visible on=<10->] (wife) -- (wifeclose);

\end{tikzpicture}

\begin{tikzpicture}[
	x=.84cm,
	y=.9cm,
	every node/.style={font=\scriptsize},
	clause/.style={draw,rounded corners=1pt,inner xsep=3pt,inner ysep=2pt,align=center},
	groundbox/.style={draw,rounded corners=2pt,fill=black!3,minimum width=10.2cm,minimum height=2.15cm},
	groundclause/.style={rounded corners=1pt,fill=black!9,inner xsep=3pt,inner ysep=2pt},
	note/.style={align=center,text width=10.5cm},
	edge/.style={draw},
	invisible/.style={opacity=0,text opacity=0},
	alt/.code args={<#1>#2#3}{\alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}}},
	visible on/.style={alt={#1{}{invisible}}},
	active on/.style={alt={#1{fill=yellow!30,very thick}{}}}
]
	\useasboundingbox (-6.3,-4.75) rectangle (6.3,1.15);
	\node[note] at (0,.9) {%
		\only<1>{First attempt: start from the husband fact.}%
		\only<2>{One extension contributes two useful ground clauses.}%
		\only<3>{\step{Reset}: discard the tableau and start from the wife/truth clause.}%
		\only<4>{Another short attempt contributes both wife clauses.}%
		\only<5>{\step{Reset}: the negated conjecture supplies the final clause.}%
		\only<6>{The tableau is disposable; the persistent ground is UNSAT.}%
	};

	\node[clause,visible on=<1->,active on=<1>] (aeta) at (-3.9,-.75) {$a(\eta)$};
	\node[clause,visible on=<2->,active on=<2>] (rule) at (-3.9,-1.65)
		{$\neg a(\eta)\lor\neg c\bigl(\phi(\eta)\bigr)\lor b(\eta)$};
	\node[clause,visible on=<3->,active on=<3>] (wife) at (0,-.75)
		{$c\bigl(\phi(\eta)\bigr)\lor b(\gamma)$};
	\node[clause,visible on=<4->,active on=<4>] (wifeclose) at (0,-1.65)
		{$\neg b(\gamma)\lor c\bigl(\phi(\eta)\bigr)$};
	\node[clause,visible on=<5->,active on=<5>] (nbeta) at (4.1,-.75) {$\neg b(\eta)$};

	\draw[edge,visible on=<2->] (aeta) -- (rule);
	\draw[edge,visible on=<4->] (wife) -- (wifeclose);

	\node[groundbox,active on=<6>] (ground) at (0,-3.5) {};
	\node[note] at (0,-2.62) {persistent SAT ground};
	\node[groundclause,visible on=<2->,active on=<2>] at (-4.3,-3.12) {$a(\eta)$};
	\node[groundclause,visible on=<5->,active on=<5>] at (-2.55,-3.12) {$\neg b(\eta)$};
	\node[groundclause,visible on=<2->,active on=<2>] at (1.25,-3.12)
		{$\neg a(\eta)\lor\neg c\bigl(\phi(\eta)\bigr)\lor b(\eta)$};
	\node[groundclause,visible on=<4->,active on=<4>] at (-2.25,-3.95)
		{$c\bigl(\phi(\eta)\bigr)\lor b(\gamma)$};
	\node[groundclause,visible on=<4->,active on=<4>] at (2.05,-3.95)
		{$\neg b(\gamma)\lor c\bigl(\phi(\eta)\bigr)$};
	\node[clause,visible on=<6->,active on=<6>] at (4.75,-3.5) {$\bot$};
\end{tikzpicture}

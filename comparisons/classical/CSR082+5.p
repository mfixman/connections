nce(_1672368,s__TimeDependentQuantity))],[-(s__instance(s__Volt,s__CompositeUnitOfMeasure))],[-(s__instance(s__Volt,s__SystemeInternationalUnit))],[-(s__documentation(s__Volt,s__EnglishLanguage,'SI electric potential measure. Symbol: V. It is the difference of electric potential between two points of a conducting wire carrying a constant current of 1 &%Ampere, when the power dissipated between these points is equal to 1 &%Watt. &%Volt = W/A = m^2*kg*s^(-3)*A^(-1).'))],[-(s__instance(s__Farad,s__CompositeUnitOfMeasure))],[-(s__instance(s__Farad,s__SystemeInternationalUnit))],[-(s__documentation(s__Farad,s__EnglishLanguage,'SI capacitance measure. Symbol: F. It is the capacitance of a capacitator between the plates of which there appears a difference of potential of 1 &%Volt when it is charged by a quantity of electricity equal to 1 Coulomb. &%Farad = C/V = m^(-2)*kg(-1)*s^4*A^2.'))],[-(s__instance(s__Ohm,s__CompositeUnitOfMeasure))],[-(s__instance(s__Ohm,s__SystemeInternationalUnit))],[-(s__documentation(s__Ohm,s__EnglishLanguage,'SI electric resistance measure. It is the electric resistance between two points of a conductor when a constant difference of potential of 1 &%Volt, applied between these two points, produces in this conductor a current of 1 &%Ampere, this conductor not being the force of any electromotive force. &%Ohm = V/A = m^2*kg*s^(-3)*A^(-2).'))],[-(s__instance(s__Siemens,s__CompositeUnitOfMeasure))],[-(s__instance(s__Siemens,s__SystemeInternationalUnit))],[-(s__documentation(s__Siemens,s__EnglishLanguage,'SI electric conductance measure. Symbol: S. In the case of direct current, the conductance in &%Siemens is the reciprocal of the resistance in &%Ohms, in the case of alternating current, it is the reciprocal of the impedance in ohms. siemens = A/V = m^(-2)*kg(-1)*s^(3)*A^2.'))],[-(s__instance(s__Weber,s__CompositeUnitOfMeasure))],[-(s__instance(s__Weber,s__SystemeInternationalUnit))],[-(s__documentation(s__Weber,s__EnglishLanguage,'SI magnetic flux 
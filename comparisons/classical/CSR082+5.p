__Silicon,s__ElementalSubstance))],[-(s__instance(s__Silicon__t,s__SetOrClass))],[-(s__names(s__Silicon,'Silicon'))],[-(s__conventionalShortName('Si',s__Silicon))],[-(s__atomicNumber(s__Silicon,"14"))],[s__instance(_1910826,s__Object),-(s__measure(_1910826,s__MeasureFn("28.086",s__Amu))),s__instance(_1910826,s__Silicon),s__instance(_1910826,s__Atom)],[-(s__documentation(s__Silicon,s__EnglishLanguage,'Metalloid element belonging to group 14 of the periodic table. It is the second most abundant element in the Earths crust, making up 25.7 percent of it by weight. Chemically less reactive than carbon. First identified by Lavoisier in 1787 and first isolated in 1823 by Berzelius.'))],[-(s__subclass(s__Phosphorus,s__ElementalSubstance))],[-(s__instance(s__Phosphorus__t,s__SetOrClass))],[-(s__names(s__Phosphorus,'Phosphorus'))],[-(s__conventionalShortName('P',s__Phosphorus))],[-(s__atomicNumber(s__Phosphorus,"15"))],[s__instance(_1910924,s__Object),-(s__measure(_1910924,s__MeasureFn("30.9738",s__Amu))),s__instance(_1910924,s__Phosphorus),s__instance(_1910924,s__Atom)],[-(s__documentation(s__Phosphorus,s__EnglishLanguage,'Non-metallic element belonging to group 15 of the periodic table. Has a multiple allotropic forms. Essential element for living organisms. It was discovered by Brandt in 1669.'))],[-(s__subclass(s__Sulphur,s__ElementalSubstance))],[-(s__instance(s__Sulphur__t,s__SetOrClass))],[-(s__names(s__Sulphur,'Sulphur'))],[-(s__conventionalShortName('S',s__Sulphur))],[-(s__atomicNumber(s__Sulphur,"16"))],[s__instance(_1911022,s__Object),-(s__measure(_1911022,s__MeasureFn("32.064",s__Amu))),s__instance(_1911022,s__Sulphur),s__instance(_1911022,s__Atom)],[-(s__documentation(s__Sulphur,s__EnglishLanguage,'Yellow, nonmetallic element belonging to group 16 of the periodic table. It is an essential element in living organisms, needed in the amino acids cysteine and methionine, and hence in many proteins. Absorbed by plants from the soil as sulphate ion.'))],[-(s__subclass(s__Chlorine,s__ElementalSubstance))],[-(s__instance(s__Chlorine__t,s__SetOrClass))],[-(s__names(s__Chlorine,'Chlorine'))],[-(s__conventionalShortName('Cl',s__Chlorine))],[-(s__atomicNumber(s__Chlorine,"17"))],[s__instance(_1911120,s__Object),-(s__measure(_1911120,s__MeasureFn("35.453",s__Amu))),s__instance(_1911120,s__Chlorine),s__instance(_1911120,s__Atom)],[-(s__documentation(s__Chlorine,s__EnglishLanguage,'Halogen element. Poisonous greenish-yellow gas. Occurs widely in nature as sodium chloride in seawater. Reacts directly with many elements and compounds, strong oxidizing agent. Discovered by Karl Scheele in 1774. Humphrey David confirmed it as an element in 1810.'))],[-(s__subclass(s__Argon,s__ElementalSubstance))],[-(s__instance(s__Argon__t,s__SetOrClass))],[-(s__names(s__Argon,'Argon'))],[-(s__conventionalShortName('Ar',s__Argon))],[-(s__atomicNumber(s__Argon,"18"))],[s__instance(_1911218,s__Object),-(s__measure(_1911218,s__MeasureFn("39.948",s__Amu))),s__instance(_1911218,s__Argon),s__instance(_1911218,s__Atom)],[-(s__documentation(s__Argon,s__EnglishLanguage,'Monatomic noble gas. Makes up 0.93 percent of the air. Colourless, odorless. Is inert and has no true compounds. Lord Rayleigh and Sir william Ramsey identified argon in 1894.'))],[-(s__subclass(s__Potassium,s__ElementalSubstance))],[-(s__instance(s__Potassium__t,s__SetOrClass))],[-(s__names(s__Potassium,'Potassium'))],[-(s__conventionalShortName('K',s__Potassium))],[-(s__atomicNumber(s__Potassium,"19"))],[s__instance(_1911316,s__Object),-(s__measure(_1911316,s__MeasureFn("39.0983",s__Amu))),s__instance(_1911316,s__Potassium),s__instance(_1911316,s__Atom)],[-(s__documentation(s__Potassium,s__EnglishLanguage,'Soft silvery metallic element belonging to group 1 of the periodic table (alkali metals). Occurs naturally in seawater and a many minerals. Highly reactive, chemically, it resembles sodium in its behavior and compounds. Discovered by Sir Humphry Davy in 1807.'))],[-(s__subclass(s__Calcium,s__ElementalSubstance))],[-(s__instance(s__Calcium__t,s__SetOrClass))],[-(s__names(s__Calcium,'Calcium'))],[-(s__conventionalShortName('Ca',s__Calcium))],[-(s__atomicNumber(s__Calcium,"20"))],[s__instance(_1911414,s__Object),-(s__measure(_1911414,s__MeasureFn("40.08",s__Amu))),s__instance(_1911414,s__Calcium),s__instance(_1911414,s__Atom)],[-(s__documentation(s__Calcium,s__EnglishLanguage,'Soft grey metallic element belonging to group 2 of the periodic table. Used a reducing agent in the extraction of thorium, zirconium and uranium. Essential element for living organisms.'))],[-(s__subclass(s__Scandium,s__ElementalSubstance))],[-(s__instance(s__Scandium__t,s__SetOrClass))],[-(s__names(s__Scandium,'Scandium'))],[-(s__conventionalShortName('Sc',s__Scandium))],[-(s__atomicNumber(s__Scandium,"21"))],[s__instance(_1911512,s__Object),-(s__measure(_1911512,s__MeasureFn("44.956",s__Amu))),s__instance(_1911512,s__Scandium),s__instance(_1911512,s__Atom)],[-(s__documentation(s__Scandium,s__EnglishLanguage,'Rare soft silvery metallic element belonging to group 3 of the periodic table. There are ten isotopes, nine of which are radioactive and have short half-lives. Predicted in 1869 by Mendeleev, isolated by Nilson in 1879.'))],[-(s__subclass(s__Titanium,s__ElementalSubstance))],[-(s__instance(s__Titanium__t,s__SetOrClass))],[-(s__names(s__Titanium,'Titanium'))],[-(s__conventionalShortName('Ti',s__Titanium))],[-(s__atomicNumber(s__Titanium,"22"))],[s__instance(_1911610,s__Object),-(s__measure(_1911610,s__MeasureFn("47.90",s__Amu))),s__instance(_1911610,s__Titanium),s__instance(_1911610,s__Atom)],[-(s__documentation(s__Titanium,s__EnglishLanguage,'White metallic transition element. Occurs in numerous minerals. Used in strong, light corrosion-resistant alloys. Forms a passive oxide coating when exposed to air. First discovered by Gregor in 1789.'))],[-(s__subclass(s__Vanadium,s__ElementalSubstance))],[-(s__instance(s__Vanadium__t,s__SetOrClass))],[-(s__names(s__Vanadium,'Vanadium'))],[-(s__conventionalShortName('V',s__Vanadium))],[-(s__atomicNumber(s__Vanadium,"23"))],[s__instance(_1911708,s__Object),-(s__measure(_1911708,s__MeasureFn("50.9415",s__Amu))),s__instance(_1911708,s__Vanadium),s__instance(_1911708,s__Atom)],[-(s__documentation(s__Vanadium,s__EnglishLanguage,'Soft and ductile, bright white metal. Good resistance to corrosion by alkalis, sulphuric and hydrochloric acid. It oxidizes readily about 933K. There are two naturally occurring isotopes of vanadium, and 5 radioisotopes, V-49 having the longest half-life at 337 days. Vanadium has nuclear applications, the foil is used in cladding titanium to steel, and vanadium-gallium tape is used to produce a superconductive magnet. Originally discovered by Andres Manuel del Rio of Mexico City in 1801. His discovery went unheeded, however, and in 1820, Nils Gabriel Sefstron of Sweden rediscovered it. Metallic vanadium was isolated by Henry Enfield Roscoe in 1867. The name vanadium comes from {Vanadis}, a goddess of Scandinavian mythology. Silvery-white metallic transition element. Vanadium is essential to {ascidian}s. Rats and chickens are also known to require it. Metal powder is a fire hazard, and vanadium compounds should be considered highly toxic. May cause lung cancer if inhaled.'))],[-(s__subclass(s__Chromium,s__ElementalSubstance))],[-(s__instance(s__Chromium__t,s__SetOrClass))],[-(s__names(s__Chromium,'Chromium'))],[-(s__conventionalShortName('Cr',s__Chromium))],[-(s__atomicNumber(s__Chromium,"24"))],[s__instance(_1911806,s__Object),-(s__measure(_1911806,s__MeasureFn("51.996",s__Amu))),s__instance(_1911806,s__Chromium),s__instance(_1911806,s__Atom)],[-(s__documentation(s__Chromium,s__EnglishLanguage,'Hard silvery transition element. Used in decorative electroplating. Discovered in 1797 by Vauquelin.'))],[-(s__subclass(s__Manganese,s__ElementalSubstance))],[-(s__instance(s__Manganese__t,s__SetOrClass))],[-(s__names(s__Manganese,'Manganese'))],[-(s__conventionalShortName('Mn',s__Manganese))],
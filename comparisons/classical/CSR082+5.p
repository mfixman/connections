12492,s__Gallium),s__instance(_1912492,s__Atom)],[-(s__documentation(s__Gallium,s__EnglishLanguage,'Soft silvery metallic element, belongs to group 13 of the periodic table. The two stable isotopes are Ga-69 and Ga-71. Eight radioactive isotopes are known, all having short half-lives. Gallium Arsenide is used as a semiconductor. Corrodes most other metals by diffusing into their lattice. First identified by Francois Lecoq de Boisbaudran in 1875.'))],[-(s__subclass(s__Germanium,s__ElementalSubstance))],[-(s__instance(s__Germanium__t,s__SetOrClass))],[-(s__names(s__Germanium,'Germanium'))],[-(s__conventionalShortName('Ge',s__Germanium))],[-(s__atomicNumber(s__Germanium,"32"))],[s__instance(_1912590,s__Object),-(s__measure(_1912590,s__MeasureFn("72.59",s__Amu))),s__instance(_1912590,s__Germanium),s__instance(_1912590,s__Atom)],[-(s__documentation(s__Germanium,s__EnglishLanguage,'Lustrous hard metalloid element, belongs to group 14 of the periodic table. Forms a large number of organometallic compounds. Predicted by Mendeleev in 1871, it was actually found in 1886 by Winkler.'))],[-(s__subclass(s__Arsenic,s__ElementalSubstance))],[-(s__instance(s__Arsenic__t,s__SetOrClass))],[-(s__names(s__Arsenic,'Arsenic'))],[-(s__conventionalShortName('As',s__Arsenic))],[-(s__atomicNumber(s__Arsenic,"33"))],[s__instance(_1912688,s__Object),-(s__measure(_1912688,s__MeasureFn("74.922",s__Amu))),s__instance(_1912688,s__Arsenic),s__instance(_1912688,s__Atom)],[-(s__documentation(s__Arsenic,s__EnglishLanguage,'Metalloid element of group 15. There are three allotropes, yellow, black, and grey. Reacts with halogens, concentrated oxidizing acids and hot alkalis. Albertus Magnus is believed to have been the first to isolate the element in 1250.'))],[-(s__subclass(s__Selenium,s__ElementalSubstance))],[-(s__instance(s__Selenium__t,s__SetOrClass))],[-(s__names(s__Selenium,'Selenium'))],[-(s__conventionalShortName('Se',s__Selenium))],[-(s__atomicNumber(s__Selenium,"34"))],[s__instance(_1912786,s__Object),-(s__measure(_1912786,s__MeasureFn("78.96",s__Amu))),s__instance(_1912786,s__Selenium),s__instance(_1912786,s__Atom)],[-(s__documentation(s__Selenium,s__EnglishLanguage,'Metalloid element, belongs to group 16 of the periodic table. Multiple allotropic forms exist. Chemically resembles sulphur. Discovered in 1817 by Jons J. Berzelius.'))],[-(s__subclass(s__Bromine,s__ElementalSubstance))],[-(s__instance(s__Bromine__t,s__SetOrClass))],[-(s__names(s__Bromine,'Bromine'))],[-(s__conventionalShortName('Br',s__Bromine))],[-(s__atomicNumber(s__Bromine,"35"))],[s__instance(_1912884,s__Object),-(s__measure(_1912884,s__MeasureFn("79.909",s__Amu))),s__instance(_1912884,s__Bromine),s__instance(_1912884,s__Atom)],[-(s__documentation(s__Bromine,s__EnglishLanguage,'Halogen element. Red volatile liquid at room temperature. Its reactivity is somewhere between chlorine and iodine. Harmful to human tissue in a liquid state, the vapour irritates eyes and throat. Discovered in 1826 by Antoine Balard.'))],[-(s__subclass(s__Krypton,s__ElementalSubstance))],[-(s__instance(s__Krypton__t,s__SetOrClass))],[-(s__names(s__Krypton,'Krypton'))],[-(s__conventionalShortName('Kr',s__Krypton))],[-(s__atomicNumber(s__Krypton,"36"))],[s__instance(_1912982,s__Object),-(s__measure(_1912982,s__MeasureFn("83.80",s__Amu))),s__instance(_1912982,s__Krypton),s__instance(_1912982,s__Atom)],[-(s__documentation(s__Krypton,s__EnglishLanguage,'Colorless gaseous element, belongs to the noble gases. Occurs in the air, 0.0001 percent by volume. It can be extracted from liquid air by fractional distillation. Generally not isolated, but used with other inert gases in fluorescent lamps. Five natural isotopes, and five radioactive isotopes. Kr-85, the most stable radioactive isotope, has a half-life of 10.76 years and is produced in fission reactors. Practically inert, though known to form compounds with {fluorine}.'))],[-(s__subclass(s__Rubidium,s__ElementalSubstance))],[-(s__instance(s__Rubidium__t,s__SetOrClass))],[-(s__names(s__Rubidium,'Rubidium'))],[-(s__conventionalShortName('Rb',s__Rubidium))],[-(s__atomicNumber(s__Rubidium,"37"))],[s__instance(_1913080,s__Object),-(s__measure(_1913080,s__MeasureFn("85.47",s__Amu))),s__instance(_1913080,s__Rubidium),s__instance(_1913080,s__Atom)],[-(s__documentation(s__Rubidium,s__EnglishLanguage,'Soft silvery metallic element, belongs to group 1 of the periodic table. Rb-97, the naturally occurring isotope, is radioactive. It is highly reactive, with properties similar to other elements in group 1, like igniting spontaneously in air. Discovered spectroscopically in 1861 by W. Bunsen and G.R. Kirchoff.'))],[-(s__subclass(s__Strontium,s__ElementalSubstance))],[-(s__instance(s__Strontium__t,s__SetOrClass))],[-(s__names(s__Strontium,'Strontium'))],[-(s__conventionalShortName('Sr',s__Strontium))],[-(s__atomicNumber(s__Strontium,"38"))],[s__instance(_1913178,s__Object),-(s__measure(_1913178,s__MeasureFn("87.62",s__Amu))),s__instance(_1913178,s__Strontium),s__instance(_1913178,s__Atom)],[-(s__documentation(s__Strontium,s__EnglishLanguage,'Soft yellowish metallic element, belongs to group 2 of the periodic table. Highly reactive chemically. Sr-90 is present in radioactive fallout and has a half-life of 28 years. Discovered in 1798 by Klaproth and Hope, isolated in 1808 by Humphry Davy.'))],[-(s__subclass(s__Yttrium,s__ElementalSubstance))],[-(s__instance(s__Yttrium__t,s__SetOrClass))],[-(s__names(s__Yttrium,'Yttrium'))],[-(s__conventionalShortName('Y',s__Yttrium))],[-(s__atomicNumber(s__Yttrium,"39"))],[s__instance(_1913276,s__Object),-(s__measure(_1913276,s__MeasureFn("88.905",s__Amu))),s__instance(_1913276,s__Yttrium),s__instance(_1913276,s__Atom)],[-(s__documentation(s__Yttrium,s__EnglishLanguage,'Silvery-grey metallic element of group 3 on the periodic table. Found in uranium ores. The only natural isotope is Y-89, there are 14 other artificial isotopes. Chemically resembles the lanthanoids. Stable in the air below 400 degrees, celsius. Discovered in 1828 by Friedrich Wohler.'))],[-(s__subclass(s__Zirconium,s__ElementalSubstance))],[-(s__instance(s__Zirconium__t,s__SetOrClass))],[-(s__names(s__Zirconium,'Zirconium'))],[-(s__conventionalShortName('Zr',s__Zirconium))],[-(s__atomicNumber(s__Zirconium,"40"))],[s__instance(_1913374,s__Object),-(s__measure(_1913374,s__MeasureFn("91.22",s__Amu))),s__instance(_1913374,s__Zirconium),s__instance(_1913374,s__Atom)],[-(s__documentation(s__Zirconium,s__EnglishLanguage,'Grey-white metallic transition element. Five natural isotopes and six radioactive isotopes are known. Used in nuclear reactors for a {neutron} absorber. Discovered in 1789 by Martin Klaproth, isolated in 1824 by Berzelius.'))],[-(s__subclass(s__Niobium,s__ElementalSubstance))],[-(s__instance(s__Niobium__t,s__SetOrClass))],[-(s__names(s__Niobium,'Niobium'))],[-(s__conventionalShortName('Nb',s__Niobium))],[-(s__atomicNumber(s__Niobium,"41"))],[s__instance(_1913472,s__Object),-(s__measure(_1913472,s__MeasureFn("92.906",s__Amu))),s__instance(_1913472,s__Niobium),s__instance(_1913472,s__Atom)],[-(s__documentation(s__Niobium,s__EnglishLanguage,'Soft, ductile grey-blue metallic transition element. Used in special steels and in welded joints to increase strength. Combines with halogens and oxidizes in air at 200 degrees celsius. Discovered by Charles Hatchett in 1801 and isolated by Blomstrand in 1864. Called {columbium} originally.'))],[-(s__subclass(s__Molybdenum,s__ElementalSubstance))],[-(s__instance(s__Molybdenum__t,s__SetOrClass))],[-(s__names(s__Molybdenum,'Molybdenum'))],[-(s__conventionalShortName('Mo',s__Molybdenum))],[-(s__atomicNumber(s__Molybdenum,"42"))],[s__instance(_1913570,s__Object),-(s__measure(_1913570,s__MeasureFn("95.94",s__Amu))),s__instance(_1913570,s__Molybdenum),s__instance(_1913570,s__Atom)],[-(s__documentation(s__Molybdenum,s__EnglishLanguage,'Silvery-white, hard metallic transition element. It is chemically unreactive and is not affected by most acids. It oxidizes at high temperatures. There are seven natural isotopes, and four radioisotopes, Mo-93 being the most stable with a half-life of 3500 years. Molybdenum is used in almost all high-strength steels, it has nuclear applications, and is a catalyst in petroleum refining. Discovered in 1778 by Carl Welhelm Scheele of Sweden. Impure metal was prepared in 1782 by Peter Jacob Hjelm. The name comes from the Greek word molybdos which means lead. Trace amounts of molybdenum are required for all known forms of life. All molybdenum compounds should be considered highly toxic, and will also cause severe birth defects.'))],[-(s__subclass(s__Technetium,s__ElementalSubstance))],[-(s__instance(s__Technetium__t,s__SetOrClass))],[-(s__names(s__Technetium,'Technetium'))],[-(s__conventionalShortName('Tc',s__Technetium))],[-(s__atomicNumber(s__Technetium,"43"))],[s__instance(_1913668,s__Object),-(s__measure(_1913668,s__MeasureFn("98",s__Amu))),s__instance(_1913668,s__Technetium),s__instance(_1913668,s__Atom)],[-(s__documentation(s__Technetium,s__EnglishLanguage,'Radioactive metallic transition element. Can be detected in some stars and the fission products of uranium. First made by Perrier and Segre by bombarding molybdenum with deutrons, giving them Tc-97. Tc-99 is the most stable isotope with a half-life of 2.6*10^6 years. Sixteen isotopes are known. Organic technetium compounds are used in bone imaging. Chemical properties are intermediate between rhenium and manganese.'))],[-(s__subclass(s__Ruthenium,s__ElementalSubstance))],[-(s__instance(s__Ruthenium__t,s__SetOrClass))],[-(s__names(s__Ruthenium,'Ruthenium'))],[-(s__conventionalShortName('Ru',s__Ruthenium))],[-(s__atomicNumber(s__Ruthenium,"44"))],[s__instance(_1913766,s__Object),-(s__measure(_1913766,s__MeasureFn("101.07",s__Amu))),s__instance(_1913766,s__Ruthenium),s__instance(_1913766,s__Atom)],[-(s__documentation(s__Ruthenium,s__EnglishLanguage,'Hard white metallic transition element. Found with platinum, used as a catalyst in some platinum alloys. Dissolves in fused alkalis, and is not attacked by acids. Reacts with halogens and oxygen at high temperatures. Isolated in 1844 by K.K. Klaus.'))],[-(s__subclass(s__Rhodium,s__ElementalSubstance))],[-(s__instance(s__Rhodium__t,s__SetOrClass))],[-(s__names(s__Rhodium,'Rhodium'))],[-(s__conventionalShortName('Rh',s__Rhodium))],[-(s__atomicNumber(s__Rhodium,"45"))],[s__instance(_1913864,s__Object),-(s__measure(_1913864,s__MeasureFn("102.905",s__Amu))),s__instance(_1913864,s__Rhodium),s__instance(_1913864,s__Atom)],[-(s__documentation(s__Rhodium,s__EnglishLanguage,'Silvery white metallic transition element. Found with platinum and used in some platinum alloys. Not attacked by acids, dissolves only in aqua regia. Discovered in 1803 by W.H. Wollaston.'))],[-(s__subclass(s__Palladium,s__ElementalSubstance))],[-(s__instance(s__Palladium__t,s__SetOrClass))],[-(s__names(s__Palladium,'Palladium'))],[-(s__conventionalShortName('Pd',s__Palladium))],[-(s__atomicNumber(s__Palladium,"46"))],[s__instance(_1913962,s__Object),-(s__measure(_1913962,s__MeasureFn("106.4",s__Amu))),s__instance(_1913962,s__Palladium),s__instance(_1913962,s__Atom)],[-(s__documentation(s__Palladium,s__EnglishLanguage,'Soft white ductile transition element. Found with some copper and nickel ores. Does not react with oxygen at normal temperatures. Dissolves slowly in hydrochloric acid. Discovered in 1803 by W.H. Wollaston.'))],[-(s__subclass(s__Silver,s__ElementalSubstance))],[-(s__instance(s__Silver__t,s__SetOrClass))],[-(s__names(s__Silver,'Silver'))],[-(s__conventionalShortName('Ag',s__Silver))],[-(s__atomicNumber(s__Silver,"47"))],[s__instance(_1914060,s__Object),-(s__measure(_1914060,s__MeasureFn("107.870",s__Amu))),s__instance(_1914060,s__Silver),s__instance(_1914060,s__Atom)],[-(s__documentation(s__Silver,s__EnglishLanguage,'White lustrous soft metallic transition element. Found in both its elemental form and in minerals. Used in jewellery, tableware and so on. Less reactive than silver, chemically.'))],[-(s__subclass(s__Cadmium,s__ElementalSubstance))],[-(s__instance(s__Cadmium__t,s__SetOrClass))],[-(s__names(s__Cadmium,'Cadmium'))],[-(s__conventionalShortName('Cd',s__Cadmium))],[-(s__atomicNumber(s__Cadmium,"48"))],[s__instance(_1914158,s__Object),-(s__measure(_1914158,s__MeasureFn("112.40",s__Amu))),s__instance(_1914158,s__Cadmium),s__instance(_1914158,s__Atom)],[-(s__documentation(s__Cadmium,s__EnglishLanguage,'Soft bluish metal belonging to group 12 of the periodic table. Extremely toxic even in low concentrations. Chemically similar to zinc, but lends itself to more complex compounds. Discovered in 1817 by F. Stromeyer.'))],[-(s__subclass(s__Indium,s__ElementalSubstance))],[-(s__instance(s__Indium__t,s__SetOrClass))],[-(s__names(s__Indium,'Indium'))],[-(s__conventionalShortName('In',s__Indium))],[-(s__atomicNumber(s__Indium,"49"))],[s__instance(_1914256,s__Object),-(s__measure(_1914256,s__MeasureFn("114.82",s__Amu))),s__instance(_1914256,s__Indium),s__instance(_1914256,s__Atom)],[-(s__documentation(s__Indium,s__EnglishLanguage,'Soft silvery element belonging to group 13 of the periodic table. The most common natural isotope is In-115, which has a half-life of 6*10^4 years. Five other radioisotopes exist. Discovered in 1863 by Reich and Richter.'))],[-(s__subclass(s__Tin,s__ElementalSubstance))],[-(s__instance(s__Tin__t,s__SetOrClass))],[-(s__names(s__Tin,'Tin'))],[-(s__conventionalShortName('Sn',s__Tin))],[-(s__atomicNumber(s__Tin,"50"))],[s__instance(_1914354,s__Object),-(s__measure(_1914354,s__MeasureFn("118.69",s__Amu))),s__instance(_1914354,s__Tin),s__instance(_1914354,s__Atom)],[-(s__documentation(s__Tin,s__EnglishLanguage,'Silvery malleable metallic element belonging to group 14 of the periodic table. Twenty-six isotopes are known, five of which are radioactive. Chemically reactive. Combines directly with chlorine and oxygen and displaces hydrogen from dilute acids. '))],[-(s__subclass(s__Antimony,s__ElementalSubstance))],[-(s__instance(s__Antimony__t,s__SetOrClass))],[-(s__names(s__Antimony,'Antimony'))],[-(s__conventionalShortName('Sb',s__Antimony))],[-(s__atomicNumber(s__Antimony,"51"))],[s__instance(_1914452,s__Object),-(s__measure(_1914452,s__MeasureFn("121.75",s__Amu))),s__instance(_1914452,s__Antimony),s__instance(_1914452,s__Atom)],[-(s__documentation(s__Antimony,s__EnglishLanguage,'Element of group 15. Multiple allotropic forms. The stable form of antimony is a blue-white metal. Yellow and black antimony are unstable non-metals. Used in flame-proofing, paints, ceramics, enamels, and rubber. Attacked by oxidizing acids and halogens. First reported by Tholden in 1450.'))],[-(s__subclass(s__Tellurium,s__ElementalSubstance))],[-(s__instance(s__Tellurium__t,s__SetOrClass))],[-(s__names(s__Tellurium,'Tellurium'))],[-(s__conventionalShortName('Te',s__Tellurium))],[-(s__atomicNumber(s__Tellurium,"52"))],[s__instance(_1914550,s__Object),-(s__measure(_1914550,s__MeasureFn("127.60",s__Amu))),s__instance(_1914550,s__Tellurium),s__instance(_1914550,s__Atom)],[-(s__documentation(s__Tellurium,s__EnglishLanguage,'Silvery metalloid element of group 16. Eight natural isotopes, nine radioactive isotopes. Used in semiconductors and to a degree in some steels. Chemistry is similar to {sulphur}. Discovered in 1782 by Franz Miller.'))],[-(s__subclass(s__Iodine,s__ElementalSubstance))],[-(s__instance(s__Iodine__t,s__SetOrClass))],[-(s__names(s__Iodine,'Iodine'))],[-(s__conventionalShortName('I',s__Iodine))],[-(s__atomicNumber(s__Iodine,"53"))],[s__instance(_1914648,s__Object),-(s__measure(_1914648,s__MeasureFn("126.904",s__Amu))),s__instance(_1914648,s__Iodine),s__instance(_1914648,s__Atom)],[-(s__documentation(s__Iodine,s__EnglishLanguage,'Dark violet nonmetallic element, belongs to group 17 of the periodic table. Insoluble in water. Required as a trace element for living organisms. One stable isotope, I-127 exists, in addition to fourteen radioactive isotopes. Chemically the least reactive of the halogens, and the most electropositive metallic halogen. Discovered in 1812 by Courtois. '))],[-(s__subclass(s__Xenon,s__ElementalSubstance))],[-(s__instance(s__Xenon__t,s__SetOrClass))],[-(s__names(s__Xenon,'Xenon'))],[-(s__conventionalShortName('Xe',s__Xenon))],[-(s__atomicNumber(s__Xenon,"54"))],[s__instance(_1914746,s__Object),-(s__measure(_1914746,s__MeasureFn("131.30",s__Amu))),s__instance(_1914746,s__Xenon),s__instance(_1914746,s__Atom)],[-(s__documentation(s__Xenon,s__EnglishLanguage,'Colourless, odourless gas belonging to group 18 on the periodic table (the noble gases.) Nine natural isotopes and seven radioactive isotopes are known. Xenon was part of the first noble-gas compound synthesized. Several others involving Xenon have been found since then. Xenon was discovered by Ramsey and Travers in 1898.'))],[-(s__subclass(s__Caesium,s__ElementalSubstance))],[-(s__instance(s__Caesium__t,s__SetOrClass))],[-(s__names(s__Caesium,'Caesium'))],[-(s__conventionalShortName('Cs',s__Caesium))],[-(s__atomicNumber(s__Caesium,"55"))],[s__instance(_1914844,s__Object),-(s__measure(_1914844,s__MeasureFn("132.90545",s__Amu))),s__instance(_1914844,s__Caesium),s__instance(_1914844,s__Atom)],[-(s__documentation(s__Caesium,s__EnglishLanguage,'Soft silvery-white metallic element belonging to group 1 of the periodic table. One of the three metals which are liquid at room temperature. Cs-133 is the natural, and only stable, isotope. Fifteen other radioisotopes exist. Caesium reacts explosively with cold water, and ice at temperatures above 157K. Caesium hydroxide is the strongest base known. Caesium is the most electropositive, most alkaline and has the least ionization potential of all the elements. Known uses include the basis of atomic clocks, catalyst for the hydrogenation of some organic compounds, and in photoelectric cells. Caesium was discovered by Gustav Kirchoff and Robert Bunsen in Germany in 1860 spectroscopically. Its identification was based upon the bright blue lines in its spectrum. The name comes from the latin word caesius, which means sky blue. Caesium should be considered highly toxic. Some of the radioisotopes are even more toxic.'))],[-(s__subclass(s__Barium,s__ElementalSubstance))],[-(s__instance(s__Barium__t,s__SetOrClass))],[-(s__names(s__Barium,'Barium'))],[-(s__conventionalShortName('Ba',s__Barium))],[-(s__atomicNumber(s__Barium,"56"))],[s__instance(_1914942,s__Object),-(s__measure(_1914942,s__MeasureFn("137.34",s__Amu))),s__instance(_1914942,s__Barium),s__instance(_1914942,s__Atom)],[-(s__documentation(s__Barium,s__EnglishLanguage,'Silvery-white reactive element, belonging to group 2 of the periodic table. Soluble barium compounds are extremely poisonous. Identified in 1774 by Karl Scheele and extracted in 1808 by Humphry Davy.'))],[-(s__subclass(s__Lanthanum,s__ElementalSubstance))],[-(s__instance(s__Lanthanum__t,s__SetOrClass))],[-(s__names(s__Lanthanum,'Lanthanum'))],[-(s__conventionalShortName('La',s__Lanthanum))],[-(s__atomicNumber(s__Lanthanum,"57"))],[s__instance(_1915040,s__Object),-(s__measure(_1915040,s__MeasureFn("138.9055",s__Amu))),s__instance(_1915040,s__Lanthanum),s__instance(_1915040,s__Atom)],[-(s__documentation(s__Lanthanum,s__EnglishLanguage,'(From the Greek word lanthanein, to line hidden) Silvery metallic element belonging to group 3 of the periodic table and oft considered to be one of the lanthanoids. Found in some rare-earth minerals. Twenty-five natural isotopes exist. La-139 which is stable, and La-138 which has a half-life of 10^10 to 10^15 years. The other twenty-three isotopes are radioactive. It resembles the lanthanoids chemically. Lanthanum has a low to moderate level of toxicity, and should be handled with care. Discovered in 1839 by C.G. Mosander.'))],[-(s__subclass(s__Cerium,s__ElementalSubstance))],[-(s__instance(s__Cerium__t,s__SetOrClass))],[-(s__names(s__Cerium,'Cerium'))],[-(s__conventionalShortName('Ce',s__Cerium))],[-(s__atomicNumber(s__Cerium,"58"))],[s__instance(_1915138,s__Object),-(s__measure(_1915138,s__MeasureFn("140.12",s__Amu))),s__instance(_1915138,s__Cerium),s__instance(_1915138,s__Atom)],[-(s__documentation(s__Cerium,s__EnglishLanguage,'Silvery metallic element, belongs to the lanthanoids. Four natural isotopes exist, and fifteen radioactive isotopes have been identified. Used in some rare-earth alloys. The oxidized form is used in the glass industry. Discovered by Martin .H. Klaproth in 1803.'))],[-(s__subclass(s__Praseodymium,s__ElementalSubstance))],[-(s__instance(s__Praseodymium__t,s__SetOrClass))],[-(s__names(s__Praseodymium,'Praseodymium'))],[-(s__conventionalShortName('Pr',s__Praseodymium))],[-(s__atomicNumber(s__Praseodymium,"59"))],[s__instance(_1915236,s__Object),-(s__measure(_1915236,s__MeasureFn("140.907",s__Amu))),s__instance(_1915236,s__Praseodymium),s__instance(_1915236,s__Atom)],[-(s__documentation(s__Praseodymium,s__EnglishLanguage,'Soft silvery metallic element, belongs to the lanthanoids. Only natural isotope is Pr-141 which is not radioactive. Fourteen radioactive isotopes have been artificially produced. Used in rare-earth alloys. Discovered in 1885 by C.A. von Welsbach.'))],[-(s__subclass(s__Neodymium,s__ElementalSubstance))],[-(s__instance(s__Neodymium__t,s__SetOrClass))],[-(s__names(s__Neodymium,'Neodymium'))],[-(s__conventionalShortName('Nd',s__Neodymium))],[-(s__atomicNumber(s__Neodymium,"60"))],[s__instance(_1915334,s__Object),-(s__measure(_1915334,s__MeasureFn("144.24",s__Amu))),s__instance(_1915334,s__Neodymium),s__instance(_1915334,s__Atom)],[-(s__documentation(s__Neodymium,s__EnglishLanguage,'Soft bright silvery metallic element, belongs to the lanthanoids. Seven natural isotopes, Nd-144 being the only radioactive one with a half-life of 10^10 to 10^15 years. Six artificial radioisotopes have been produced. The metal is used in glass works to color class a shade of violet-purple and make it dichroic. One of the more reactive rare-earth metals, quickly reacts with air. Used in some rare-earth alloys. Neodymium is used to color the glass used in welders glasses. Neodymium is also used in very powerful, permanent magnets (Nd2Fe14B). Discovered by Carl F. Auer von Welsbach in Austria in 1885 by separating didymium into its elemental components {praseodymium} and neodymium. The name comes from the Greek words neos didymos which means new twin. Neodymium should be considered highly toxic, however evidence would seem to show that it acts as little more than a skin and eye irritant. The dust however, presents a fire and explosion hazard.'))],[-(s__subclass(s__Promethium,s__ElementalSubstance))],[-(s__instance(s__Promethium__t,s__SetOrClass))],[-(s__names(s__Promethium,'Promethium'))],[-(s__conventionalShortName('Pm',s__Promethium))],[-(s__atomicNumber(s__Promethium,"61"))],[s__instance(_1915432,s__Object),-(s__measure(_1915432,s__MeasureFn("147",s__Amu))),s__instance(_1915432,s__Promethium),s__instance(_1915432,s__Atom)],[-(s__documentation(s__Promethium,s__EnglishLanguage,'Soft silvery metallic element, belongs to the lanthanoids. Pm-147, the only natural isotope, is radioactive and has a half-life of 252 years. Eighteen radioisotopes have been produced, but all have very short half-lives. Found only in nuclear decay waste. Pm-147 is of interest as a beta-decay source, however Pm-146 and Pm-148 have to be removed from it first, as they generate gamma radiation. Discovered by J.A. Marinsky, L.E. Glendenin and C.D. Coryell in 1947.'))],[-(s__subclass(s__Samarium,s__ElementalSubstance))],[-(s__instance(s__Samarium__t,s__SetOrClass))],[-(s__names(s__Samarium,'Samarium'))],[-(s__conventionalShortName('Sm',s__Samarium))],[-(s__atomicNumber(s__Samarium,"62"))],[s__instance(_1915530,s__Object),-(s__measure(_1915530,s__MeasureFn("150.35",s__Amu))),s__instance(_1915530,s__Samarium),s__instance(_1915530,s__Atom)],[-(s__documentation(s__Samarium,s__EnglishLanguage,'Soft silvery metallic element, belongs to the lanthanoids. Seven natural isotopes, Sm-147 is the only radioisotope, and has a half-life of 2.5*10^11 years. Used for making special alloys needed in the production of nuclear reactors. Also used as a neutron absorber. Small quantities of samarium oxide is used in special optical glasses. The largest use of the element is its ferromagnetic alloy which produces permanent magnets that are five times stronger than magnets produced by any other material. Discovered by Francois Lecoq de Boisbaudran in 1879.'))],[-(s__subclass(s__Europium,s__ElementalSubstance))],[-(s__instance(s__Europium__t,s__SetOrClass))],[-(s__names(s__Europium,'Europium'))],[-(s__conventionalShortName('Eu',s__Europium))],[-(s__atomicNumber(s__Europium,"63"))],[s__instance(_1915628,s__Object),-(s__measure(_1915628,s__MeasureFn("151.25",s__Amu))),s__instance(_1915628,s__Europium),s__instance(_1915628,s__Atom)],[-(s__documentation(s__Europium,s__EnglishLanguage,'Soft silvery metallic element belonging to the lanthanoids. Eu-151 and Eu-153 are the only two stable isotopes, both of which are {neutron} absorbers. Discovered in 1889 by Sir William Crookes.'))],[-(s__subclass(s__Gadolinium,s__ElementalSubstance))],[-(s__instance(s__Gadolinium__t,s__SetOrClass))],[-(s__names(s__Gadolinium,'Gadolinium'))],[-(s__conventionalShortName('Gd',s__Gadolinium))],[-(s__atomicNumber(s__Gadolinium,"64"))],[s__instance(_1915726,s__Object),-(s__measure(_1915726,s__MeasureFn("157.25",s__Amu))),s__instance(_1915726,s__Gadolinium),s__instance(_1915726,s__Atom)],[-(s__documentation(s__Gadolinium,s__EnglishLanguage,'Soft silvery metallic element belonging to the lanthanoids. Seven natural, stable isotopes are known in addition to eleven artificial isotopes. Gd-155 and Gd-157 and the best neutron absorbers of all elements. Gadolinium compounds are used in electronics. Discovered by J.C.G Marignac in 1880.'))],[-(s__subclass(s__Terbium,s__ElementalSubstance))],[-(s__instance(s__Terbium__t,s__SetOrClass))],[-(s__names(s__Terbium,'Terbium'))],[-(s__conventionalShortName('Tb',s__Terbium))],[-(s__atomicNumber(s__Terbium,"65"))],[s__instance(_1915824,s__Object),-(s__measure(_1915824,s__MeasureFn("158.924",s__Amu))),s__instance(_1915824,s__Terbium),s__instance(_1915824,s__Atom)],[-(s__documentation(s__Terbium,s__EnglishLanguage,'Silvery metallic element belonging to the lanthanoids. Tb-159 is the only stable isotope, there are seventeen artificial isotopes. Discovered by G.G. Mosander in 1843.'))],[-(s__subclass(s__Dysprosium,s__ElementalSubstance))],[-(s__instance(s__Dysprosium__t,s__SetOrClass))],[-(s__names(s__Dysprosium,'Dysprosium'))],[-(s__conventionalShortName('Dy',s__Dysprosium))],[-(s__atomicNumber(s__Dysprosium,"66"))],[s__instance(_1915922,s__Object),-(s__measure(_1915922,s__MeasureFn("162.50",s__Amu))),s__instance(_1915922,s__Dysprosium),s__instance(_1915922,s__Atom)],[-(s__documentation(s__Dysprosium,s__EnglishLanguage,'Metallic with a bright silvery-white lustre. Dysprosium belongs to the lanthanoids. It is relatively stable in air at room temperatures, it will however dissolve in mineral acids, evolving hydrogen. It is found in from rare-earth minerals. There are seven natural isotopes of dysprosium, and eight radioisotopes, Dy-154 being the most stable with a half-life of 3*10^6 years. Dysprosium is used as a neutron absorber in nuclear fission reactions, and in compact disks. It was discovered by Paul Emile Lecoq de Boisbaudran in 1886 in France. Its name comes from the Greek word dysprositos, which means hard to obtain.'))],[-(s__subclass(s__Holmium,s__ElementalSubstance))],[-(s__instance(s__Holmium__t,s__SetOrClass))],[-(s__names(s__Holmium,'Holmium'))],[-(s__conventionalShortName('Ho',s__Holmium))],[-(s__atomicNumber(s__Holmium,"67"))],[s__instance(_1916020,s__Object),-(s__measure(_1916020,s__MeasureFn("167.26",s__Amu))),s__instance(_1916020,s__Holmium),s__instance(_1916020,s__Atom)],[-(s__documentation(s__Holmium,s__EnglishLanguage,'Relatively soft and malleable silvery-white metallic element, which is stable in dry air at room temperature. It oxidizes in moist air and at high temperatures. It belongs to the lanthanoids. A rare-earth metal, it is found in the minerals monazite and gadolinite. It possesses unusual magnetic properties. One natural isotope, Ho-165 exists, six radioisotopes exist, the most stable being Ho-163 with a half-life of 4570 years. Holmium is used in some metal alloys, it is also said to stimulate the metabolism. Discovered by Per Theodor Cleve and J.L. Soret in Switzerland in 1879. The name homium comes from the Greek word Holmia which means Sweden. While all holmium compounds should be considered highly toxic, initial evidence seems to indicate that they do not pose much danger. The metals dust however, is a fire hazard.'))],[-(s__subclass(s__Erbium,s__ElementalSubstance))],[-(s__instance(s__Erbium__t,s__SetOrClass))],[-(s__names(s__Erbium,'Erbium'))],[-(s__conventionalShortName('Er',s__Erbium))],[-(s__atomicNumber(s__Erbium,"68"))],[s__instance(_1916118,s__Object),-(s__measure(_1916118,s__MeasureFn("167.26",s__Amu))),s__instance(_1916118,s__Erbium),s__instance(_1916118,s__Atom)],[-(s__documentation(s__Erbium,s__EnglishLanguage,'Soft silvery metallic element which belongs to the lanthanoids. Six natural isotopes that are stable. Twelve artificial isotopes are known. Used in nuclear technology as a neutron absorber. It is being investigated for other possible uses. Discovered by Carl G. Mosander in 1843.'))],[-(s__subclass(s__Thulium,s__ElementalSubstance))],[-(s__instance(s__Thulium__t,s__SetOrClass))],[-(s__names(s__Thulium,'Thulium'))],[-(s__conventionalShortName('Tm',s__Thulium))],[-(s__atomicNumber(s__Thulium,"69"))],[s__instance(_1916216,s__Object),-(s__measure(_1916216,s__MeasureFn("168.934",s__Amu))),s__instance(_1916216,s__Thulium),s__instance(_1916216,s__Atom)],[-(s__documentation(s__Thulium,s__EnglishLanguage,'Soft grey metallic element that belongs to the lanthanoids. One natural isotope exists, Tm-169, and seventeen artificial isotopes have been produced. No known uses for the element. Discovered in 1879 by Per Theodor Cleve.'))],[-(s__subclass(s__Ytterbium,s__ElementalSubstance))],[-(s__instance(s__Ytterbium__t,s__SetOrClass))],[-(s__names(s__Ytterbium,'Ytterbium'))],[-(s__conventionalShortName('Yb',s__Ytterbium))],[-(s__atomicNumber(s__Ytterbium,"70"))],[s__instance(_1916314,s__Object),-(s__measure(_1916314,s__MeasureFn("173.04",s__Amu))),s__instance(_1916314,s__Ytterbium),s__instance(_1916314,s__Atom)],[-(s__documentation(s__Ytterbium,s__EnglishLanguage,'Silvery metallic element of the lanthanoids. Seven natural isotopes and ten artificial isotopes are known. Used in certain steels. Discovered by J.D.G. Marignac in 1878.'))],[-(s__subclass(s__Lutetium,s__ElementalSubstance))],[-(s__instance(s__Lutetium__t,s__SetOrClass))],[-(s__names(s__Lutetium,'Lutetium'))],[-(s__conventionalShortName('Lu',s__Lutetium))],[-(s__atomicNumber(s__Lutetium,"71"))],[s__instance(_1916412,s__Object),-(s__measure(_1916412,s__MeasureFn("194.967",s__Amu))),s__instance(_1916412,s__Lutetium),s__instance(_1916412,s__Atom)],[-(s__documentation(s__Lutetium,s__EnglishLanguage,'Silvery-white rare-earth metal which is relatively stable in air. It happens to be the most expensive rare-earth metal. Its found with almost all rare-earth metals, but is very difficult to separate from other elements. Least abundant of all natural elements. Used in metal alloys, and as a catalyst in various processes. There are two natural, stable isotopes, and seven radioisotopes, the most stable being Lu-174 with a half-life of 3.3 years. The separation of lutetium from {ytterbium} was described by Georges Urbain in 1907. It was discovered at approximately the same time by Carl Auer von Welsbach. The name comes from the Greek word lutetia which means Paris.'))],[-(s__subclass(s__Hafnium,s__ElementalSubstance))],[-(s__instance(s__Hafnium__t,s__SetOrClass))],[-(s__names(s__Hafnium,'Hafnium'))],[-(s__conventionalShortName('Hf',s__Hafnium))],[-(s__atomicNumber(s__Hafnium,"72"))],[s__instance(_1916510,s__Object),-(s__measure(_1916510,s__MeasureFn("178.49",s__Amu))),s__instance(_1916510,s__Hafnium),s__instance(_1916510,s__Atom)],[-(s__documentation(s__Hafnium,s__EnglishLanguage,'Silvery lustrous metallic transition element. Used in tungsten alloys in filaments and electrodes, also acts as a neutron absorber. First reported by Urbain in 1911, existence was finally established in 1923 by D. Coster, G.C. de Hevesy in 1923.'))],[-(s__subclass(s__Tantalum,s__ElementalSubstance))],[-(s__instance(s__Tantalum__t,s__SetOrClass))],[-(s__names(s__Tantalum,'Tantalum'))],[-(s__conventionalShortName('Ta',s__Tantalum))],[-(s__atomicNumber(s__Tantalum,"73"))],[s__instance(_1916608,s__Object),-(s__measure(_1916608,s__MeasureFn("180.948",s__Amu))),s__instance(_1916608,s__Tantalum),s__instance(_1916608,s__Atom)],[-(s__documentation(s__Tantalum,s__EnglishLanguage,'Heavy blue-grey metallic transition element. Ta-181 is a stable isotope, and Ta-180 is a radioactive isotope, with a half-life in excess of 10^7 years. Used in surgery as it is unreactive. Forms a passive oxide layer in air. Identified in 1802 by Ekeberg and isolated in 1820 by Jons J. Berzelius.'))],[-(s__subclass(s__Tungsten,s__ElementalSubstance))],[-(s__instance(s__Tungsten__t,s__SetOrClass))],[-(s__names(s__Tungsten,'Tungsten'))],[-(s__conventionalShortName('W',s__Tungsten))],[-(s__atomicNumber(s__Tungsten,"74"))],[s__instance(_1916706,s__Object),-(s__measure(_1916706,s__MeasureFn("183.85",s__Amu))),s__instance(_1916706,s__Tungsten),s__instance(_1916706,s__Atom)],[-(s__documentation(s__Tungsten,s__EnglishLanguage,'White or grey metallic transition element, formerly called {wolfram}. Forms a protective oxide in air and can be oxidized at high temperature. First isolated by Jose and Fausto de Elhuyer in 1783.'))],[-(s__subclass(s__Rhenium,s__ElementalSubstance))],[-(s__instance(s__Rhenium__t,s__SetOrClass))],[-(s__names(s__Rhenium,'Rhenium'))],[-(s__conventionalShortName('Re',s__Rhenium))],[-(s__atomicNumber(s__Rhenium,"75"))],[s__instance(_1916804,s__Object),-(s__measure(_1916804,s__MeasureFn("186.2",s__Amu))),s__instance(_1916804,s__Rhenium),s__instance(_1916804,s__Atom)],[-(s__documentation(s__Rhenium,s__EnglishLanguage,'Silvery-white metallic transition element. Obtained as a by-product of molybdenum refinement. Rhenium-molybdenum alloys are superconducting.'))],[-(s__subclass(s__Osmium,s__ElementalSubstance))],[-(s__instance(s__Osmium__t,s__SetOrClass))],[-(s__names(s__Osmium,'Osmium'))],[-(s__conventionalShortName('Os',s__Osmium))],[-(s__atomicNumber(s__Osmium,"76"))],[s__instance(_1916902,s__Object),-(s__measure(_1916902,s__MeasureFn("190.2",s__Amu))),s__instance(_1916902,s__Osmium),s__instance(_1916902,s__Atom)],[-(s__documentation(s__Osmium,s__EnglishLanguage,'Hard blue-white metallic transition element. Found with platinum and used in some alloys with platinum and iridium.'))],[-(s__subclass(s__Iridium,s__ElementalSubstance))],[-(s__instance(s__Iridium__t,s__SetOrClass))],[-(s__names(s__Iridium,'Iridium'))],[-(s__conventionalShortName('Ir',s__Iridium))],[-(s__atomicNumber(s__Iridium,"77"))],[s__instance(_1917000,s__Object),-(s__measure(_1917000,s__MeasureFn("192.217",s__Amu))),s__instance(_1917000,s__Iridium),s__instance(_1917000,s__Atom)],[-(s__documentation(s__Iridium,s__EnglishLanguage,'Very hard and brittle, silvery metallic transition element. It has a yellowish cast to it. Salts of iridium are highly colored. It is the most corrosion resistant metal known, not attacked by any acid, but is attacked by molten salts. There are two natural isotopes of iridium, and 4 radioisotopes, the most stable being Ir-192 with a half-life of 73.83 days. Ir-192 decays into {platinum}, while the other radioisotopes decay into {osmium}. Iridium is used in high temperature apparatus, electrical contacts, and as a hardening agent for platinum. Discovered in 1803 by Smithson Tennant in England. The name comes from the Greek word iris, which means rainbow. Iridium metal is generally non-toxic due to its relative unreactivity, but iridium compounds should be considered highly toxic.'))],[-(s__subclass(s__Platinum,s__ElementalSubstance))],[-(s__instance(s__Platinum__t,s__SetOrClass))],[-(s__names(s__Platinum,'Platinum'))],[-(s__conventionalShortName('Pt',s__Platinum))],[-(s__atomicNumber(s__Platinum,"78"))],[s__instance(_1917098,s__Object),-(s__measure(_1917098,s__MeasureFn("195.078",s__Amu))),s__instance(_1917098,s__Platinum),s__instance(_1917098,s__Atom)],[-(s__documentation(s__Platinum,s__EnglishLanguage,'Attractive greyish-white metal. When pure, it is malleable and ductile. Does not oxidize in air, insoluble in hydrochloric and nitric acid. Corroded by halogens, cyandies, sulphur and alkalis. {Hydrogen} and {oxygen} react explosively in the presence of platinum. There are six stable isotopes and three radioisotopes, the most stable being Pt-193 with a half-life of 60 years. Platinum is used in jewelry, laboratory equipment, electrical contacts, dentistry, and anti-pollution devices in cars. PtCl2(NH3)2 is used to treat some forms of cancer. Platinum-{cobalt} alloys have magnetic properties. It is also used in the definition of the Standard Hydrogen Electrode. Discovered by Antonio de Ulloa in South America in 1735. The name comes from the Spanish word platina which means silver. Platinum metal is generally not a health concern due to its unreactivity, however platinum compounds should be considered highly toxic.'))],[-(s__subclass(s__Gold,s__ElementalSubstance))],[-(s__instance(s__Gold__t,s__SetOrClass))],[-(s__names(s__Gold,'Gold'))],[-(s__conventionalShortName('Au',s__Gold))],[-(s__atomicNumber(s__Gold,"79"))],[s__instance(_1917196,s__Object),-(s__measure(_1917196,s__MeasureFn("196.96655",s__Amu))),s__instance(_1917196,s__Gold),s__instance(_1917196,s__Atom)],[-(s__documentation(s__Gold,s__EnglishLanguage,'Gold is gold colored. It is the most malleable and ductile metal known. There is only one stable isotope of gold, and five radioisotopes of gold, Au-195 being the most stable with a half-life of 186 days. Gold is used as a monetary standard, in jewelry, dentistry, electronics. Au-198 is used in treating cancer and some other medical conditions. Gold has been known to exist as far back as 2600 BC. Gold comes from the Anglo-Saxon word gold. Its symbol, Au, comes from the Latin word aurum, which means gold. Gold is not particularly toxic, however it is known to cause damage to the liver and kidneys in some.'))],[-(s__subclass(s__Mercury,s__ElementalSubstance))],[-(s__instance(s__Mercury__t,s__SetOrClass))],[-(s__names(s__Mercury,'Mercury'))],[-(s__conventionalShortName('Hg',s__Mercury))],[-(s__atomicNumber(s__Mercury,"80"))],[s__instance(_1917294,s__Object),-(s__measure(_1917294,s__MeasureFn("200.59",s__Amu))),s__instance(_1917294,s__Mercury),s__instance(_1917294,s__Atom)],[-(s__documentation(s__Mercury,s__EnglishLanguage,'Heavy silvery liquid metallic element, belongs to the zinc group. Used in thermometers, barometers and other scientific apparatus. Less reactive than zinc and cadmium, does not displace hydrogen from acids. Forms a number of complexes and organomercury compounds.'))],[-(s__subclass(s__Thallium,s__ElementalSubstance))],[-(s__instance(s__Thallium__t,s__SetOrClass))],[-(s__names(s__Thallium,'Thallium'))],[-(s__conventionalShortName('Tl',s__Thallium))],[-(s__atomicNumber(s__Thallium,"81"))],[s__instance(_1917392,s__Object),-(s__measure(_1917392,s__MeasureFn("204.3833",s__Amu))),s__instance(_1917392,s__Thallium),s__instance(_1917392,s__Atom)],[-(s__documentation(s__Thallium,s__EnglishLanguage,'Pure, unreacted thallium appears silvery-white and exhibits a metallic lustre. Upon reacting with air, it begins to turn bluish-grey and looks like lead. It is very malleable, and can be cut with a knife. There are two stable isotopes, and four radioisotopes, Tl-204 being the most stable with a half-life of 3.78 years. Thallium sulphate was used as a rodenticide. Thallium sulphines conductivity changes with exposure to infrared light, this gives it a use in infrared detectors. Discovered by Sir William Crookes via spectroscopy. Its name comes from the Greek word thallos, which means green twig. Thallium and its compounds are toxic and can cause cancer.'))],[-(s__subclass(s__Lead,s__ElementalSubstance))],[-(s__instance(s__Lead__t,s__SetOrClass))],[-(s__names(s__Lead,'Lead'))],[-(s__conventionalShortName('Pb',s__Lead))],[-(s__atomicNumber(s__Lead,"82"))],[s__instance(_1917490,s__Object),-(s__measure(_1917490,s__MeasureFn("207.19",s__Amu))),s__instance(_1917490,s__Lead),s__instance(_1917490,s__Atom)],[-(s__documentation(s__Lead,s__EnglishLanguage,'Heavy dull grey ductile metallic element, belongs to group 14. Used in building construction, lead-place accumulators, bullets and shot, and is part of solder, pewter, bearing metals, type metals and fusible alloys.'))],[-(s__subclass(s__Bismuth,s__ElementalSubstance))],[-(s__instance(s__Bismuth__t,s__SetOrClass))],[-(s__names(s__Bismuth,'Bismuth'))],[-(s__conventionalShortName('Bi',s__Bismuth))],[-(s__atomicNumber(s__Bismuth,"83"))],[s__instance(_1917588,s__Object),-(s__measure(_1917588,s__MeasureFn("208.980",s__Amu))),s__instance(_1917588,s__Bismuth),s__instance(_1917588,s__Atom)],[-(s__documentation(s__Bismuth,s__EnglishLanguage,'White crystalline metal with a pink tinge, belongs to group 15. Most diamagnetic of all metals and has the lowest thermal conductivity of all the elements except mercury. Lead-free bismuth compounds are used in cosmetics and medical procedures. Burns in the air and produces a blue flame. In 1753, C.G. Junine first demonstrated that it was different from lead.'))],[-(s__subclass(s__Polonium,s__ElementalSubstance))],[-(s__instance(s__Polonium__t,s__SetOrClass))],[-(s__names(s__Polonium,'Polonium'))],[-(s__conventionalShortName('Po',s__Polonium))],[-(s__atomicNumber(s__Polonium,"84"))],[s__instance(_1917686,s__Object),-(s__measure(_1917686,s__MeasureFn("210",s__Amu))),s__instance(_1917686,s__Polonium),s__instance(_1917686,s__Atom)],[-(s__documentation(s__Polonium,s__EnglishLanguage,'Rare radioactive metallic element, belongs to group 16 of the periodic table. Over 30 known isotopes exist, the most of all elements. Po-209 has a half-life of 103 years. Possible uses in heating spacecraft. Discovered by Marie Curie in 1898 in a sample of pitchblende.'))],[-(s__subclass(s__Astatine,s__ElementalSubstance))],[-(s__instance(s__Astatine__t,s__SetOrClass))],[-(s__names(s__Astatine,'Astatine'))],[-(s__conventionalShortName('At',s__Astatine))],[-(s__atomicNumber(s__Astatine,"85"))],[s__instance(_1917784,s__Object),-(s__measure(_1917784,s__MeasureFn("210",s__Amu))),s__instance(_1917784,s__Astatine),s__instance(_1917784,s__Atom)],[-(s__documentation(s__Astatine,s__EnglishLanguage,'Radioactive halogen element. Occurs naturally from uranium and thorium decay. At least 20 known isotopes. At-210, the most stable, has a half-life of 8.3 hours. Synthesized by nuclear bombardment in 1940 by D.R. Corson, K.R. MacKenzie and E. Segre at the University of California.'))],[-(s__subclass(s__Radon,s__ElementalSubstance))],[-(s__instance(s__Radon__t,s__SetOrClass))],[-(s__names(s__Radon,'Radon'))],[-(s__conventionalShortName('Rn',s__Radon))],[-(s__atomicNumber(s__Radon,"86"))],[s__instance(_1917882,s__Object),-(s__measure(_1917882,s__MeasureFn("222",s__Amu))),s__instance(_1917882,s__Radon),s__instance(_1917882,s__Atom)],[-(s__documentation(s__Radon,s__EnglishLanguage,'Colorless radioactive gaseous element, belongs to the noble gases. Of the twenty known isotopes, the most stable is Rn-222 with a half-life of 3.8 days. Formed by the radioactive decay of {Radium}-226. Radon itself decays into {polonium}. Used in radiotherapy. As a noble gas, it is effectively inert, though radon fluoride has been synthesized. First isolated in 1908 by Ramsey and Gray.'))],[-(s__subclass(s__Francium,s__ElementalSubstance))],[-(s__instance(s__Francium__t,s__SetOrClass))],[-(s__names(s__Francium,'Francium'))
ium__t,s__SetOrClass))],[-(s__names(s__Lawrencium,'Lawrencium'))],[-(s__conventionalShortName('Lr',s__Lawrencium))],[-(s__atomicNumber(s__Lawrencium,"103"))],[s__instance(_1919548,s__Object),-(s__measure(_1919548,s__MeasureFn("262",s__Amu))),s__instance(_1919548,s__Lawrencium),s__instance(_1919548,s__Atom)],[-(s__documentation(s__Lawrencium,s__EnglishLanguage,'Appearance unknown, however it is most likely silvery-white or grey and metallic. Lawrencium is a synthetic rare-earth metal. There are eight known radioisotopes, the most stable being Lr-262 with a half-life of 3.6 hours. Due to the short half-life of lawrencium, and its radioactivity, there are no known uses for it. Identified by Albert Ghiorso in 1961 at Berkeley. It was produced by bombarding californium with boron ions. The name is temporary {IUPAC} nomenclature, the origin of the name comes from Ernest O. Lawrence, the inventor of the cyclotron. If sufficient amounts of lawrencium were produced, it would pose a radiation hazard.'))],[-(s__subclass(s__Unnilquadium,s__ElementalSubstance))],[-(s__instance(s__Unnilquadium__t,s__SetOrClass))],[-(s__names(s__Unnilquadium,'Unnilquadium'))],[-(s__conventionalShortName('Unq',s__Unnilquadium))],[-(s__atomicNumber(s__Unnilquadium,"104"))],[s__instance(_1919646,s__Object),-(s__measure(_1919646,s__MeasureFn("261",s__Amu))),s__instance(_1919646,s__Unnilquadium),s__instance(_1919646,s__Atom)],[-(s__documentation(s__Unnilquadium,s__EnglishLanguage,'Radioactive transactinide element. Expected to have similar chemical properties to those displayed by hafnium. Rf-260 was discovered by the Joint Nuclear Research Institute at Dubna (U.S.S.R.) in 1964. Researchers at Berkeley discovered Unq-257 and Unq-258 in 1964.'))],[-(s__subclass(s__Unnilpentium,s__ElementalSubstance))],[-(s__instance(s__Unnilpentium__t,s__SetOrClass))],[-(s__names(s__Unnilpentium,'Unnilpentium'))],[-(s__conventionalShortName('Unp',s__Unnilpentium))],[-(s__atomicNumber(s__Unnilpentium,"105"))],[s__instanc
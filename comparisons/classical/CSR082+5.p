ss(s__Thorium,s__ElementalSubstance))],[-(s__instance(s__Thorium__t,s__SetOrClass))],[-(s__names(s__Thorium,'Thorium'))],[-(s__conventionalShortName('Th',s__Thorium))],[-(s__atomicNumber(s__Thorium,"90"))],[s__instance(_1918274,s__Object),-(s__measure(_1918274,s__MeasureFn("232.038",s__Amu))),s__instance(_1918274,s__Thorium),s__instance(_1918274,s__Atom)],[-(s__documentation(s__Thorium,s__EnglishLanguage,'Grey radioactive metallic element. Belongs to actinoids. Found in monazite sand in Brazil, India and the US. Thorium-232 has a half-life of 1.39x10^10 years. Can be used as a nuclear fuel for breeder reactors. Thorium-232 captures slow {neutron}s and breeds uranium-233. Discovered by Jons J. Berzelius in 1829.'))],[-(s__subclass(s__Protactinium,s__ElementalSubstance))],[-(s__instance(s__Protactinium__t,s__SetOrClass))],[-(s__names(s__Protactinium,'Protactinium'))],[-(s__conventionalShortName('Pa',s__Protactinium))],[-(s__atomicNumber(s__Protactinium,"91"))],[s__instance(_1918372,s__Object),-(s__measure(_1918372,s__MeasureFn("231",s__Amu))),s__instance(_1918372,s__Protactinium),s__instance(_1918372,s__Atom)],[-(s__documentation(s__Protactinium,s__EnglishLanguage,'Radioactive metallic element, belongs to the actinoids. The most stable isotope, Pa-231 has a half-life of 2.43*10^4 years. At least 10 other radioactive isotopes are known. No practical applications are known. Discovered in 1917 by Lise Meitner and Otto Hahn.'))],[-(s__subclass(s__Uranium,s__ElementalSubstance))],[-(s__instance(s__Uranium__t,s__SetOrClass))],[-(s__names(s__Uranium,'Uranium'))],[-(s__conventionalShortName('U',s__Uranium))],[-(s__atomicNumber(s__Uranium,"92"))],[s__instance(_1918470,s__Object),-(s__measure(_1918470,s__MeasureFn("231",s__Amu))),s__instance(_1918470,s__Uranium),s__instance(_1918470,s__Atom)],[-(s__documentation(s__Uranium,s__EnglishLanguage,'White radioactive metallic element belonging to the actinoids. Three natural isotopes, U-238, U-235 and U-234. Uranium-235 is used as the fuel for nuclear reactors and weapons. Discovered by Martin H. Klaproth in 1789.'))],[-(s__subclass(s__Neptunium,s__ElementalSubstance))],[-(s__instance(s__Neptunium__t,s__SetOrClass))],[-(s__names(s__Neptunium,'Neptunium'))],[-(s__conventionalShortName('Np',s__Neptunium))],[-(s__atomicNumber(s__Neptunium,"93"))],[s__instance(_1918568,s__Object),-(s__measure(_1918568,s__MeasureFn("237",s__Amu))),s__instance(_1918568,s__Neptunium),s__instance(_1918568,s__Atom)],[-(s__documentation(s__Neptunium,s__EnglishLanguage,'Radioactive metallic transuranic element, belongs to the actinoids. Np-237, the most stable isotope, has a half-life of 2.2*10^6 years and is a by product of nuclear reactors. The other known isotopes have mass numbers 229 through 236, and 238 through 241. Np-236 has a half-life of 5*10^3 years. First produced by Edwin M. McMillan and P.H. Abelson in 1940.'))],[-(s__subclass(s__Plutonium,s__ElementalSubstance))],[-(s__instance(s__Plutonium__t,s__SetOrClass))],[-(s__names(s__Plutonium,'Plutonium'))],[-(s__conventionalShortName('Pu',s__Plutonium))],[-(s__atomicNumber(s__Plutonium,"94"))],[s__instance(_1918666,s__Object),-(s__measure(_1918666,s__MeasureFn("242",s__Amu))),s__instance(_1918666,s__Plutonium),s__instance(_1918666,s__Atom)],[-(s__documentation(s__Plutonium,s__EnglishLanguage,'Dense silvery radioactive metallic transuranic element, belongs to the actinoids. Pu-244 is the most stable isotope with a half-life of 7.6*10^7 years. Thirteen isotopes are known. Pu-239 is the most important, it undergoes nuclear fission with slow neutrons and is hence important to nuclear weapons and reactors. Plutonium production is monitored down to the gram to prevent military misuse. First produced by Gleen T. Seaborg, Edwin M. McMillan, J.W. Kennedy and A.C. Wahl in 1940.'))],[-(s__subclass(s__Americium,s__ElementalSubstance))],[-(s__instance(s__Americium__t,s__SetOrClass))],[-(s__names(s__Americium,'Americium'))],[-(s__conventionalShortName('Am',s__Americium))],[-(s__atomicNumber(s__Americium,"95"))],[s__instance(_1918764,s__Object),-(s__measure(_1918764,s__MeasureFn("243",s__Amu))),s__instance(_1918764,s__Americium),s__instance(_1918764,s__Atom)],[-(s__documentation(s__Americium,s__EnglishLanguage,'Radioactive metallic transuranic element, belongs to the actinoids. Ten known isotopes. Am-243 is the most stable isotope, with a half-life of 7.95*10^3 years. Discovered by Glenn T. Seaborg and associates in 1945, it was obtained by bombarding {uranium}-238 with alpha particles.'))],[-(s__subclass(s__Curium,s__ElementalSubstance))],[-(s__instance(s__Curium__t,s__SetOrClass))],[-(s__names(s__Curium,'Curium'))],[-(s__conventionalShortName('Cm',s__Curium))],[-(s__atomicNumber(s__Curium,"96"))],[s__instance(_1918862,s__Object),-(s__measure(_1918862,s__MeasureFn("247",s__Amu))),s__instance(_1918862,s__Curium),s__instance(_1918862,s__Atom)],[-(s__documentation(s__Curium,s__EnglishLanguage,'Radioactive metallic transuranic element. Belongs to actinoid series. Nine known isotopes, Cm-247 has a half-life of 1.64*10^7 years. First identified by Glenn T. Seaborg and associates in 1944, first produced by L.B. Werner and I. Perlman in 1947 by bombarding americium-241 with {neutron}s. Named for Marie Curie.'))],[-(s__subclass(s__Berkelium,s__ElementalSubstance))],[-(s__instance(s__Berkelium__t,s__SetOrClass))],[-(s__names(s__Berkelium,'Berkelium'))],[-(s__conventionalShortName('Bk',s__Berkelium))],[-(s__atomicNumber(s__Berkelium,"97"))],[s__instance(_1918960,s__Object),-(s__measure(_1918960,s__MeasureFn("247",s__Amu))),s__instance(_1918960,s__Berkelium),s__instance(_1918960,s__Atom)],[-(s__documentation(s__Berkelium,s__EnglishLanguage,'Radioactive metallic transuranic element. Belongs to actinoid series. Eight known isotopes, the most common Bk-247, has a half-life of 1.4*10^3 years. First produced by Glenn T. Seaborg and associates in 1949 by bombarding americium-241 with alpha particles.'))],[-(s__subclass(s__Californium,s__ElementalSubstance))],[-(s__instance(s__Californium__t,s__SetOrClass))],[-(s__names(s__Californium,'Californium'))],[-(s__conventionalShortName('Cf',s__Californium))],[-(s__atomicNumber(s__Californium,"98"))],[s__instance(_1919058,s__Object),-(s__measure(_1919058,s__MeasureFn("249",s__Amu))),s__instance(_1919058,s__Californium),s__instance(_1919058,s__Atom)],[-(s__documentation(s__Californium,s__EnglishLanguage,'Radioactive metallic transuranic element. Belongs to actinoid series. Cf-251 has a half life of about 700 years. Nine isotopes are known. Cf-252 is an intense {neutron} source, which makes it an intense {neutron} source and gives it a use in {neutron} activation analysis and a possible use as a radiation source in medicine. First produced by Glenn T. Seaborg and associates in 1950.'))],[-(s__subclass(s__Einsteinium,s__ElementalSubstance))],[-(s__instance(s__Einsteinium__t,s__SetOrClass))],[-(s__names(s__Einsteinium,'Einsteinium'))],[-(s__conventionalShortName('Es',s__Einsteinium))],[-(s__atomicNumber(s__Einsteinium,"99"))],[s__instance(_1919156,s__Object),-(s__measure(_1919156,s__MeasureFn("254",s__Amu))),s__instance(_1919156,s__Einsteinium),s__instance(_1919156,s__Atom)],[-(s__documentation(s__Einsteinium,s__EnglishLanguage,'Appearance is unknown, however it is most probably metallic and silver or gray in color. Radioactive metallic transuranic element belonging to the actinoids. Es-254 has the longest half-life of the eleven known isotopes at 270 days. First identified by Albert Ghiorso and associates in the debris of the 1952 hydrogen bomb explosion. In 1961 the first microgram quantities of Es-232 were separated. While einsteinium never exists naturally, if a sufficient amount was assembled, it would pose a radiation hazard.'))],[-(s__subclass(s__Fermium,s__ElementalSubstance))],[-(s__instance(s__Fermium__t,s__SetOrClass))],[-(s__names(s__Fermium,'Fermium'))],[-(s__conventionalShortName('Fm',s__Fermium))],[-(s__atomicNumber(s__Fermium,"100"))],[s__instance(_1919254,s__Objec
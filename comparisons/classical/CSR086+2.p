nstance(s__Sievert,s__CompositeUnitOfMeasure))],[-(s__instance(s__Sievert,s__SystemeInternationalUnit))],[-(s__documentation(s__Sievert,s__EnglishLanguage,'SI dose equivalent measure. Symbol: Sv. It is a unit of biologic dose of ionizing radiation. The &%Sievert makes it possible to normalize doses of different types of radiation. It takes into account the relative biologic effectiveness of ionizing radiation, since each form of such radiation--e.g., X rays, gamma rays, neutrons-- has a slightly different effect on living tissue for a given absorbed dose. The dose equivalent of a given type of radiation (in &%Sievert) is the dose of the radiation in &%Gray multiplied by a quality factor that is based on the relative biologic effectiveness of the radiation. Accordingly, one &%Sievert is generally defined as the amount of radiation roughly equivalent in biologic effectiveness to one &%Gray of gamma radiation. &%Sievert = J/kg = m^2*s^(-2)'))],[-(s__instance(s__DayDuration,s__UnitOfDuration))],[-(s__documentation(s__DayDuration,s__EnglishLanguage,'Time unit. 1 day = 24 hours.'))],[s__instance(_2450164,s__RealNumber),equal___(_2450164,times("1",_2450164)),-(equal___(s__MeasureFn(_2450164,s__DayDuration),s__MeasureFn(times(_2450164,"24"),s__HourDuration)))],[-(s__instance(s__HourDuration,s__UnitOfDuration))],[-(s__documentation(s__HourDuration,s__EnglishLanguage,'Time unit. 1 hour = 60 minutes.'))],[s__instance(_2450298,s__RealNumber),equal___(_2450298,times("1",_2450298)),-(equal___(s__MeasureFn(_2450298,s__HourDuration),s__MeasureFn(times(_2450298,"60"),s__MinuteDuration)))],[-(s__instance(s__MinuteDuration,s__UnitOfDuration))],[-(s__documentation(s__MinuteDuration,s__EnglishLanguage,'Time unit. 1 minute = 60 seconds. '))],[s__instance(_2450432,s__RealNumber),equal___(_2450432,times("1",_2450432)),-(equal___(s__MeasureFn(_2450432,s__MinuteDuration),s__MeasureFn(times(_2450432,"60"),s__SecondDuration)))],[-(s__instance(s__WeekDuration,s__UnitOfDuration))],[-(s__document
_UnitOfAngularMeasure))],[-(s__instance(s__Radian,s__SystemeInternationalUnit))],[-(s__documentation(s__Radian,s__EnglishLanguage,'SI plane angle measure. Symbol: rad. It is the angle of a circle subtended by an arc equal in length to the circles radius. Another definition is: the plane angle between two radii of a circle which cut off on the circumference an arc equal in length to the radius. &%Radian = m/m = 1.'))],[-(s__instance(s__Steradian,s__UnitOfAngularMeasure))],[-(s__instance(s__Steradian,s__SystemeInternationalUnit))],[-(s__documentation(s__Steradian,s__EnglishLanguage,'SI solid angle measure. Symbol: sr. It is the solid angle of a sphere subtended by a portion of the surface whose area is equal to the square of the spheres radius. Another definition is: the solid angle which, having its vertex in the center of the sphere, cuts off an area of the surface of the sphere equal to that of a square with sides of length equal to the radius of the sphere. &%Steradian = m^2/m^2 = 1.'))],[-(s__subclass(s__FrequencyMeasure,s__TimeDependentQuantity))],[-(s__instance(s__FrequencyMeasure__t,s__SetOrClass))],[-(s__documentation(s__FrequencyMeasure,s__EnglishLanguage,'A &%subclass of &%TimeDependentQuantity, instances of which are measures of the frequency with which some &%Process occurs.'))],[-(s__subclass(s__UnitOfFrequency,s__CompositeUnitOfMeasure))],[-(s__instance(s__UnitOfFrequency__t,s__SetOrClass))],[-(s__documentation(s__UnitOfFrequency,s__EnglishLanguage,'Every instance of this &%Class is a &%UnitOfMeasure that can be used with &%MeasureFn to form instances of &%FrequencyMeasure.'))],[s__instance(_2448100,s__RealNumber),s__instance(_2448104,s__UnitOfMeasure),-(s__instance(_2448102,s__FrequencyMeasure)),equal___(s__MeasureFn(_2448100,_2448104),_2448102),s__instance(_2448104,s__UnitOfFrequency)],[-(s__instance(s__Hertz,s__UnitOfFrequency))],[-(s__instance(s__Hertz,s__SystemeInternationalUnit))],[-(s__documentation(s__Hertz,s__EnglishLanguage,'SI frequency measure. Symbol: Hz. It is the number of cycles per second. &%Hertz = s^(-1). Note that &%Hertz does not have a conversion function.'))],[-(s__instance(s__Newton,s__CompositeUnitOfMeasure))],[-(s__instance(s__Newton,s__SystemeInternationalUnit))],[-(s__documentation(s__Newton,s__EnglishLanguage,'SI force measure. Symbol: N. It is that force which gives to a mass of 1 kilogram an acceleration of 1 &%Meter per &%SecondDuration. &%Newton = m*kg*s^(-2).'))],[-(s__instance(s__Pascal,s__CompositeUnitOfMeasure))],[-(s__instance(s__Pascal,s__SystemeInternationalUnit))],[-(s__documentation(s__Pascal,s__EnglishLanguage,'SI pressure measure. Symbol:Pa. It is the pressure of one &%Newton per square &%Meter. &%Pascal = N/m^2 = m^(-1)*kg*s^(-2).'))],[-(s__instance(s__Joule,s__CompositeUnitOfMeasure))],[-(s__instance(s__Joule,s__SystemeInternationalUnit))],[-(s__documentation(s__Joule,s__EnglishLanguage,'SI energy measure. Symbol: J. It is the work done when the point of application of 1 &%Newton is displaced a distance of 1 &%Meter in the direction of the force. &%Joule = N*m = m^2*kg*s^(-2).'))],[-(s__instance(s__Watt,s__CompositeUnitOfMeasure))],[-(s__instance(s__Watt,s__SystemeInternationalUnit))],[-(s__documentation(s__Watt,s__EnglishLanguage,'SI power measure. Symbol: W. A &%UnitOfMeasure that measures power, i.e. energy produced or expended divided by &%TimeDuration. It is the power which gives rise to the production of energy (or work) at the rate of one &%Joule per &%SecondDuration. &%Watt = J/s = m^2*kg*s^(-3).'))],[-(s__instance(s__Horsepower,s__CompositeUnitOfMeasure))],[-(s__documentation(s__Horsepower,s__EnglishLanguage,'A power measure that is equal to 746 &%Watts.'))],[s__instance(_2448634,s__RealNumber),-(equal___(s__MeasureFn(_2448634,s__Horsepower),s__MeasureFn(times(_2448634,"746"),s__Watt)))],[-(s__instance(s__Coulomb,s__CompositeUnitOfMeasure))],[-(s__instance(s__Coulomb,s__SystemeInternationalUnit))],[-(s__documentation(s__Coulomb,s__EnglishLanguage,'SI electric charge measure. Symbol: C. It is the quantity of electric charge transported through a cross section of a conductor in an electric circuit during each &%SecondDuration by a current of 1 &%Ampere. Coulomb = s*A.'))],[s__instance(_2448774,s__RealNumber),equal___(_2448776,s__MeasureFn(_2448774,s__Coulomb)),-(s__instance(_2448776,s__TimeDependentQuantity))],[-(s__instance(s__Volt,s__CompositeUnitOfMeasure))],[-(s__instance(s__Volt,s__SystemeInternationalUnit))],[-(s__documentation(s__Volt,s__EnglishLanguage,'SI electric potential measure. Symbol: V. It is the difference of electric potential between two points of a conducting wire carrying a constant current of 1 &%Ampere, when the power dissipated between these points is equal to 1 &%Watt. &%Volt = W/A = m^2*kg*s^(-3)*A^(-1).'))],[-(s__instance(s__Farad,s__CompositeUnitOfMeasure))],[-(s__instance(s__Farad,s__SystemeInternationalUnit))],[-(s__documentation(s__Farad,s__EnglishLanguage,'SI capacitance measure. Symbol: F. It is the capacitance of a capacitator between the plates of which there appears a difference of potential of 1 &%Volt when it is charged by a quantity of electricity equal to 1 Coulomb. &%Farad = C/V = m^(-2)*kg(-1)*s^4*A^2.'))],[-(s__instance(s__Ohm,s__CompositeUnitOfMeasure))],[-(s__instance(s__Ohm,s__SystemeInternationalUnit))],[-(s__documentation(s__Ohm,s__EnglishLanguage,'SI electric resistance measure. It is the electric resistance between two points of a conductor when a constant difference of potential of 1 &%Volt, applied between these two points, produces in this conductor a current of 1 &%Ampere, this conductor not being the force of any electromotive force. &%Ohm = V/A = m^2*kg*s^(-3)*A^(-2).'))],[-(s__instance(s__Siemens,s__CompositeUnitOfMeasure))],[-(s__instance(s__Siemens,s__SystemeInternationalUnit))],[-(s__documentation(s__Siemens,s__EnglishLanguage,'SI electric conductance measure. Symbol: S. In the case of direct current, the conductance in &%Siemens is the reciprocal of the resistance in &%Ohms, in the case of alternating current, it is the reciprocal of the impedance in ohms. siemens = A/V = m^(-2)*kg(-1)*s^(3)*A^2.'))],[-(s__instance(s__Weber,s__CompositeUnitOfMeasure))],[-(s__instance(s__Weber,s__SystemeInternationalUnit))],[-(s__documentation(s__Weber,s__EnglishLanguage,'SI magnetic flux measure. Symbol: Wb. It is the magnetic flux which, linking a circuit of one turn, produces in it an electromotive force of 1 &%Volt as it is reduced to zero at a uniform rate in 1 &%SecondDuration. &%Weber = V*s = m^2*kg*s^(-2)*A^(-1).'))],[-(s__instance(s__Tesla,s__CompositeUnitOfMeasure))],[-(s__instance(s__Tesla,s__SystemeInternationalUnit))],[-(s__documentation(s__Tesla,s__EnglishLanguage,'SI magnetic flux density measure. Symbol: T. One &%Tesla equals one &%Weber per square &%Meter. &%Tesla = Wb/m^2 = kg*s^(-2)*A^(-1).'))],[-(s__instance(s__Henry,s__CompositeUnitOfMeasure))],[-(s__instance(s__Henry,s__SystemeInternationalUnit))],[-(s__documentation(s__Henry,s__EnglishLanguage,'SI inductance measure. Symbol: H. One &%Henry is equivalent to one &%Volt divided by one &%Ampere per &%SecondDuration. If a current changing at the rate of one &%Ampere per &%SecondDuration induces an electromotive force of one &%Volt, the circuit has an inductance of one &%Henry. &%Henry = Wb/A = m^2*kg*s^(-2)*A^(-2).'))],[-(s__subclass(s__CelsiusDegree,s__UnitOfTemperature))],[-(s__instance(s__CelsiusDegree__t,s__SetOrClass))],[-(s__instance(s__UnitOfTemperature__t,s__SetOrClass))],[-(s__instance(s__CelsiusDegree,s__SystemeInternationalUnit))],[-(s__documentation(s__CelsiusDegree,s__EnglishLanguage,'A &%TemperatureMeasure. The freezing point and the boiling point of water are, respectively, 0 &%CelsiusDegrees and 100 &%CelsiusDegrees.'))],[s__instance(_2449492,s__RealNumber),equal___(_2449492,times("1",_2449492)),-(equal___(s__MeasureFn(_2449492,s__CelsiusDegree),s__MeasureFn(minus(_2449492,"273.15"),s__KelvinDegree)))],[s__instance(_2449576,s__RealNumber),equal___(_2449576,t
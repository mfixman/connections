,[-(s__documentation(s__Oxygen,s__EnglishLanguage,'A colourless, odourless gaseous element belonging to group 16 of the periodic table. It is the most abundant element present in the earths crust. It also makes up 20.8 percent of the Earths atmosphere. For industrial purposes, it is separated from liquid air by fractional distillation. It is used in high temperature welding, and in breathing. It commonly comes in the form of Oxygen, but is found as Ozone in the upper atmosphere. It was discovered by Priestley in 1774.'))],[-(s__subclass(s__Fluorine,s__ElementalSubstance))],[-(s__instance(s__Fluorine__t,s__SetOrClass))],[-(s__names(s__Fluorine,'Fluorine'))],[-(s__conventionalShortName('F',s__Fluorine))],[-(s__atomicNumber(s__Fluorine,"9"))],[s__instance(_3619192,s__Object),-(s__measure(_3619192,s__MeasureFn("18.9984",s__Amu))),s__instance(_3619192,s__Fluorine),s__instance(_3619192,s__Atom)],[-(s__documentation(s__Fluorine,s__EnglishLanguage,'A poisonous pale yellow gaseous element belonging to group 17 of the periodic table (The halogens). It is the most chemically reactive and electronegative element. It is highly dangerous, causing severe chemical burns on contact with flesh. Fluorine was identified by Scheele in 1771 and first isolated by Moissan in 1886.'))],[-(s__subclass(s__Neon,s__ElementalSubstance))],[-(s__instance(s__Neon__t,s__SetOrClass))],[-(s__names(s__Neon,'Neon'))],[-(s__conventionalShortName('Ne',s__Neon))],[-(s__atomicNumber(s__Neon,"10"))],[s__instance(_3620908,s__Object),-(s__measure(_3620908,s__MeasureFn("20.183",s__Amu))),s__instance(_3620908,s__Neon),s__instance(_3620908,s__Atom)],[-(s__documentation(s__Neon,s__EnglishLanguage,'Colourless gaseous element of group 18 on the periodic table (noble gases). Neon occurs in the atmosphere, and comprises 0.0018 percent of the volume of the atmosphere. It has a distinct reddish glow when used in discharge tubes and neon based lamps. It forms almost no chemical compounds. Neon was discovered in 1898 by Sir William Ramsey and M.W. Travers. '))],[-(s__subclass(s__Sodium,s__ElementalSubstance))],[-(s__instance(s__Sodium__t,s__SetOrClass))],[-(s__names(s__Sodium,'Sodium'))],[-(s__conventionalShortName('Na',s__Sodium))],[-(s__atomicNumber(s__Sodium,"11"))],[s__instance(_3622624,s__Object),-(s__measure(_3622624,s__MeasureFn("22.9898",s__Amu))),s__instance(_3622624,s__Sodium),s__instance(_3622624,s__Atom)],[-(s__documentation(s__Sodium,s__EnglishLanguage,'Soft silvery reactive element belonging to group 1 of the periodic table (alkali metals). It is highly reactive, oxidizing in air and reacting violently with water, forcing it to be kept under oil. It was first isolated by Humphrey Davy in 1807.'))],[-(s__subclass(s__Magnesium,s__ElementalSubstance))],[-(s__instance(s__Magnesium__t,s__SetOrClass))],[-(s__names(s__Magnesium,'Magnesium'))],[-(s__conventionalShortName('Mg',s__Magnesium))],[-(s__atomicNumber(s__Magnesium,"12"))],[s__instance(_3624340,s__Object),-(s__measure(_3624340,s__MeasureFn("24.312",s__Amu))),s__instance(_3624340,s__Magnesium),s__instance(_3624340,s__Atom)],[-(s__documentation(s__Magnesium,s__EnglishLanguage,'Silvery metallic element belonging to group 2 of the periodic table (alkaline-earth metals). It is essential for living organisms, and is used in a number of light alloys. Chemically very reactive, it forms a protective oxide coating when exposed to air and burns with an intense white flame. It also reacts with sulphur, nitrogen and the halogens. First isolated by Bussy in 1828.'))],[-(s__subclass(s__Aluminum,s__ElementalSubstance))],[-(s__instance(s__Aluminum__t,s__SetOrClass))],[-(s__names(s__Aluminum,'Aluminum'))],[-(s__conventionalShortName('Al',s__Aluminum))],[-(s__atomicNumber(s__Aluminum,"13"))],[s__instance(_3626056,s__Object),-(s__measure(_3626056,s__MeasureFn("26.9815",s__Amu))),s__instance(_3626056,s__Aluminum),s__instance(_3626056,s__Atom)],[-(s__documentation(s__Aluminum,s__EnglishLanguage,'Silvery-white lustrous metallic element of group 3 of the periodic table. Highly reactive but protected by a thin transparent layer of the oxide which quickly forms in air. There are many alloys of aluminum, as well as a good number of industrial uses. Makes up 8.1 percent of the Earths crust, by weight. Isolated in 1825 by H.C. Oersted.'))],[-(s__subclass(s__Silicon,s__ElementalSubstance))],[-(s__instance(s__Silicon__t,s__SetOrClass))],[-(s__names(s__Silicon,'Silicon'))],[-(s__conventionalShortName('Si',s__Silicon))],[-(s__atomicNumber(s__Silicon,"14"))],[s__instance(_3627772,s__Object),-(s__measure(_3627772,s__MeasureFn("28.086",s__Amu))),s__instance(_3627772,s__Silicon),s__instance(_3627772,s__Atom)],[-(s__documentation(s__Silicon,s__EnglishLanguage,'Metalloid element belonging to group 14 of the periodic table. It is the second most abundant element in the Earths crust, making up 25.7 percent of it by weight. Chemically less reactive than carbon. First identified by Lavoisier in 1787 and first isolated in 1823 by Berzelius.'))],[-(s__subclass(s__Phosphorus,s__ElementalSubstance))],[-(s__instance(s__Phosphorus__t,s__SetOrClass))],[-(s__names(s__Phosphorus,'Phosphorus'))],[-(s__conventionalShortName('P',s__Phosphorus))],[-(s__atomicNumber(s__Phosphorus,"15"))],[s__instance(_3629488,s__Object),-(s__measure(_3629488,s__MeasureFn("30.9738",s__Amu))),s__instance(_3629488,s__Phosphorus),s__instance(_3629488,s__Atom)],[-(s__documentation(s__Phosphorus,s__EnglishLanguage,'Non-metallic element belonging to group 15 of the periodic table. Has a multiple allotropic forms. Essential element for living organisms. It was discovered by Brandt in 1669.'))],[-(s__subclass(s__Sulphur,s__ElementalSubstance))],[-(s__instance(s__Sulphur__t,s__SetOrClass))],[-(s__names(s__Sulphur,'Sulphur'))],[-(s__conventionalShortName('S',s__Sulphur))],[-(s__atomicNumber(s__Sulphur,"16"))],[s__instance(_3631204,s__Object),-(s__measure(_3631204,s__MeasureFn("32.064",s__Amu))),s__instance(_3631204,s__Sulphur),s__instance(_3631204,s__Atom)],[-(s__documentation(s__Sulphur,s__EnglishLanguage,'Yellow, nonmetallic element belonging to group 16 of the periodic table. It is an essential element in living organisms, needed in the amino acids cysteine and methionine, and hence in many proteins. Absorbed by plants from the soil as sulphate ion.'))],[-(s__subclass(s__Chlorine,s__ElementalSubstance))],[-(s__instance(s__Chlorine__t,s__SetOrClass))],[-(s__names(s__Chlorine,'Chlorine'))],[-(s__conventionalShortName('Cl',s__Chlorine))],[-(s__atomicNumber(s__Chlorine,"17"))],[s__instance(_3632920,s__Object),-(s__measure(_3632920,s__MeasureFn("35.453",s__Amu))),s__instance(_3632920,s__Chlorine),s__instance(_3632920,s__Atom)],[-(s__documentation(s__Chlorine,s__EnglishLanguage,'Halogen element. Poisonous greenish-yellow gas. Occurs widely in nature as sodium chloride in seawater. Reacts directly with many elements and compounds, strong oxidizing agent. Discovered by Karl Scheele in 1774. Humphrey David confirmed it as an element in 1810.'))],[-(s__subclass(s__Argon,s__ElementalSubstance))],[-(s__instance(s__Argon__t,s__SetOrClass))],[-(s__names(s__Argon,'Argon'))],[-(s__conventionalShortName('Ar',s__Argon))],[-(s__atomicNumber(s__Argon,"18"))],[s__instance(_3634636,s__Object),-(s__measure(_3634636,s__MeasureFn("39.948",s__Amu))),s__instance(_3634636,s__Argon),s__instance(_3634636,s__Atom)],[-(s__documentation(s__Argon,s__EnglishLanguage,'Monatomic noble gas. Makes up 0.93 percent of the air. Colourless, odorless. Is inert and has no true compounds. Lord Rayleigh and Sir william Ramsey identified argon in 1894.'))],[-(s__subclass(s__Potassium,s__ElementalSubstance))],[-(s__instance(s__Potassium__t,s__SetOrClass))],[-(s__names(s__Potassium,'Potassium'))],[-(s__conventionalShortName('K',s__Potassium))],[-(s__atomicNumber(s__Potassium,"19"))],[s__instance(_3636352,s__Object),-(s__measure(_3636352,s__MeasureFn("39.0983",s__Amu))),s__instance(_3636352,s__Potassium),s__instance(_3636352,s__Atom)],[-(s__documentation(s__Potassium,s__EnglishLanguage,'Soft silvery metallic element belonging to group 1 of the periodic table (alkali metals). Occurs naturally in seawater and a many minerals. Highly reactive, chemically, it resembles sodium in its behavior and compounds. Discovered by Sir Humphry Davy in 1807.'))],[-(s__subclass(s__Calcium,s__ElementalSubstance))],[-(s__instance(s__Calcium__t,s__SetOrClass))],[-(s__names(s__Calcium,'Calcium'))],[-(s__conventionalShortName('Ca',s__Calcium))],[-(s__atomicNumber(s__Calcium,"20"))],[s__instance(_3638068,s__Object),-(s__measure(_3638068,s__MeasureFn("40.08",s__Amu))),s__instance(_3638068,s__Calcium),s__instance(_3638068,s__Atom)],[-(s__documentation(s__Calcium,s__EnglishLanguage,'Soft grey metallic element belonging to group 2 of the periodic table. Used a reducing agent in the extraction of thorium, zirconium and uranium. Essential element for living organisms.'))],[-(s__subclass(s__Scandium,s__ElementalSubstance))],[-(s__instance(s__Scandium__t,s__SetOrClass))],[-(s__names(s__Scandium,'Scandium'))],[-(s__conventionalShortName('Sc',s__Scandium))],[-(s__atomicNumber(s__Scandium,"21"))],[s__instance(_3639784,s__Object),-(s__measure(_3639784,s__MeasureFn("44.956",s__Amu))),s__instance(_3639784,s__Scandium),s__instance(_3639784,s__Atom)],[-(s__documentation(s__Scandium,s__EnglishLanguage,'Rare soft silvery metallic element belonging to group 3 of the periodic table. There are ten isotopes, nine of which are radioactive and have short half-lives. Predicted in 1869 by Mendeleev, isolated by Nilson in 1879.'))],[-(s__subclass(s__Titanium,s__ElementalSubstance))],[-(s__instance(s__Titanium__t,s__SetOrClass))],[-(s__names(s__Titanium,'Titanium'))],[-(s__conventionalShortName('Ti',s__Titanium))],[-(s__atomicNumber(s__Titanium,"22"))],[s__instance(_3641500,s__Object),-(s__measure(_3641500,s__MeasureFn("47.90",s__Amu))),s__instance(_3641500,s__Titanium),s__instance(_3641500,s__Atom)],[-(s__documentation(s__Titanium,s__EnglishLanguage,'White metallic transition element. Occurs in numerous minerals. Used in strong, light corrosion-resistant alloys. Forms a passive oxide coating when exposed to air. First discovered by Gregor in 1789.'))],[-(s__subclass(s__Vanadium,s__ElementalSubstance))],[-(s__instance(s__Vanadium__t,s__SetOrClass))],[-(s__names(s__Vanadium,'Vanadium'))],[-(s__conventionalShortName('V',s__Vanadium))],[-(s__atomicNumber(s__Vanadium,"23"))],[s__instance(_3643216,s__Object),-(s__measure(_3643216,s__MeasureFn("50.9415",s__Amu))),s__instance(_3643216,s__Vanadium),s__instance(_3643216,s__Atom)],[-(s__documentation(s__Vanadium,s__EnglishLanguage,'Soft and ductile, bright white metal. Good resistance to corrosion by alkalis, sulphuric and hydrochloric acid. It oxidizes readily about 933K. There are two naturally occurring isotopes of vanadium, and 5 radioisotopes, V-49 having the longest half-life at 337 days. Vanadium has nuclear applications, the foil is used in cladding titanium to steel, and vanadium-gallium tape is used to produce a superconductive magnet. Originally discovered by Andres Manuel del Rio of Mexico City in 1801. His discovery went unheeded, however, and in 1820, Nils Gabriel Sefstron of Sweden rediscovered it. Metallic vanadium was isolated by Henry Enfield Roscoe in 1867. The name vanadium comes from {Vanadis}, a goddess of Scandinavian mythology. Silvery-white metallic transition element. Vanadium is essential to {ascidian}s. Rats and chickens are also known to require it. Metal powder is a fire hazard, and vanadium compounds should be considered highly toxic. May cause lung cancer if inhaled.'))],[-(s__subclass(s__Chromium,s__ElementalSubstance))],[-(s__instance(s__Chromium__t,s__SetOrClass))],[-(s__names(s__Chromium,'Chromium'))],[-(s__conventionalShortName('Cr',s__Chromium))],[-(s__atomicNumber(s__Chromium,"24"))],[s__instance(_3644932,s__Object),-(s__measure(_3644932,s__MeasureFn("51.996",s__Amu))),s__instance(_3644932,s__Chromium),s__instance(_3644932,s__Atom)],[-(s__documentation(s__Chromium,s__EnglishLanguage,'Hard silvery transition element. Used in decorative electroplating. Discovered in 1797 by Vauquelin.'))],[-(s__subclass(s__Manganese,s__ElementalSubstance))],[-(s__instance(s__Manganese__t,s__SetOrClass))],[-(s__names(s__Manganese,'Manganese'))],[-(s__conventionalShortName('Mn',s__Manganese))],[-(s__atomicNumber(s__Manganese,"25"))],[s__instance(_3646648,s__Object),-(s__measure(_3646648,s__MeasureFn("54.938",s__Amu))),s__instance(_3646648,s__Manganese),s__instance(_3646648,s__Atom)],[-(s__documentation(s__Manganese,s__EnglishLanguage,'Grey brittle metallic transition element. Rather electropositive, combines with some non-metals when heated. Discovered in 1774 by Scheele.'))],[-(s__subclass(s__Iron,s__ElementalSubstance))],[-(s__instance(s__Iron__t,s__SetOrClass))],[-(s__names(s__Iron,'Iron'))],[-(s__conventionalShortName('Fe',s__Iron))],[-(s__atomicNumber(s__Iron,"26"))],[s__instance(_3648364,s__Object),-(s__measure(_3648364,s__MeasureFn("55.847",s__Amu))),s__instance(_3648364,s__Iron),s__instance(_3648364,s__Atom)],[-(s__documentation(s__Iron,s__EnglishLanguage,'Silvery malleable and ductile metallic transition element. Has nine isotopes and is the fourth most abundant element in the earths crust. Required by living organisms as a trace element (used in hemoglobin in humans.) Quite reactive, oxidizes in moist air, displaces hydrogen from dilute acids and combines with nonmetallic elements.'))],[-(s__subclass(s__Cobalt,s__ElementalSubstance))],[-(s__instance(s__Cobalt__t,s__SetOrClass))],[-(s__names(s__Cobalt,'Cobalt'))],[-(s__conventionalShortName('Co',s__Cobalt))],[-(s__atomicNumber(s__Cobalt,"27"))],[s__instance(_3650080,s__Object),-(s__measure(_3650080,s__MeasureFn("58.993",s__Amu))),s__instance(_3650080,s__Cobalt),s__instance(_3650080,s__Atom)],[-(s__documentation(s__Cobalt,s__EnglishLanguage,'Light grey transition element. Some meteorites contain small amounts of metallic cobalt. Generally alloyed for use. Mammals require small amounts of cobalt salts. Cobalt-60, an artificially produced radioactive isotope of Cobalt is an important radioactive tracer and cancer-treatment agent. Discovered by G. Brandt in 1737.'))],[-(s__subclass(s__Nickel,s__ElementalSubstance))],[-(s__instance(s__Nickel__t,s__SetOrClass))],[-(s__names(s__Nickel,'Nickel'))],[-(s__conventionalShortName('Ni',s__Nickel))],[-(s__atomicNumber(s__Nickel,"28"))],[s__instance(_3651796,s__Object),-(s__measure(_3651796,s__MeasureFn("58.71",s__Amu))),s__instance(_3651796,s__Nickel),s__instance(_3651796,s__Atom)],[-(s__documentation(s__Nickel,s__EnglishLanguage,'Malleable ductile silvery metallic transition element. Discovered by A.F. Cronstedt in 1751.'))],[-(s__subclass(s__Copper,s__ElementalSubstance))],[-(s__instance(s__Copper__t,s__SetOrClass))],[-(s__names(s__Copper,'Copper'))],[-(s__conventionalShortName('Cu',s__Copper))],[-(s__atomicNumber(s__Copper,"29"))],[s__instance(_3653512,s__Object),-(s__measure(_3653512,s__MeasureFn("63.54",s__Amu))),s__instance(_3653512,s__Copper),s__instance(_3653512,s__Atom)],[-(s__documentation(s__Copper,s__EnglishLanguage,'Red-brown transition element. Known by the Romans as cuprum. Extracted and used for thousands of years. Malleable, ductile and an excellent conductor of heat and electricity. When in moist conditions, a greenish layer forms on the outside.'))],[-(s__subclass(s__Zinc,s__ElementalSubstance))],[-(s__instance(s__Zinc__t,s__SetOrClass))],[-(s__names(s__Zinc,'Zinc'))],[-(s__conventionalShortName('Zn',s__Zinc))],[-(s__atomicNumber(s__Zinc,"30"))],[s__instance(_3655228,s__Object),-(s__measure(_3655228,s__MeasureFn("65.38",s__Amu))),s__instance(_3655228,s__Zinc),s__instance(_3655228,s__Atom)],[-(s__documentation(s__Zinc,s__EnglishLanguage,'Blue-white metallic element. Occurs in multiple compounds naturally. Five stable isotopes are six radioactive isotopes have been found. Chemically a reactive metal, combines with oxygen and other non-metals, reacts with dilute acids to release hydrogen.'))],[-(s__subclass(s__Gallium,s__ElementalSubstance))],[-(s__instance(s__Gallium__t,s__SetOrClass))],[-(s__names(s__Gallium,'Gallium'))],[-(s__conventionalShortName('Ga',s__Gallium))],[-(s__atomicNumber(s__Gallium,"31"))],[s__instance(_3656944,s__Object),-(s__measure(_3656944,s__MeasureFn("69.72",s__Amu))),s__instance(_3656944,s__Gallium),s__instance(_3656944,s__Atom)],[-(s__documentation(s__Gallium,s__EnglishLanguage,'Soft silvery metallic element, belongs to group 13 of the periodic table. The two stable isotopes are Ga-69 and Ga-71. Eight radioactive isotopes are known, all having short half-lives. Gallium Arsenide is used as a semiconductor. Corrodes most other metals by diffusing into their lattice. First identified by Francois Lecoq de Boisbaudran in 1875.'))],[-(s__subclass(s__Germanium,s__ElementalSubstance))],[-(s__instance(s__Germanium__t,s__SetOrClass))],[-(s__names(s__Germanium,'Germanium'))],[-(s__conventionalShortName('Ge',s__Germanium))],[-(s__atomicNumber(s__Germanium,"32"))],[s__instance(_3658660,s__Object),-(s__measure(_3658660,s__MeasureFn("72.59",s__Amu))),s__instance(_3658660,s__Germanium),s__instance(_3658660,s__Atom)],[-(s__documentation(s__Germanium,s__EnglishLanguage,'Lustrous hard metalloid element, belongs to group 14 of the periodic table. Forms a large number of organometallic compounds. Predicted by Mendeleev in 1871, it was actually found in 1886 by Winkler.'))],[-(s__subclass(s__Arsenic,s__ElementalSubstance))],[-(s__instance(s__Arsenic__t,s__SetOrClass))],[-(s__names(s__Arsenic,'Arsenic'))],[-(s__conventionalShortName('As',s__Arsenic))],[-(s__atomicNumber(s__Arsenic,"33"))],[s__instance(_3660376,s__Object),-(s__measure(_3660376,s__MeasureFn("74.922",s__Amu))),s__instance(_3660376,s__Arsenic),s__instance(_3660376,s__Atom)],[-(s__documentation(s__Arsenic,s__EnglishLanguage,'Metalloid element of group 15. There are three allotropes, yellow, black, and grey. Reacts with halogens, concentrated oxidizing acids and hot alkalis. Albertus Magnus is believed to have been the first to isolate the element in 1250.'))],[-(s__subclass(s__Selenium,s__ElementalSubstance))],[-(s__instance(s__Selenium__t,s__SetOrClass))],[-(s__names(s__Selenium,'Selenium'))],[-(s__conventionalShortName('Se',s__Selenium))],[-(s__atomicNumber(s__Selenium,"34"))],[s__instance(_3662092,s__Object),-(s__measure(_3662092,s__MeasureFn("78.96",s__Amu))),s__instance(_3662092,s__Selenium),s__instance(_3662092,s__Atom)],[-(s__documentation(s__Selenium,s__EnglishLanguage,'Metalloid element, belongs to group 16 of the periodic table. Multiple allotropic forms exist. Chemically resembles sulphur. Discovered in 1817 by Jons J. Berzelius.'))],[-(s__subclass(s__Bromine,s__ElementalSubstance))],[-(s__instance(s__Bromine__t,s__SetOrClass))],[-(s__names(s__Bromine,'Bromine'))],[-(s__conventionalShortName('Br',s__Bromine))],[-(s__atomicNumber(s__Bromine,"35"))],[s__instance(_3663808,s__Object),-(s__measure(_3663808,s__MeasureFn("79.909",s__Amu))),s__instance(_3663808,s__Bromine),s__instance(_3663808,s__Atom)],[-(s__documentation(s__Bromine,s__EnglishLanguage,'Halogen element. Red volatile liquid at room temperature. Its reactivity is somewhere between chlorine and iodine. Harmful to human tissue in a liquid state, the vapour irritates eyes and throat. Discovered in 1826 by Antoine Balard.'))],[-(s__subclass(s__Krypton,s__ElementalSubstance))],[-(s__instance(s__Krypton__t,s__SetOrClass))],[-(s__names(s__Krypton,'Krypton'))],[-(s__conventionalShortName('Kr',s__Krypton))],[-(s__atomicNumber(s__Krypton,"36"))],[s__instance(_3665524,s__Object),-(s__measure(_3665524,s__MeasureFn("83.80",s__Amu))),s__instance(_3665524,s__Krypton),s__instance(_3665524,s__Atom)],[-(s__documentation(s__Krypton,s__EnglishLanguage,'Colorless gaseous element, belongs to the noble gases. Occurs in the air, 0.0001 percent by volume. It can be extracted from liquid air by fractional distillation. Generally not isolated, but used with other inert gases in fluorescent lamps. Five natural isotopes, and five radioactive isotopes. Kr-85, the most stable radioactive isotope, has a half-life of 10.76 years and is produced in fission reactors. Practically inert, though known to form compounds with {fluorine}.'))],[-(s__subclass(s__Rubidium,s__ElementalSubstance))],[-(s__instance(s__Rubidium__t,s__SetOrClass))],[-(s__names(s__Rubidium,'Rubidium'))],[-(s__conventionalShortName('Rb',s__Rubidium))],[-(s__atomicNumber(s__Rubidium,"37"))],[s__instance(_3667240,s__Object),-(s__measure(_3667240,s__MeasureFn("85.47",s__Amu))),s__instance(_3667240,s__Rubidium),s__instance(_3667240,s__Atom)],[-(s__documentation(s__Rubidium,s__EnglishLanguage,'Soft silvery metallic element, belongs to group 1 of the periodic table. Rb-97, the naturally occurring isotope, is radioactive. It is highly reactive, with properties similar to other elements in group 1, like igniting spontaneously in air. Discovered spectroscopically in 1861 by W. Bunsen and G.R. Kirchoff.'))],[-(s__subclass(s__Strontium,s__ElementalSubstance))],[-(s__instance(s__Strontium__t,s__SetOrClass))],[-(s__names(s__Strontium,'Strontium'))],[-(s__conventionalShortName('Sr',s__Strontium))],[-(s__atomicNumber(s__Strontium,"38"))],[s__instance(_3668956,s__Object),-(s__measure(_3668956,s__MeasureFn("87.62",s__Amu))),s__instance(_3668956,s__Strontium),s__instance(_3668956,s__Atom)],[-(s__documentation(s__Strontium,s__EnglishLanguage,'Soft yellowish metallic element, belongs to group 2 of the periodic table. Highly reactive chemically. Sr-90 is present in radioactive fallout and has a half-life of 28 years. Discovered in 1798 by Klaproth and Hope, isolated in 1808 by Humphry Davy.'))],[-(s__subclass(s__Yttrium,s__ElementalSubstance))],[-(s__instance(s__Yttrium__t,s__SetOrClass))],[-(s__names(s__Yttrium,'Yttrium'))],[-(s__conventionalShortName('Y',s__Yttrium))],[-(s__atomicNumber(s__Yttrium,"39"))],[s__instance(_3670672,s__Object),-(s__measure(_3670672,s__MeasureFn("88.905",s__Amu))),s__instance(_3670672,s__Yttrium),s__instance(_3670672,s__Atom)],[-(s__documentation(s__Yttrium,s__EnglishLanguage,'Silvery-grey metallic element of group 3 on the periodic table. Found in uranium ores. The only natural isotope is Y-89, there are 14 other artificial isotopes. Chemically resembles the lanthanoids. Stable in the air below 400 degrees, celsius. Discovered in 1828 by Friedrich Wohler.'))],[-(s__subclass(s__Zirconium,s__ElementalSubstance))],[-(s__instance(s__Zirconium__t,s__SetOrClass))],[-(s__names(s__Zirconium,'Zirconium'))],[-(s__conventionalShortName('Zr',s__Zirconium))],[-(s__atomicNumber(s__Zirconium,"40"))],[s__instance(_3672388,s__Object),-(s__measure(_3672388,s__MeasureFn("91.22",s__Amu))),s__instance(_3672388,s__Zirconium),s__instance(_3672388,s__Atom)],[-(s__documentation(s__Zirconium,s__EnglishLanguage,'Grey-white metallic transition element. Five natural isotopes and six radioactive isotopes are known. Used in nuclear reactors for a {neutron} absorber. Discovered in 1789 by Martin Klaproth, isolated in 1824 by Berzelius.'))],[-(s__subclass(s__Niobium,s__ElementalSubstance))],[-(s__instance(s__Niobium__t,s__SetOrClass))],[-(s__names(s__Niobium,'Niobium'))],[-(s__conventionalShortName('Nb',s__Niobium))],[-(s__atomicNumber(s__Niobium,"41"))],[s__instance(_3674104,s__Object),-(s__measure(_3674104,s__MeasureFn("92.906",s__Amu))),s__instance(_3674104,s__Niobium),s__instance(_3674104,s__Atom)],[-(s__documentation(s__Niobium,s__EnglishLanguage,'Soft, ductile grey-blue metallic transition element. Used in special steels and in welded joints to increase strength. Combines with halogens and oxidizes in air at 200 degrees celsius. Discovered by Charles Hatchett in 1801 and isolated by Blomstrand in 1864. Called {columbium} originally.'))],[-(s__subclass(s__Molybdenum,s__ElementalSubstance))],[-(s__instance(s__Molybdenum__t,s__SetOrClass))],[-(s__names(s__Molybdenum,'Molybdenum'))],[-(s__conventionalShortName('Mo',s__Molybdenum))],[-(s__atomicNumber(s__Molybdenum,"42"))],[s__instance(_3675820,s__Object),-(s__measure(_3675820,s__MeasureFn("95.94",s__Amu))),s__instance(_3675820,s__Molybdenum),s__instance(_3675820,s__Atom)],[-(s__documentation(s__Molybdenum,s__EnglishLanguage,'Silvery-white, hard metallic transition element. It is chemically unreactive and is not affected by most acids. It oxidizes at high temperatures. There are seven natural isotopes, and four radioisotopes, Mo-93 being the most stable with a half-life of 3500 years. Molybdenum is used in almost all high-strength steels, it has nuclear applications, and is a catalyst in petroleum refining. Discovered in 1778 by Carl Welhelm Scheele of Sweden. Impure metal was prepared in 1782 by Peter Jacob Hjelm. The name comes from the Greek word molybdos which means lead. Trace amounts of molybdenum are required for all known forms of life. All molybdenum compounds should be considered highly toxic, and will also cause severe birth defects.'))],[-(s__subclass(s__Technetium,s__ElementalSubstance))],[-(s__instance(s__Technetium__t,s__SetOrClass))],[-(s__names(s__Technetium,'Technetium'))],[-(s__conventionalShortName('Tc',s__Technetium))],[-(s__atomicNumber(s__Technetium,"43"))],[s__instance(_3677536,s__Object),-(s__measure(_3677536,s__MeasureFn("98",s__Amu))),s__instance(_3677536,s__Technetium),s__instance(_3677536,s__Atom)],[-(s__documentation(s__Technetium,s__EnglishLanguage,'Radioactive metallic transition element. Can be detected in some stars and the fission products of uranium. First made by Perrier and Segre by bombarding molybdenum with deutrons, giving them Tc-97. Tc-99 is the most stable isotope with a half-life of 2.6*10^6 years. Sixteen isotopes are known. Organic technetium compounds are used in bone imaging. Chemical properties are intermediate between rhenium and manganese.'))],[-(s__subclass(s__Ruthenium,s__ElementalSubstance))],[-(s__instance(s__Ruthenium__t,s__SetOrClass))],[-(s__names(s__Ruthenium,'Ruthenium'))],[-(s__conventionalShortName('Ru',s__Ruthenium))],[-(s__atomicNumber(s__Ruthenium,"44"))],[s__instance(_3679252,s__Object),-(s__measure(_3679252,s__MeasureFn("101.07",s__Amu))),s__instance(_3679252,s__Ruthenium),s__instance(_3679252,s__Atom)],[-(s__documentation(s__Ruthenium,s__EnglishLanguage,'Hard white metallic transition element. Found with platinum, used as a catalyst in some platinum alloys. Dissolves in fused alkalis, and is not attacked by acids. Reacts with halogens and oxygen at high temperatures. Isolated in 1844 by K.K. Klaus.'))],[-(s__subclass(s__Rhodium,s__ElementalSubstance))],[-(s__instance(s__Rhodium__t,s__SetOrClass))],[-(s__names(s__Rhodium,'Rhodium'))],[-(s__conventionalShortName('Rh',s__Rhodium))],[-(s__atomicNumber(s__Rhodium,"45"))],[s__instance(_3680968,s__Object),-(s__measure(_3680968,s__MeasureFn("102.905",s__Amu))),s__instance(_3680968,s__Rhodium),s__instance(_3680968,s__Atom)],[-(s__documentation(s__Rhodium,s__EnglishLanguage,'Silvery white metallic transition element. Found with platinum and used in some platinum alloys. Not attacked by acids, dissolves only in aqua regia. Discovered in 1803 by W.H. Wollaston.'))],[-(s__subclass(s__Palladium,s__ElementalSubstance))],[-(s__instance(s__Palladium__t,s__SetOrClass))],[-(s__names(s__Palladium,'Palladium'))],[-(s__conventionalShortName('Pd',s__Palladium))],[-(s__atomicNumber(s__Palladium,"46"))],[s__instance(_3682684,s__Object),-(s__measure(_3682684,s__MeasureFn("106.4",s__Amu))),s__instance(_3682684,s__Palladium),s__instance(_3682684,s__Atom)],[-(s__documentation(s__Palladium,s__EnglishLanguage,'Soft white ductile transition element. Found with some copper and nickel ores. Does not react with oxygen at normal temperatures. Dissolves slowly in hydrochloric acid. Discovered in 1803 by W.H. Wollaston.'))],[-(s__subclass(s__Silver,s__ElementalSubstance))],[-(s__instance(s__Silver__t,s__SetOrClass))],[-(s__names(s__Silver,'Silver'))],[-(s__conventionalShortName('Ag',s__Silver))],[-(s__atomicNumber(s__Silver,"47"))],[s__instance(_3684400,s__Object),-(s__measure(_3684400,s__MeasureFn("107.870",s__Amu))),s__instance(_3684400,s__Silver),s__instance(_3684400,s__Atom)],[-(s__documentation(s__Silver,s__EnglishLanguage,'White lustrous soft metallic transition element. Found in both its elemental form and in minerals. Used in jewellery, tableware and so on. Less reactive than silver, chemically.'))],[-(s__subclass(s__Cadmium,s__ElementalSubstance))],[-(s__instance(s__Cadmium__t,s__SetOrClass))],[-(s__names(s__Cadmium,'Cadmium'))],[-(s__conventionalShortName('Cd',s__Cadmium))],[-(s__atomicNumber(s__Cadmium,"48"))],[s__instance(_3686116,s__Object),-(s__measure(_3686116,s__MeasureFn("112.40",s__Amu))),s__instance(_3686116,s__Cadmium),s__instance(_3686116,s__Atom)],[-(s__documentation(s__Cadmium,s__EnglishLanguage,'Soft bluish metal belonging to group 12 of the periodic table. Extremely toxic even in low concentrations. Chemically similar to zinc, but lends itself to more complex compounds. Discovered in 1817 by F. Stromeyer.'))],[-(s__subclass(s__Indium,s__ElementalSubstance))],[-(s__instance(s__Indium__t,s__SetOrClass))],[-(s__names(s__Indium,'Indium'))],[-(s__conventionalShortName('In',s__Indium))],[-(s__atomicNumber(s__Indium,"49"))],[s__instance(_3687832,s__Object),-(s__measure(_3687832,s__MeasureFn("114.82",s__Amu))),s__instance(_3687832,s__Indium),s__instance(_3687832,s__Atom)],[-(s__documentation(s__Indium,s__EnglishLanguage,'Soft silvery element belonging to group 13 of the periodic table. The most common natural isotope is In-115, which has a half-life of 6*10^4 years. Five other radioisotopes exist. Discovered in 1863 by Reich and Richter.'))],[-(s__subclass(s__Tin,s__ElementalSubstance))],[-(s__instance(s__Tin__t,s__SetOrClass))],[-(s__names(s__Tin,'Tin'))],[-(s__conventionalShortName('Sn',s__Tin))],[-(s__atomicNumber(s__Tin,"50"))],[s__instance(_3689548,s__Object),-(s__measure(_3689548,s__MeasureFn("118.69",s__Amu))),s__instance(_3689548,s__Tin),s__instance(_3689548,s__Atom)],[-(s__documentation(s__Tin,s__EnglishLanguage,'Silvery malleable metallic element belonging to group 14 of the periodic table. Twenty-six isotopes are known, five of which are radioactive. Chemically reactive. Combines directly with chlorine and oxygen and displaces hydrogen from dilute acids. '))],[-(s__subclass(s__Antimony,s__ElementalSubstance))],[-(s__instance(s__Antimony__t,s__SetOrClass))],[-(s__names(s__Antimony,'Antimony'))],[-(s__conventionalShortName('Sb',s__Antimony))],[-(s__atomicNumber(s__Antimony,"51"))],[s__instance(_3691264,s__Object),-(s__measure(_3691264,s__MeasureFn("121.75",s__Amu))),s__instance(_3691264,s__Antimony),s__instance(_3691264,s__Atom)],[-(s__documentation(s__Antimony,s__EnglishLanguage,'Element of group 15. Multiple allotropic forms. The stable form of antimony is a blue-white metal. Yellow and black antimony are unstable non-metals. Used in flame-proofing, paints, ceramics, enamels, and rubber. Attacked by oxidizing acids and halogens. First reported by Tholden in 1450.'))],[-(s__subclass(s__Tellurium,s__ElementalSubstance))],[-(s__instance(s__Tellurium__t,s__SetOrClass))],[-(s__names(s__Tellurium,'Tellurium'))],[-(s__conventionalShortName('Te',s__Tellurium))],[-(s__atomicNumber(s__Tellurium,"52"))],[s__instance(_3692980,s__Object),-(s__measure(_3692980,s__MeasureFn("127.60",s__Amu))),s__instance(_3692980,s__Tellurium),s__instance(_3692980,s__Atom)],[-(s__documentation(s__Tellurium,s__EnglishLanguage,'Silvery metalloid element of group 16. Eight natural isotopes, nine radioactive isotopes. Used in semiconductors and to a degree in some steels. Chemistry is similar to {sulphur}. Discovered in 1782 by Franz Miller.'))],[-(s__subclass(s__Iodine,s__ElementalSubstance))],[-(s__instance(s__Iodine__t,s__SetOrClass))],[-(s__names(s__Iodine,'Iodine'))],[-(s__conventionalShortName('I',s__Iodine))],[-(s__atomicNumber(s__Iodine,"53"))],[s__instance(_3694696,s__Object),-(s__measure(_3694696,s__MeasureFn("126.904",s__Amu))),s__instance(_3694696,s__Iodine),s__instance(_3694696,s__Atom)],[-(s__documentation(s__Iodine,s__EnglishLanguage,'Dark violet nonmetallic element, belongs to group 17 of the periodic table. Insoluble in water. Required as a trace element for living organisms. One stable isotope, I-127 exists, in addition to fourteen radioactive isotopes. Chemically the least reactive of the halogens, and the most electropositive metallic halogen. Discovered in 1812 by Courtois. '))],[-(s__subclass(s__Xenon,s__ElementalSubstance))],[-(s__instance(s__Xenon__t,s__SetOrClass))],[-(s__names(s__Xenon,'Xenon'))],[-(s__conventionalShortName('Xe',s__Xenon))],[-(s__atomicNumber(s__Xenon,"54"))],[s__instance(_3696412,s__Object),-(s__measure(_3696412,s__MeasureFn("131.30",s__Amu))),s__instance(_3696412,s__Xenon),s__instance(_3696412,s__Atom)],[-(s__documentation(s__Xenon,s__EnglishLanguage,'Colourless, odourless gas belonging to group 18 on the periodic table (the noble gases.) Nine natural isotopes and seven radioactive isotopes are known. Xenon was part of the first noble-gas compound synthesized. Several others involving Xenon have been found since then. Xenon was discovered by Ramsey and Travers in 1898.'))],[-(s__subclass(s__Caesium,s__ElementalSubstance))],[-(s__instance(s__Caesium__t,s__SetOrClass))],[-(s__names(s__Caesium,'Caesium'))],[-(s__conventionalShortName('Cs',s__Caesium))],[-(s__atomicNumber(s__Caesium,"55"))],[s__instance(_3698128,s__Object),-(s__measure(_3698128,s__MeasureFn("132.90545",s__Amu))),s__instance(_3698128,s__Caesium),s__instance(_3698128,s__Atom)],[-(s__documentation(s__Caesium,s__EnglishLanguage,'Soft silvery-white metallic element belonging to group 1 of the periodic table. One of the three metals which are liquid at room temperature. Cs-133 is the natural, and only stable, isotope. Fifteen other radioisotopes exist. Caesium reacts explosively with cold water, and ice at temperatures above 157K. Caesium hydroxide is the strongest base known. Caesium is the most electropositive, most alkaline and has the least ionization potential of all the elements. Known uses include the basis of atomic clocks, catalyst for the hydrogenation of some organic compounds, and in photoelectric cells. Caesium was discovered by Gustav Kirchoff and Robert Bunsen in Germany in 1860 spectroscopically. Its identification was based upon the bright blue lines in its spectrum. The name comes from the latin word caesius, which means sky blue. Caesium should be considered highly toxic. Some of the radioisotopes are even more toxic.'))],[-(s__subclass(s__Barium,s__ElementalSubstance))],[-(s__instance(s__Barium__t,s__SetOrClass))],[-(s__names(s__Barium,'Barium'))],[-(s__conventionalShortName('Ba',s__Barium))],[-(s__atomicNumber(s__Barium,"56"))],[s__instance(_3699844,s__Object),-(s__measure(_3699844,s__MeasureFn("137.34",s__Amu))),s__instance(_3699844,s__Barium),s__instance(_3699844,s__Atom)],[-(s__documentation(s__Barium,s__EnglishLanguage,'Silvery-white reactive element, belonging to group 2 of the periodic table. Soluble barium compounds are extremely poisonous. Identified in 1774 by Karl Scheele and extracted in 1808 by Humphry Davy.'))],[-(s__subclass(s__Lanthanum,s__ElementalSubstance))],[-(s__instance(s__Lanthanum__t,s__SetOrClass))],[-(s__names(s__Lanthanum,'Lanthanum'))],[-(s__conventionalShortName('La',s__Lanthanum))],[-(s__atomicNumber(s__Lanthanum,"57"))],[s__instance(_3701560,s__Object),-(s__measure(_3701560,s__MeasureFn("138.9055",s__Amu))),s__instance(_3701560,s__Lanthanum),s__instance(_3701560,s__Atom)],[-(s__documentation(s__Lanthanum,s__EnglishLanguage,'(From the Greek word lanthanein, to line hidden) Silvery metallic element belonging to group 3 of the periodic table and oft considered to be one of the lanthanoids. Found in some rare-earth minerals. Twenty-five natural isotopes exist. La-139 which is stable, and La-138 which has a half-life of 10^10 to 10^15 years. The other twenty-three isotopes are radioactive. It resembles the lanthanoids chemically. Lanthanum has a low to moderate level of toxicity, and should be handled with care. Discovered in 1839 by C.G. Mosander.'))],[-(s__subclass(s__Cerium,s__ElementalSubstance))],[-(s__instance(s__Cerium__t,s__SetOrClass))],[-(s__names(s__Cerium,'Cerium'))],[-(s__conventionalShortName('Ce',s__Cerium))],[-(s__atomicNumber(s__Cerium,"58"))],[s__instance(_3703276,s__Object),-(s__measure(_3703276,s__MeasureFn("140.12",s__Amu))),s__instance(_3703276,s__Cerium),s__instance(_3703276,s__Atom)],[-(s__documentation(s__Cerium,s__EnglishLanguage,'Silvery metallic element, belongs to the lanthanoids. Four natural isotopes exist, and fifteen radioactive isotopes have been identified. Used in some rare-earth alloys. The oxidized form is used in the glass industry. Discovered by Martin .H. Klaproth in 1803.'))],[-(s__subclass(s__Praseodymium,s__ElementalSubstance))],[-(s__instance(s__Praseodymium__t,s__SetOrClass))],[-(s__names(s__Praseodymium,'Praseodymium'))],[-(s__conventionalShortName('Pr',s__Praseodymium))],[-(s__atomicNumber(s__Praseodymium,"59"))],[s__instance(_3704992,s__Object),-(s__measure(_3704992,s__MeasureFn("140.907",s__Amu))),s__instance(_3704992,s__Praseodymium),s__instance(_3704992,s__Atom)],[-(s__documentation(s__Praseodymium,s__EnglishLanguage,'Soft silvery metallic element, belongs to the lanthanoids. Only natural isotope is Pr-141 which is not radioactive. Fourteen radioactive isotopes have been artificially produced. Used in rare-earth alloys. Discovered in 1885 by C.A. von Welsbach.'))],[-(s__subclass(s__Neodymium,s__ElementalSubstance))],[-(s__instance(s__Neodymium__t,s__SetOrClass))],[-(s__names(s__Neodymium,'Neodymium'))],[-(s__conventionalShortName('Nd',s__Neodymium))],[-(s__atomicNumber(s__Neodymium,"60"))],[s__instance(_3706708,s__Object),-(s__measure(_3706708,s__MeasureFn("144.24",s__Amu))),s__instance(_3706708,s__Neodymium),s__instance(_3706708,s__Atom)],[-(s__documentation(s__Neodymium,s__EnglishLanguage,'Soft bright silvery metallic element, belongs to the lanthanoids. Seven natural isotopes, Nd-144 being the only radioactive one with a half-life of 10^10 to 10^15 years. Six artificial radioisotopes have been produced. The metal is used in glass works to color class a shade of violet-purple and make it dichroic. One of the more reactive rare-earth metals, quickly reacts with air. Used in some rare-earth alloys. Neodymium is used to color the glass used in welders glasses. Neodymium is also used in very powerful, permanent magnets (Nd2Fe14B). Discovered by Carl F. Auer von Welsbach in Austria in 1885 by separating didymium into its elemental components {praseodymium} and neodymium. The name comes from the Greek words neos didymos which means new twin. Neodymium should be considered highly toxic, however evidence would seem to show that it acts as little more than a skin and eye irritant. The dust however, presents a fire and explosion hazard.'))],[-(s__subclass(s__Promethium,s__ElementalSubstance))],[-(s__instance(s__Promethium__t,s__SetOrClass))],[-(s__names(s__Promethium,'Promethium'))],[-(s__conventionalShortName('Pm',s__Promethium))],[-(s__atomicNumber(s__Promethium,"61"))],[s__instance(_3708424,s__Object),-(s__measure(_3708424,s__MeasureFn("147",s__Amu))),s__instance(_3708424,s__Promethium),s__instance(_3708424,s__Atom)],[-(s__documentation(s__Promethium,s__EnglishLanguage,'Soft silvery metallic element, belongs to the lanthanoids. Pm-147, the only natural isotope, is radioactive and has a half-life of 252 years. Eighteen radioisotopes have been produced, but all have very short half-lives. Found only in nuclear decay waste. Pm-147 is of interest as a beta-decay source, however Pm-146 and Pm-148 have to be removed from it first, as they generate gamma radiation. Discovered by J.A. Marinsky, L.E. Glendenin and C.D. Coryell in 1947.'))],[-(s__subclass(s__Samarium,s__ElementalSubstance))],[-(s__instance(s__Samarium__t,s__SetOrClass))],[-(s__names(s__Samarium,'Samarium'))],[-(s__conventionalShortName('Sm',s__Samarium))],[-(s__atomicNumber(s__Samarium,"62"))],[s__instance(_3710140,s__Object),-(s__measure(_3710140,s__MeasureFn("150.35",s__Amu))),s__instance(_3710140,s__Samarium),s__instance(_3710140,s__Atom)],[-(s__documentation(s__Samarium,s__EnglishLanguage,'Soft silvery metallic element, belongs to the lanthanoids. Seven natural isotopes, Sm-147 is the only radioisotope, and has a half-life of 2.5*10^11 years. Used for making special alloys needed in the production of nuclear reactors. Also used as a neutron absorber. Small quantities of samarium oxide is used in special optical glasses. The largest use of the element is its ferromagnetic alloy which produces permanent magnets that are five times stronger than magnets produced by any other material. Discovered by Francois Lecoq de Boisbaudran in 1879.'))],[-(s__subclass(s__Europium,s__ElementalSubstance))],[-(s__instance(s__Europium__t,s__SetOrClass))],[-(s__names(s__Europium,'Europium'))],[-(s__conventionalShortName('Eu',s__Europium))],[-(s__atomicNumber(s__Europium,"63"))],[s__instance(_3711856,s__Object),-(s__measure(_3711856,s__MeasureFn("151.25",s__Amu))),s__instance(_3711856,s__Europium),s__instance(_3711856,s__Atom)],[-(s__documentation(s__Europium,s__EnglishLanguage,'Soft silvery metallic element belonging to the lanthanoids. Eu-151 and Eu-153 are the only two stable isotopes, both of which are {neutron} absorbers. Discovered in 1889 by Sir William Crookes.'))],[-(s__subclass(s__Gadolinium,s__ElementalSubstance))],[-(s__instance(s__Gadolinium__t,s__SetOrClass))],[-(s__names(s__Gadolinium,'Gadolinium'))],[-(s__conventionalShortName('Gd',s__Gadolinium))],[-(s__atomicNumber(s__Gadolinium,"64"))],[s__instance(_3713572,s__Object),-(s__measure(_3713572,s__MeasureFn("157.25",s__Amu))),s__instance(_3713572,s__Gadolinium),s__instance(_3713572,s__Atom)],[-(s__documentation(s__Gadolinium,s__EnglishLanguage,'Soft silvery metallic element belonging to the lanthanoids. Seven natural, stable isotopes are known in addition to eleven artificial isotopes. Gd-155 and Gd-157 and the best neutron absorbers of all elements. Gadolinium compounds are used in electronics. Discovered by J.C.G Marignac in 1880.'))],[-(s__subclass(s__Terbium,s__ElementalSubstance))],[-(s__instance(s__Terbium__t,s__SetOrClass))],[-(s__names(s__Terbium,'Terbium'))],[-(s__conventionalShortName('Tb',s__Terbium))],[-(s__atomicNumber(s__Terbium,"65"))],[s__instance(_3715288,s__Object),-(s__measure(_3715288,s__MeasureFn("158.924",s__Amu))),s__instance(_3715288,s__Terbium),s__instance(_3715288,s__Atom)],[-(s__documentation(s__Terbium,s__EnglishLanguage,'Silvery metallic element belonging to the lanthanoids. Tb-159 is the only stable isotope, there are seventeen artificial isotopes. Discovered by G.G. Mosander in 1843.'))],[-(s__subclass(s__Dysprosium,s__ElementalSubstance))],[-(s__instance(s__Dysprosium__t,s__SetOrClass))],[-(s__names(s__Dysprosium,'Dysprosium'))],[-(s__conventionalShortName('Dy',s__Dysprosium))],[-(s__atomicNumber(s__Dysprosium,"66"))],[s__instance(_3717004,s__Object),-(s__measure(_3717004,s__MeasureFn("162.50",s__Amu))),s__instance(_3717004,s__Dysprosium),s__instance(_3717004,s__Atom)],[-(s__documentation(s__Dysprosium,s__EnglishLanguage,'Metallic with a bright silvery-white lustre. Dysprosium belongs to the lanthanoids. It is relatively stable in air at room temperatures, it will however dissolve in mineral acids, evolving hydrogen. It is found in from rare-earth minerals. There are seven natural isotopes of dysprosium, and eight radioisotopes, Dy-154 being the most stable with a half-life of 3*10^6 years. Dysprosium is used as a neutron absorber in nuclear fission reactions, and in compact disks. It was discovered by Paul Emile Lecoq de Boisbaudran in 1886 in France. Its name comes from the Greek word dysprositos, which means hard to obtain.'))],[-(s__subclass(s__Holmium,s__ElementalSubstance))],[-(s__instance(s__Holmium__t,s__SetOrClass))],[-(s__names(s__Holmium,'Holmium'))],[-(s__conventionalShortName('Ho',s__Holmium))],[-(s__atomicNumber(s__Holmium,"67"))],[s__instance(_3718720,s__Object),-(s__measure(_3718720,s__MeasureFn("167.26",s__Amu))),s__instance(_3718720,s__Holmium),s__instance(_3718720,s__Atom)],[-(s__documentation(s__Holmium,s__EnglishLanguage,'Relatively soft and malleable silvery-white metallic element, which is stable in dry air at room temperature. It oxidizes in moist air and at high temperatures. It belongs to the lanthanoids. A rare-earth metal, it is found in the minerals monazite and gadolinite. It possesses unusual magnetic properties. One natural isotope, Ho-165 exists, six radioisotopes exist, the most stable being Ho-163 with a half-life of 4570 years. Holmium is used in some metal alloys, it is also said to stimulate the metabolism. Discovered by Per Theodor Cleve and J.L. Soret in Switzerland in 1879. The name homium comes from the Greek word Holmia which means Sweden. While all holmium compounds should be considered highly toxic, initial evidence seems to indicate that they do not pose much danger. The metals dust however, is a fire hazard.'))],[-(s__subclass(s__Erbium,s__ElementalSubstance))],[-(s__instance(s__Erbium__t,s__SetOrClass))],[-(s__names(s__Erbium,'Erbium'))],[-(s__conventionalShortName('Er',s__Erbium))],[-(s__atomicNumber(s__Erbium,"68"))],[s__instance(_3720436,s__Object),-(s__measure(_3720436,s__MeasureFn("167.26",s__Amu))),s__instance(_3720436,s__Erbium),s__instance(_3720436,s__Atom)],[-(s__documentation(s__Erbium,s__EnglishLanguage,'Soft silvery metallic element which belongs to the lanthanoids. Six natural isotopes that are stable. Twelve artificial isotopes are known. Used in nuclear technology as a neutron absorber. It is being investigated for other possible uses. Discovered by Carl G. Mosander in 1843.'))],[-(s__subclass(s__Thulium,s__ElementalSubstance))],[-(s__instance(s__Thulium__t,s__SetOrClass))],[-(s__names(s__Thulium,'Thulium'))],[-(s__conventionalShortName('Tm',s__Thulium))],[-(s__atomicNumber(s__Thulium,"69"))],[s__instance(_3722152,s__Object),-(s__measure(_3722152,s__MeasureFn("168.934",s__Amu))),s__instance(_3722152,s__Thulium),s__instance(_3722152,s__Atom)],[-(s__documentation(s__Thulium,s__EnglishLanguage,'Soft grey metallic element that belongs to the lanthanoids. One natural isotope exists, Tm-169, and seventeen artificial isotopes have been produced. No known uses for the element. Discovered in 1879 by Per Theodor Cleve.'))],[-(s__subclass(s__Ytterbium,s__ElementalSubstance))],[-(s__instance(s__Ytterbium__t,s__SetOrClass))],[-(s__names(s__Ytterbium,'Ytterbium'))],[-(s__conventionalShortName('Yb',s__Ytterbium))],[-(s__atomicNumber(s__Ytterbium,"70"))],[s__instance(_3723868,s__Object),-(s__measure(_3723868,s__MeasureFn("173.04",s__Amu))),s__instance(_3723868,s__Ytterbium),s__instance(_3723868,s__Atom)],[-(s__documentation(s__Ytterbium,s__EnglishLanguage,'Silvery metallic element of the lanthanoids. Seven natural isotopes and ten artificial isotopes are known. Used in certain steels. Discovered by J.D.G. Marignac in 1878.'))],[-(s__subclass(s__Lutetium,s__ElementalSubstance))],[-(s__instance(s__Lutetium__t,s__SetOrClass))],[-(s__names(s__Lutetium,'Lutetium'))],[-(s__conventionalShortName('Lu',s__Lutetium))],[-(s__atomicNumber(s__Lutetium,"71"))],[s__instance(_3725584,s__Object),-(s__measure(_3725584,s__MeasureFn("194.967",s__Amu))),s__instance(_3725584,s__Lutetium),s__instance(_3725584,s__Atom)],[-(s__documentation(s__Lutetium,s__EnglishLanguage,'Silvery-white rare-earth metal which is relatively stable in air. It happens to be the most expensive rare-earth metal. Its found with almost all rare-earth metals, but is very difficult to separate from other elements. Least abundant of all natural elements. Used in metal alloys, and as a catalyst in various processes. There are two natural, stable isotopes, and seven radioisotopes, the most stable being Lu-174 with a half-life of 3.3 years. The separation of lutetium from {ytterbium} was described by Georges Urbain in 1907. It was discovered at approximately the same time by Carl Auer von Welsbach. The name comes from the Greek word lutetia which means Paris.'))],[-(s__subclass(s__Hafnium,s__ElementalSubstance))],[-(s__instance(s__Hafnium__t,s__SetOrClass))],[-(s__names(s__Hafnium,'Hafnium'))],[-(s__conventionalShortName('Hf',s__Hafnium))],[-(s__atomicNumber(s__Hafnium,"72"))],[s__instance(_3727300,s__Object),-(s__measure(_3727300,s__MeasureFn("178.49",s__Amu))),s__instance(_3727300,s__Hafnium),s__instance(_3727300,s__Atom)],[-(s__documentation(s__Hafnium,s__EnglishLanguage,'Silvery lustrous metallic transition element. Used in tungsten alloys in filaments and electrodes, also acts as a neutron absorber. First reported by Urbain in 1911, existence was finally established in 1923 by D. Coster, G.C. de Hevesy in 1923.'))],[-(s__subclass(s__Tantalum,s__ElementalSubstance))],[-(s__instance(s__Tantalum__t,s__SetOrClass))],[-(s__names(s__Tantalum,'Tantalum'))],[-(s__conventionalShortName('Ta',s__Tantalum))],[-(s__atomicNumber(s__Tantalum,"73"))],[s__instance(_3729016,s__Object),-(s__measure(_3729016,s__MeasureFn("180.948",s__Amu))),s__instance(_3729016,s__Tantalum),s__instance(_3729016,s__Atom)],[-(s__documentation(s__Tantalum,s__EnglishLanguage,'Heavy blue-grey metallic transition element. Ta-181 is a stable isotope, and Ta-180 is a radioactive isotope, with a half-life in excess of 10^7 years. Used in surgery as it is unreactive. Forms a passive oxide layer in air. Identified in 1802 by Ekeberg and isolated in 1820 by Jons J. Berzelius.'))],[-(s__subclass(s__Tungsten,s__ElementalSubstance))],[-(s__instance(s__Tungsten__t,s__SetOrClass))],[-(s__names(s__Tungsten,'Tungsten'))],[-(s__conventionalShortName('W',s__Tungsten))],[-(s__atomicNumber(s__Tungsten,"74"))],[s__instance(_3730732,s__Object),-(s__measure(_3730732,s__MeasureFn("183.85",s__Amu))),s__instance(_3730732,s__Tungsten),s__instance(_3730732,s__Atom)],[-(s__documentation(s__Tungsten,s__EnglishLanguage,'White or grey metallic transition element, formerly called {wolfram}. Forms a protective oxide in air and can be oxidized at high temperature. First isolated by Jose and Fausto de Elhuyer in 1783.'))],[-(s__subclass(s__Rhenium,s__ElementalSubstance))],[-(s__instance(s__Rhenium__t,s__SetOrClass))],[-(s__names(s__Rhenium,'Rhenium'))],[-(s__conventionalShortName('Re',s__Rhenium))],[-(s__atomicNumber(s__Rhenium,"75"))],[s__instance(_3732448,s__Object),-(s__measure(_3732448,s__MeasureFn("186.2",s__Amu))),s__instance(_3732448,s__Rhenium),s__instance(_3732448,s__Atom)],[-(s__documentation(s__Rhenium,s__EnglishLanguage,'Silvery-white metallic transition element. Obtained as a by-product of molybdenum refinement. Rhenium-molybdenum alloys are superconducting.'))],[-(s__subclass(s__Osmium,s__ElementalSubstance))],[-(s__instance(s__Osmium__t,s__SetOrClass))],[-(s__names(s__Osmium,'Osmium'))],[-(s__conventionalShortName('Os',s__Osmium))],[-(s__atomicNumber(s__Osmium,"76"))],[s__instance(_3734164,s__Object),-(s__measure(_3734164,s__MeasureFn("190.2",s__Amu))),s__instance(_3734164,s__Osmium),s__instance(_3734164,s__Atom)],[-(s__documentation(s__Osmium,s__EnglishLanguage,'Hard blue-white metallic transition element. Found with platinum and used in some alloys with platinum and iridium.'))],[-(s__subclass(s__Iridium,s__ElementalSubstance))],[-(s__instance(s__Iridium__t,s__SetOrClass))],[-(s__names(s__Iridium,'Iridium'))],[-(s__conventionalShortName('Ir',s__Iridium))],[-(s__atomicNumber(s__Iridium,"77"))],[s__instance(_3735880,s__Object),-(s__measure(_3735880,s__MeasureFn("192.217",s__Amu))),s__instance(_3735880,s__Iridium),s__instance(_3735880,s__Atom)],[-(s__documentation(s__Iridium,s__EnglishLanguage,'Very hard and brittle, silvery metallic transition element. It has a yellowish cast to it. Salts of iridium are highly colored. It is the most corrosion resistant metal known, not attacked by any acid, but is attacked by molten salts. There are two natural isotopes of iridium, and 4 radioisotopes, the most stable being Ir-192 with a half-life of 73.83 days. Ir-192 decays into {platinum}, while the other radioisotopes decay into {osmium}. Iridium is used in high temperature apparatus, electrical contacts, and as a hardening agent for platinum. Discovered in 1803 by Smithson Tennant in England. The name comes from the Greek word iris, which means rainbow. Iridium metal is generally non-toxic due to its relative unreactivity, but iridium compounds should be considered highly toxic.'))],[-(s__subclass(s__Platinum,s__ElementalSubstance))],[-(s__instance(s__Platinum__t,s__SetOrClass))],[-(s__names(s__Platinum,'Platinum'))],[-(s__conventionalShortName('Pt',s__Platinum))],[-(s__atomicNumber(s__Platinum,"78"))],[s__instance(_3737596,s__Object),-(s__measure(_3737596,s__MeasureFn("195.078",s__Amu))),s__instance(_3737596,s__Platinum),s__instance(_3737596,s__Atom)],[-(s__documentation(s__Platinum,s__EnglishLanguage,'Attractive greyish-white metal. When pure, it is malleable and ductile. Does not oxidize in air, insoluble in hydrochloric and nitric acid. Corroded by halogens, cyandies, sulphur and alkalis. {Hydrogen} and {oxygen} react explosively in the presence of platinum. There are six stable isotopes and three radioisotopes, the most stable being Pt-193 with a half-life of 60 years. Platinum is used in jewelry, laboratory equipment, electrical contacts, dentistry, and anti-pollution devices in cars. PtCl2(NH3)2 is used to treat some forms of cancer. Platinum-{cobalt} alloys have magnetic properties. It is also used in the definition of the Standard Hydrogen Electrode. Discovered by Antonio de Ulloa in South America in 1735. The name comes from the Spanish word platina which means silver. Platinum metal is generally not a health concern due to its unreactivity, however platinum compounds should be considered highly toxic.'))],[-(s__subclass(s__Gold,s__ElementalSubstance))],[-(s__instance(s__Gold__t,s__SetOrClass))],[-(s__names(s__Gold,'Gold'))],[-(s__conventionalShortName('Au',s__Gold))],[-(s__atomicNumber(s__Gold,"79"))],[s__instance(_3739312,s__Object),-(s__measure(_3739312,s__MeasureFn("196.96655",s__Amu))),s__instance(_3739312,s__Gold),s__instance(_3739312,s__Atom)],[-(s__documentation(s__Gold,s__EnglishLanguage,'Gold is gold colored. It is the most malleable and ductile metal known. There is only one stable isotope of gold, and five radioisotopes of gold, Au-195 being the most stable with a half-life of 186 days. Gold is used as a monetary standard, in jewelry, dentistry, electronics. Au-198 is used in treating cancer and some other medical conditions. Gold has been known to exist as far back as 2600 BC. Gold comes from the Anglo-Saxon word gold. Its symbol, Au, comes from the Latin word aurum, which means gold. Gold is not particularly toxic, however it is known to cause damage to the liver and kidneys in some.'))],[-(s__subclass(s__Mercury,s__ElementalSubstance))],[-(s__instance(s__Mercury__t,s__SetOrClass))],[-(s__names(s__Mercury,'Mercury'))],[-(s__conventionalShortName('Hg',s__Mercury))],[-(s__atomicNumber(s__Mercury,"80"))],[s__instance(_3741028,s__Object),-(s__measure(_3741028,s__MeasureFn("200.59",s__Amu))),s__instance(_3741028,s__Mercury),s__instance(_3741028,s__Atom)],[-(s__documentation(s__Mercury,s__EnglishLanguage,'Heavy silvery liquid metallic element, belongs to the zinc group. Used in thermometers, barometers and other scientific apparatus. Less reactive than zinc and cadmium, does not displace hydrogen from acids. Forms a number of complexes and organomercury compounds.'))],[-(s__subclass(s__Thallium,s__ElementalSubstance))],[-(s__instance(s__Thallium__t,s__SetOrClass))],[-(s__names(s__Thallium,'Thallium'))],[-(s__conventionalShortName('Tl',s__Thallium))],[-(s__atomicNumber(s__Thallium,"81"))],[s__instance(_3742744,s__Object),-(s__measure(_3742744,s__MeasureFn("204.3833",s__Amu))),s__instance(_3742744,s__Thallium),s__instance(_3742744,s__Atom)],[-(s__documentation(s__Thallium,s__EnglishLanguage,'Pure, unreacted thallium appears silvery-white and exhibits a metallic lustre. Upon reacting with air, it begins to turn bluish-grey and looks like lead. It is very malleable, and can be cut with a knife. There are two stable isotopes, and four radioisotopes, Tl-204 being the most stable with a half-life of 3.78 years. Thallium sulphate was used as a rodenticide. Thallium sulphines conductivity changes with exposure to infrared light, this gives it a use in infrared detectors. Discovered by Sir William Crookes via spectroscopy. Its name comes from the Greek word thallos, which means green twig. Thallium and its compounds are toxic and can cause cancer.'))],[-(s__subclass(s__Lead,s__ElementalSubstance))],[-(s__instance(s__Lead__t,s__SetOrClass))],[-(s__names(s__Lead,'Lead'))],[-(s__conventionalShortName('Pb',s__Lead))],[-(s__atomicNumber(s__Lead,"82"))],[s__instance(_3744460,s__Object),-(s__measure(_3744460,s__MeasureFn("207.19",s__Amu))),s__instance(_3744460,s__Lead),s__instance(_3744460,s__Atom)],[-(s__documentation(s__Lead,s__EnglishLanguage,'Heavy dull grey ductile metallic element, belongs to group 14. Used in building construction, lead-place accumulators, bullets and shot, and is part of solder, pewter, bearing metals, type metals and fusible alloys.'))],[-(s__subclass(s__Bismuth,s__ElementalSubstance))],[-(s__instance(s__Bismuth__t,s__SetOrClass))],[-(s__names(s__Bismuth,'Bismuth'))],[-(s__conventionalShortName('Bi',s__Bismuth))],[-(s__atomicNumber(s__Bismuth,"83"))],[s__instance(_3746176,s__Object),-(s__measure(_3746176,s__MeasureFn("208.980",s__Amu))),s__instance(_3746176,s__Bismuth),s__instance(_3746176,s__Atom)],[-(s__documentation(s__Bismuth,s__EnglishLanguage,'White crystalline metal with a pink tinge, belongs to group 15. Most diamagnetic of all metals and has the lowest thermal conductivity of all the elements except mercury. Lead-free bismuth compounds are used in cosmetics and medical procedures. Burns in the air and produces a blue flame. In 1753, C.G. Junine first demonstrated that it was different from lead.'))],[-(s__subclass(s__Polonium,s__ElementalSubstance))],[-(s__instance(s__Polonium__t,s__SetOrClass))],[-(s__names(s__Polonium,'Polonium'))],[-(s__conventionalShortName('Po',s__Polonium))],[-(s__atomicNumber(s__Polonium,"84"))],[s__instance(_3747892,s__Object),-(s__measure(_3747892,s__MeasureFn("210",s__Amu))),s__instance(_3747892,s__Polonium),s__instance(_3747892,s__Atom)],[-(s__documentation(s__Polonium,s__EnglishLanguage,'Rare radioactive metallic element, belongs to group 16 of the periodic table. Over 30 known isotopes exist, the most of all elements. Po-209 has a half-life of 103 years. Possible uses in heating spacecraft. Discovered by Marie Curie in 1898 in a sample of pitchblende.'))],[-(s__subclass(s__Astatine,s__ElementalSubstance))],[-(s__instance(s__Astatine__t,s__SetOrClass))],[-(s__names(s__Astatine,'Astatine'))],[-(s__conventionalShortName('At',s__Astatine))],[-(s__atomicNumber(s__Astatine,"85"))],[s__instance(_3749608,s__Object),-(s__measure(_3749608,s__MeasureFn("210",s__Amu))),s__instance(_3749608,s__Astatine),s__instance(_3749608,s__Atom)],[-(s__documentation(s__Astatine,s__EnglishLanguage,'Radioactive halogen element. Occurs naturally from uranium and thorium decay. At least 20 known isotopes. At-210, the most stable, has a half-life of 8.3 hours. Synthesized by nuclear bombardment in 1940 by D.R. Corson, K.R. MacKenzie and E. Segre at the University of California.'))],[-(s__subclass(s__Radon,s__ElementalSubstance))],[-(s__instance(s__Radon__t,s__SetOrClass))],[-(s__names(s__Radon,'Radon'))],[-(s__conventionalShortName('Rn',s__Radon))],[-(s__atomicNumber(s__Radon,"86"))],[s__instance(_3751324,s__Object),-(s__measure(_3751324,s__MeasureFn("222",s__Amu))),s__instance(_3751324,s__Radon),s__instance(_3751324,s__Atom)],[-(s__documentation(s__Radon,s__EnglishLanguage,'Colorless radioactive gaseous element, belongs to the noble gases. Of the twenty known isotopes, the most stable is Rn-222 with a half-life of 3.8 days. Formed by the radioactive decay of {Radium}-226. Radon itself decays into {polonium}. Used in radiotherapy. As a noble gas, it is effectively inert, though radon fluoride has been synthesized. First isolated in 1908 by Ramsey and Gray.'))],[-(s__subclass(s__Francium,s__ElementalSubstance))],[-(s__instance(s__Francium__t,s__SetOrClass))],[-(s__names(s__Francium,'Francium'))],[-(s__conventionalShortName('Fr',s__Francium))],[-(s__atomicNumber(s__Francium,"87"))],[s__instance(_3753040,s__Object),-(s__measure(_3753040,s__MeasureFn("223",s__Amu))),s__instance(_3753040,s__Francium),s__instance(_3753040,s__Atom)],[-(s__documentation(s__Francium,s__EnglishLanguage,'Radioactive element, belongs to group 1 of the periodic table. Found in uranium and thorium ores. The 22 known isotopes are all radioactive, with the most stable being Fr-223. Its existence was confirmed in 1939 by Marguerite Perey.'))],[-(s__subclass(s__Radium,s__ElementalSubstance))],[-(s__instance(s__Radium__t,s__SetOrClass))],[-(s__names(s__Radium,'Radium'))],[-(s__conventionalShortName('Ra',s__Radium))],[-(s__atomicNumber(s__Radium,"88"))],[s__instance(_3754756,s__Object),-(s__measure(_3754756,s__MeasureFn("226",s__Amu))),s__instance(_3754756,s__Radium),s__instance(_3754756,s__Atom)],[-(s__documentation(s__Radium,s__EnglishLanguage,'Radioactive metallic transuranic element, belongs to group 2 of the periodic table. Most stable isotope, Ra-226 has a half-life of 1602 years, which decays into radon. Isolated from pitchblende in 1898 Marie and Pierre Curie.'))],[-(s__subclass(s__Actinium,s__ElementalSubstance))],[-(s__instance(s__Actinium__t,s__SetOrClass))],[-(s__names(s__Actinium,'Actinium'))],[-(s__conventionalShortName('Ac',s__Actinium))],[-(s__atomicNumber(s__Actinium,"89"))],[s__instance(_3756472,s__Object),-(s__measure(_3756472,s__MeasureFn("227",s__Amu))),s__instance(_3756472,s__Actinium),s__instance(_3756472,s__Atom)],[-(s__documentation(s__Actinium,s__EnglishLanguage,'Silvery radioactive metallic element, belongs to group 3 of the periodic table. The most stable isotope, Ac-227, has a half-life of 217 years. Ac-228 (half-life of 6.13 hours) also occurs in nature. There are 22 other artificial isotopes, all radioactive and having very short half-lives. Chemistry similar to lanthanum. Used as a source of alpha particles. Discovered by A. Debierne in 1899.'))],[-(s__subclass(s__Thorium,s__ElementalSubstance))],[-(s__instance(s__Thorium__t,s__SetOrClass))],[-(s__names(s__Thorium,'Thorium'))],[-(s__conventionalShortName('Th',s__Thorium))],[-(s__atomicNumber(s__Thorium,"90"))],[s__instance(_3758188,s__Object),-(s__measure(_3758188,s__MeasureFn("232.038",s__Amu))),s__instance(_3758188,s__Thorium),s__instance(_3758188,s__Atom)],[-(s__documentation(s__Thorium,s__EnglishLanguage,'Grey radioactive metallic element. Belongs to actinoids. Found in monazite sand in Brazil, India and the US. Thorium-232 has a half-life of 1.39x10^10 years. Can be used as a nuclear fuel for breeder reactors. Thorium-232 captures slow {neutron}s and breeds uranium-233. Discovered by Jons J. Berzelius in 1829.'))],[-(s__subclass(s__Protactinium,s__ElementalSubstance))],[-(s__instance(s__Protactinium__t,s__SetOrClass))],[-(s__names(s__Protactinium,'Protactinium'))],[-(s__conventionalShortName('Pa',s__Protactinium))],[-(s__atomicNumber(s__Protactinium,"91"))],[s__instance(_3759904,s__Object),-(s__measure(_3759904,s__MeasureFn("231",s__Amu))),s__instance(_3759904,s__Protactinium),s__instance(_3759904,s__Atom)],[-(s__documentation(s__Protactinium,s__EnglishLanguage,'Radioactive metallic element, belongs to the actinoids. The most stable isotope, Pa-231 has a half-life of 2.43*10^4 years. At least 10 other radioactive isotopes are known. No practical applications are known. Discovered in 1917 by Lise Meitner and Otto Hahn.'))],[-(s__subclass(s__Uranium,s__ElementalSubstance))],[-(s__instance(s__Uranium__t,s__SetOrClass))],[-(s__names(s__Uranium,'Uranium'))],[-(s__conventionalShortName('U',s__Uranium))],[-(s__atomicNumber(s__Uranium,"92"))],[s__instance(_3761620,s__Object),-(s__measure(_3761620,s__MeasureFn("231",s__Amu))),s__instance(_3761620,s__Uranium),s__instance(_3761620,s__Atom)],[-(s__documentation(s__Uranium,s__EnglishLanguage,'White radioactive metallic element belonging to the actinoids. Three natural isotopes, U-238, U-235 and U-234. Uranium-235 is used as the fuel for nuclear reactors and weapons. Discovered by Martin H. Klaproth in 1789.'))],[-(s__subclass(s__Neptunium,s__ElementalSubstance))],[-(s__instance(s__Neptunium__t,s__SetOrClass))],[-(s__names(s__Neptunium,'Neptunium'))],[-(s__conventionalShortName('Np',s__Neptunium))],[-(s__atomicNumber(s__Neptunium,"93"))],[s__instance(_3763336,s__Object),-(s__measure(_3763336,s__MeasureFn("237",s__Amu))),s__instance(_3763336,s__Neptunium),s__instance(_3763336,s__Atom)],[-(s__documentation(s__Neptunium,s__EnglishLanguage,'Radioactive metallic transuranic element, belongs to the actinoids. Np-237, the most stable isotope, has a half-life of 2.2*10^6 years and is a by product of nuclear reactors. The other known isotopes have mass numbers 229 through 236, and 238 through 241. Np-236 has a half-life of 5*10^3 years. First produced by Edwin M. McMillan and P.H. Abelson in 1940.'))],[-(s__subclass(s__Plutonium,s__ElementalSubstance))],[-(s__instance(s__Plutonium__t,s__SetOrClass))],[-(s__names(s__Plutonium,'Plutonium'))],[-(s__conventionalShortName('Pu',s__Plutonium))],[-(s__atomicNumber(s__Plutonium,"94"))],[s__instance(_3765052,s__Object),-(s__measure(_3765052,s__MeasureFn("242",s__Amu))),s__instance(_3765052,s__Plutonium),s__instance(_3765052,s__Atom)],[-(s__documentation(s__Plutonium,s__EnglishLanguage,'Dense silvery radioactive metallic transuranic element, belongs to the actinoids. Pu-244 is the most stable isotope with a half-life of 7.6*10^7 years. Thirteen isotopes are known. Pu-239 is the most important, it undergoes nuclear fission with slow neutrons and is hence important to nuclear weapons and reactors. Plutonium production is monitored down to the gram to prevent military misuse. First produced by Gleen T. Seaborg, Edwin M. McMillan, J.W. Kennedy and A.C. Wahl in 1940.'))],[-(s__subclass(s__Americium,s__ElementalSubstance))],[-(s__instance(s__Americium__t,s__SetOrClass))],[-(s__names(s__Americium,'Americium'))],[-(s__conventionalShortName('Am',s__Americium))],[-(s__atomicNumber(s__Americium,"95"))],[s__instance(_3766768,s__Object),-(s__measure(_3766768,s__MeasureFn("243",s__Amu))),s__instance(_3766768,s__Americium),s__instance(_3766768,s__Atom)],[-(s__documentation(s__Americium,s__EnglishLanguage,'Radioactive metallic transuranic element, belongs to the actinoids. Ten known isotopes. Am-243 is the most stable isotope, with a half-life of 7.95*10^3 years. Discovered by Glenn T. Seaborg and associates in 1945, it was obtained by bombarding {uranium}-238 with alpha particles.'))],[-(s__subclass(s__Curium,s__ElementalSubstance))],[-(s__instance(s__Curium__t,s__SetOrClass))],[-(s__names(s__Curium,'Curium'))],[-(s__conventionalShortName('Cm',s__Curium))],[-(s__atomicNumber(s__Curium,"96"))],[s__instance(_3768484,s__Object),-(s__measure(_3768484,s__MeasureFn("247",s__Amu))),s__instance(_3768484,s__Curium),s__instance(_3768484,s__Atom)],[-(s__documentation(s__Curium,s__EnglishLanguage,'Radioactive metallic transuranic element. Belongs to actinoid series. Nine known isotopes, Cm-247 has a half-life of 1.64*10^7 years. First identified by Glenn T. Seaborg and associates in 1944, first produced by L.B. Werner and I. Perlman in 1947 by bombarding americium-241 with {neutron}s. Named for Marie Curie.'))],[-(s__subclass(s__Berkelium,s__ElementalSubstance))],[-(s__instance(s__Berkelium__t,s__SetOrClass))],[-(s__names(s__Berkelium,'Berkelium'))],[-(s__conventionalShortName('Bk',s__Berkelium))],[-(s__atomicNumber(s__Berkelium,"97"))],[s__instance(_3770200,s__Object),-(s__measure(_3770200,s__MeasureFn("247",s__Amu))),s__instance(_3770200,s__Berkelium),s__instance(_3770200,s__Atom)],[-(s__documentation(s__Berkelium,s__EnglishLanguage,'Radioactive metallic transuranic element. Belongs to actinoid series. Eight known isotopes, the most common Bk-247, has a half-life of 1.4*10^3 years. First produced by Glenn T. Seaborg and associates in 1949 by bombarding americium-241 with alpha particles.'))],[-(s__subclass(s__Californium,s__ElementalSubstance))],[-(s__instance(s__Californium__t,s__SetOrClass))],[-(s__names(s__Californium,'Californium'))],[-(s__conventionalShortName('Cf',s__Californium))],[-(s__atomicNumber(s__Californium,"98"))],[s__instance(_3771916,s__Object),-(s__measure(_3771916,s__MeasureFn("249",s__Amu))),s__instance(_3771916,s__Californium),s__instance(_3771916,s__Atom)],[-(s__documentation(s__Californium,s__EnglishLanguage,'Radioactive metallic transuranic element. Belongs to actinoid series. Cf-251 has a half life of about 700 years. Nine isotopes are known. Cf-252 is an intense {neutron} source, which makes it an intense {neutron} source and gives it a use in {neutron} activation analysis and a possible use as a radiation source in medicine. First produced by Glenn T. Seaborg and associates in 1950.'))],[-(s__subclass(s__Einsteinium,s__ElementalSubstance))],[-(s__instance(s__Einsteinium__t,s__SetOrClass))],[-(s__names(s__Einsteinium,'Einsteinium'))],[-(s__conventionalShortName('Es',s__Einsteinium))],[-(s__atomicNumber(s__Einsteinium,"99"))],[s__instance(_3773632,s__Object),-(s__measure(_3773632,s__MeasureFn("254",s__Amu))),s__instance(_3773632,s__Einsteinium),s__instance(_3773632,s__Atom)],[-(s__documentation(s__Einsteinium,s__EnglishLanguage,'Appearance is unknown, however it is most probably metallic and silver or gray in color. Radioactive metallic transuranic element belonging to the actinoids. Es-254 has the longest half-life of the eleven known isotopes at 270 days. First identified by Albert Ghiorso and associates in the debris of the 1952 hydrogen bomb explosion. In 1961 the first microgram quantities of Es-232 were separated. While einsteinium never exists naturally, if a sufficient amount was assembled, it would pose a radiation hazard.'))],[-(s__subclass(s__Fermium,s__ElementalSubstance))],[-(s__instance(s__Fermium__t,s__SetOrClass))],[-(s__names(s__Fermium,'Fermium'))],[-(s__conventionalShortName('Fm',s__Fermium))],[-(s__atomicNumber(s__Fermium,"100"))],[s__instance(_3775348,s__Object),-(s__measure(_3775348,s__MeasureFn("253",s__Amu))),s__instance(_3775348,s__Fermium),s__instance(_3775348,s__Atom)],[-(s__documentation(s__Fermium,s__EnglishLanguage,'Radioactive metallic transuranic element, belongs to the actinoids. Ten known isotopes, most stable is Fm-257 with a half-life of 10 days. First identified by Albert Ghiorso and associates in the debris of the first hydrogen-bomb explosion in 1952.'))],[-(s__subclass(s__Mendelevium,s__ElementalSubstance))],[-(s__instance(s__Mendelevium__t,s__SetOrClass))],[-(s__names(s__Mendelevium,'Mendelevium'))],[-(s__conventionalShortName('Md',s__Mendelevium))],[-(s__atomicNumber(s__Mendelevium,"101"))],[s__instance(_3777064,s__Object),-(s__measure(_3777064,s__MeasureFn("256",s__Amu))),s__instance(_3777064,s__Mendelevium),s__instance(_3777064,s__Atom)],[-(s__documentation(s__Mendelevium,s__EnglishLanguage,'Radioactive metallic transuranic element. Belongs to the actinoid series. Only known isotope, Md-256 has a half-life of 1.3 hours. First identified by Glenn T. Seaborg, Albert Ghiorso and associates in 1955. Alternative name {unnilunium} has been proposed. Named after the inventor of the periodic table, Dmitri Mendeleev.'))],[-(s__subclass(s__Nobelium,s__ElementalSubstance))],[-(s__instance(s__Nobelium__t,s__SetOrClass))],[-(s__names(s__Nobelium,'Nobelium'))],[-(s__conventionalShortName('No',s__Nobelium))],[-(s__atomicNumber(s__Nobelium,"102"))],[s__instance(_3778780,s__Object),-(s__measure(_3778780,s__MeasureFn("254",s__Amu))),s__instance(_3778780,s__Nobelium),s__instance(_3778780,s__Atom)],[-(s__documentation(s__Nobelium,s__EnglishLanguage,'Radioactive metallic transuranic element, belongs to the actinoids. Seven known isotopes exist, the most stable being No-254 with a half-life of 255 seconds. First identified with certainty by Albert Ghiorso and Glenn T. Seaborg in 1966. {Unnilbium} has been proposed as an alternative name.'))],[-(s__subclass(s__Lawrencium,s__ElementalSubstance))],[-(s__instance(s__Lawrencium__t,s__SetOrClass))],[-(s__names(s__Lawrencium,'Lawrencium'))],[-(s__conventionalShortName('Lr',s__Lawrencium))],[-(s__atomicNumber(s__Lawrencium,"103"))],[s__instance(_3780496,s__Object),-(s__measure(_3780496,s__MeasureFn("262",s__Amu))),s__instance(_3780496,s__Lawrencium),s__instance(_3780496,s__Atom)],[-(s__documentation(s__Lawrencium,s__EnglishLanguage,'Appearance unknown, however it is most likely silvery-white or grey and metallic. Lawrencium is a synthetic rare-earth metal. There are eight known radioisotopes, the most stable being Lr-262 with a half-life of 3.6 hours. Due to the short half-life of lawrencium, and its radioactivity, there are no known uses for it. Identified by Albert Ghiorso in 1961 at Berkeley. It was produced by bombarding californium with boron ions. The name is temporary {IUPAC} nomenclature, the origin of the name comes from Ernest O. Lawrence, the inventor of the cyclotron. If sufficient amounts of lawrencium were produced, it would pose a radiation hazard.'))],[-(s__subclass(s__Unnilquadium,s__ElementalSubstance))],[-(s__instance(s__Unnilquadium__t,s__SetOrClass))],[-(s__names(s__Unnilquadium,'Unnilquadium'))],[-(s__conventionalShortName('Unq',s__Unnilquadium))],[-(s__atomicNumber(s__Unnilquadium,"104"))],[s__instance(_3782212,s__Object),-(s__measure(_3782212,s__MeasureFn("261",s__Amu))),s__instance(_3782212,s__Unnilquadium),s__instance(_3782212,s__Atom)],[-(s__documentation(s__Unnilquadium,s__EnglishLanguage,'Radioactive transactinide element. Expected to have similar chemical properties to those displayed by hafnium. Rf-260 was discovered by the Joint Nuclear Research Institute at Dubna (U.S.S.R.) in 1964. Researchers at Berkeley discovered Unq-257 and Unq-258 in 1964.'))],[-(s__subclass(s__Unnilpentium,s__ElementalSubstance))],[-(s__instance(s__Unnilpentium__t,s__SetOrClass))],[-(s__names(s__Unnilpentium,'Unnilpentium'))],[-(s__conventionalShortName('Unp',s__Unnilpentium))],[-(s__atomicNumber(s__Unnilpentium,"105"))],[s__instance(_3783928,s__Object),-(s__measure(_3783928,s__MeasureFn("262",s__Amu))),s__instance(_3783928,s__Unnilpentium),s__instance(_3783928,s__Atom)],[-(s__documentation(s__Unnilpentium,s__EnglishLanguage,'Radioactive transactinide element. Half-life of 1.6s. Discovered in 1970 by Berkeley researchers. So far, seven isotopes have been discovered.'))],[-(s__subclass(s__Unnilhexium,s__ElementalSubstance))],[-(s__instance(s__Unnilhexium__t,s__SetOrClass))],[-(s__names(s__Unnilhexium,'Unnilhexium'))],[-(s__atomicNumber(s__Unnilhexium,"106"))],[s__instance(_3785516,s__Object),-(s__measure(_3785516,s__MeasureFn("263",s__Amu))),s__instance(_3785516,s__Unnilhexium),s__instance(_3785516,s__Atom)],[-(s__documentation(s__Unnilhexium,s__EnglishLanguage,'Half-life of 0.9 +/- 0.2 s. Discovered by the Joint Institute for Nuclear Research at Dubna (U.S.S.R.) in June of 1974. Its existence was confirmed by the Lawrence Berkeley Laboratory and Livermore National Laboratory in September of 1974.'))],[-(s__subclass(s__Unnilseptium,s__ElementalSubstance))],[-(s__instance(s__Unnilseptium__t,s__SetOrClass))],[-(s__names(s__Unnilseptium,'Unnilseptium'))],[-(s__atomicNumber(s__Unnilseptium,"107"))],[s__instance(_3787104,s__Object),-(s__measure(_3787104,s__MeasureFn("262",s__Amu))),s__instance(_3787104,s__Unnilseptium),s__instance(_3787104,s__Atom)],[-(s__documentation(s__Unnilseptium,s__EnglishLanguage,'Radioactive transition metal. Half-life of approximately 1/500 s. Discovered by the Joint Institute for Nuclear Research at Dubna (U.S.S.R.) in 1976. Confirmed by West German physicists at the Heavy Ion Research Laboratory at Darmstadt.'))],[-(s__subclass(s__Unniloctium,s__ElementalSubstanc
  title = {Efficient {{Neural Clause-Selection Reinforcement}}},
  booktitle = {Automated {{Deduction}} – {{CADE}} 30},
  author = {Suda, Martin},
  editor = {Barrett, Clark and Waldmann, Uwe},
  date = {2025},

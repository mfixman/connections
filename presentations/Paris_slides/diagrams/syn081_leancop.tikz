\begin{tikzpicture}[
  attempt/.style = {
    every node/.style = {
      draw,
      rounded corners=1pt,
      inner xsep=3pt,
      inner ysep=2pt,
      font=\scriptsize,
      align=center
    },
    level distance=8mm,
    sibling distance=34mm,
    level 2/.style={sibling distance=28mm},
    edge from parent/.style={draw, -}
  },
  start/.style={},
  success/.style={fill=black!6},
  bt/.style={draw, dash pattern=on 2pt off 1pt on .5pt off 1pt},
  label/.style={draw=none, font=\scriptsize\itshape}
]
\useasboundingbox (-48mm,-74mm) rectangle (164mm,8mm);

\begin{scope}[xshift=0mm, attempt]
  \node[start] {$F(f(x_0)) \vee F(x_0)$}
    child { node {$\neg F(x_1) \vee \neg F(f(x_1))$} edge from parent[bt] }
    child { node {$\neg F(x_2) \vee \neg F(f(x_2))$} edge from parent[bt] }
    child { node {$\neg F(x_3) \vee F(f(x_3))$} edge from parent[bt] };
\end{scope}

\begin{scope}[xshift=106mm, attempt]
  \node[start] {$\neg F(x_4) \vee \neg F(f(x_4))$}
    child { node {$F(f(x_5)) \vee F(x_5)$} edge from parent[bt] }
    child { node {$F(f(x_6)) \vee F(x_6)$} edge from parent[bt] }
    child { node {$\neg F(x_7) \vee F(f(x_7))$} edge from parent[bt] };
\end{scope}

\begin{scope}[xshift=0mm, yshift=-38mm, attempt]
  \node[start] {$\neg F(x_8) \vee F(f(x_8))$}
    child { node {$F(f(x_9)) \vee F(x_9)$} edge from parent[bt] }
    child { node {$F(f(x_{10})) \vee F(x_{10})$} edge from parent[bt] }
    child { node {$\neg F(x_{11}) \vee F(f(x_{11}))$} edge from parent[bt] };
\end{scope}

\begin{scope}[xshift=104mm, yshift=-38mm, attempt,
  level 1/.style={sibling distance=78mm},
  level 2/.style={sibling distance=34mm}
]
  \node[start, success] {$F(f(x_{12})) \vee F(x_{12})$}
    child { node[success] {$\neg F(x_{13}) \vee \neg F(f(x_{13}))$}
      child { node {$F(f(x_{14})) \vee F(x_{14})$} edge from parent[bt] }
      child { node {$F(f(x_{15})) \vee F(x_{15})$} edge from parent[bt] }
      child { node[success] {$\neg F(x_{16}) \vee F(f(x_{16}))$} }
    }
    child { node[success] {$\neg F(x_{17}) \vee \neg F(f(x_{17}))$}
      child { node[success] {$\neg F(x_{18}) \vee F(f(x_{18}))$} }
    };
\end{scope}
\end{tikzpicture}

\begin{tikzpicture}[
  attempt/.style = {
    every node/.style = {
      draw,
      rounded corners=1pt,
      inner xsep=3pt,
      inner ysep=2pt,
      font=\Large
    },
    level distance=11mm,
    sibling distance=36mm,
    level 2/.style={sibling distance=36mm},
    edge from parent/.style={draw, -}
  },
  start/.style={},
  core/.style={fill=black!6},
  bt/.style={edge from parent/.style={draw, -}},
  label/.style={draw=none, font=\Large\itshape}
]
\useasboundingbox (-12mm,-79mm) rectangle (147mm,8mm);

\begin{scope}[xshift=30mm, attempt]
  \node[start, core] {$\neg F(g) \vee p$}
    child { node {$F(x_0) \vee \neg p$}
      child[bt] { node {$F(x_1) \vee \neg p$} }
      child[bt] { node[core] {$\neg p \vee \neg F(a)$} }
    };
\end{scope}

\begin{scope}[xshift=105mm, attempt]
  \node[start, core] {$p \vee F(g)$}
    child[bt] { node {$\neg p \vee F(x_2)$} }
    child[bt] { node {$\neg F(a) \vee \neg p$} };
\end{scope}

\begin{scope}[xshift=68mm, yshift=-36mm, attempt]
  \node[start] {$\neg F(a) \vee \neg p$}
    child[bt] { node {$p \vee F(y_0)$} }
    child[bt] { node {$F(y_1) \vee \neg F(a)$} }
    child { node[core] {$\neg p \vee F(a)$} };
\end{scope}

\node[label, align=center] at (67.5mm,-72mm)
  {UNSAT core:\\$\{\neg F(g) \vee p,\ p \vee F(g),\ \neg F(a) \vee \neg p,\ \neg p \vee F(a)\}$};
\end{tikzpicture}
